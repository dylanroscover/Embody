      Rotate: 45
      Colora: 3
      Linewidth: 2.8
      Ink: 1.3
      Wobble: 0.002
      Wobblescale: 5
    Animate:
      $t: animate
      Radiusanim: 0.004
      Radiusrate: 0.5
      Nestgaprate: 0.7
      Linewidthanim: 0.3
      Linewidthrate: 0.8
  position: [0, -5200]
  children:
  - name: params
    type: constantCHOP
    sequences:
      const:
      - name: Active
        value: =parent.Layer.par.Active
      - name: Shape
        value: =parent.Layer.par.Shape.menuIndex
      - name: Style
        value: =parent.Layer.par.Style.menuIndex
      - name: Order
        value: =parent.Layer.par.Order
      - name: Radius
        value: =parent.Layer.par.Radius
      - name: Lobes
        value: =parent.Layer.par.Lobes
      - name: Amplitude
        value: =parent.Layer.par.Amplitude
      - name: Sharpness
        value: =parent.Layer.par.Sharpness
      - name: Length
        value: =parent.Layer.par.Length
      - name: Width
        value: =parent.Layer.par.Width
      - name: Count
        value: =parent.Layer.par.Count
      - name: Nest
        value: =parent.Layer.par.Nest
      - name: Nestgap
        value: =parent.Layer.par.Nestgap
      - name: Rotate
        value: =parent.Layer.par.Rotate
      - name: Speed
        value: =parent.Layer.par.Speed
      - name: Pulse
        value: =parent.Layer.par.Pulse
      - name: Pulserate
        value: =parent.Layer.par.Pulserate
      - name: ColAr
        value: =parent.Mandala.par['Col%dr' % int(parent.Layer.par.Colora)]
      - name: ColAg
        value: =parent.Mandala.par['Col%dg' % int(parent.Layer.par.Colora)]
      - name: ColAb
        value: =parent.Mandala.par['Col%db' % int(parent.Layer.par.Colora)]
      - name: ColBr
        value: =parent.Mandala.par['Col%dr' % int(parent.Layer.par.Colorb)]
      - name: ColBg
        value: =parent.Mandala.par['Col%dg' % int(parent.Layer.par.Colorb)]
      - name: ColBb
        value: =parent.Mandala.par['Col%db' % int(parent.Layer.par.Colorb)]
      - name: ColLr
        value: =parent.Mandala.par['Col%dr' % max(1, int(parent.Layer.par.Linecolor))]
      - name: ColLg
        value: =parent.Mandala.par['Col%dg' % max(1, int(parent.Layer.par.Linecolor))]
      - name: ColLb
        value: =parent.Mandala.par['Col%db' % max(1, int(parent.Layer.par.Linecolor))]
      - name: Uselinecol
        value: =1 if parent.Layer.par.Linecolor > 0 else 0
      - name: Alternate
