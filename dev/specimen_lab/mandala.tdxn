- name: glsl_fill_compute
  type: textDAT
  flags:
  - viewer
  position: [925, -1920]
  dock: glsl_fill
  dat_content: "// Mandala stream shader (one instance for the line stream, one for the fill stream).\n// Every point carries LayerId / CopyId / NestId from the static per-layer copy chains; all layer\n// parameters live in the uP texture buffer (merge_params -> shuffle_params, 64 floats per layer),\n// so per frame only this shader cooks: outline, nesting, radial placement, every animation, colour.\n// Uniforms auto-declared from the Vectors / Arrays pages:\n//   samplerBuffer uP; float uTime, uEnergy, uGlobalRot, uLoop, uLoopLen, uInkWidth; vec3 uInkColor; int uIsFill.\n// uIsFill: 0 = coloured outline stream, 1 = filled fan stream, 2 = ink contour (the line geometry redrawn\n// thicker in the ink colour, sitting between a layer's fill and its coloured outline).\n// Loop mode (uLoop): every rate is snapped to whole cycles per uLoopLen seconds and every spin to a\n// symmetric position, so frame T equals frame 0 exactly (the wobble walks a circle in noise space).\n#define TAU 6.28318530718\n#define PI  3.14159265359\n#define STRIDE 64\n\nfloat PRM(int layer, int j) { return texelFetch(uP, layer * STRIDE + j).r; }\nvec2 rot2(vec2 v, float a) { float c = cos(a), s = sin(a); return vec2(c * v.x - s * v.y, s * v.x + c * v.y); }\n\n// snap an LFO rate (rad/s) to a whole number of cycles per loop (at least one)\nfloat qrate(float rate) {\n\tif (uLoop < 0.5 || rate == 0.0) return rate;\n\tfloat k = max(1.0, floor(abs(rate) * uLoopLen / TAU + 0.5));\n\treturn sign(rate) * k * TAU / uLoopLen;\n}\n// snap a spin (deg/s) to whole symmetric steps per loop; minK 0 lets a very slow spin stop instead\nfloat qspin(float dps, float period, float minK) {\n\tif (uLoop < 0.5 || dps == 0.0 || period <= 0.0) return dps;\n\tfloat k = max(minK, floor(abs(dps) * uLoopLen / period + 0.5));\n\treturn sign(dps) * k * period / uLoopLen;\n}\nfloat lfo(float base, float amt, float rate, float t, float ph) { return base + amt * uEnergy * sin(t * qrate(rate) + ph); }\n\nvoid main() {\n\tconst uint id = TDIndex();\n\tif (id >= TDNumElements())\n\t\treturn;\n\n\tvec3 pin = TDIn_P();\n\tint layer = int(TDIn_LayerId());\n\tint ci = int(TDIn_CopyId());\n\tint ni = int(TDIn_NestId());\n\tfloat t = uTime;\n\tfloat lph = float(layer) * 0.7;                 // per-layer phase so LFOs never sync\n\n\tfloat isOn     = PRM(layer, 0);                 // 'active' is a GLSL reserved word\n\tint   shape    = int(PRM(layer, 1));\n\tint   style    = int(PRM(layer, 2));\n\tfloat order    = PRM(layer, 3);\n\tfloat radius   = lfo(PRM(layer, 4), PRM(layer, 42), PRM(layer, 43), t, lph);\n\tint   lobes    = int(PRM(layer, 5));\n\tfloat amp      = lfo(PRM(layer, 6), PRM(layer, 44), PRM(layer, 45), t, lph);\n\tfloat sharp    = max(0.02, lfo(PRM(layer, 7), PRM(layer, 46), PRM(layer, 47), t, lph));\n\tfloat len      = lfo(PRM(layer, 8), PRM(layer, 48), PRM(layer, 49), t, lph);\n\tfloat wid      = lfo(PRM(layer, 9), PRM(layer, 50), PRM(layer, 51), t, lph);\n\tint   count    = max(int(PRM(layer, 10)), 1);\n\tfloat nestgap  = lfo(PRM(layer, 12), PRM(layer, 52), PRM(layer, 53), t, lph);\n\tfloat rotate   = PRM(layer, 13);\n\tfloat speed    = PRM(layer, 14);\n\tfloat pulse    = PRM(layer, 15);\n\tfloat pulserate = PRM(layer, 16);\n\tvec3  colA     = vec3(PRM(layer, 17), PRM(layer, 18), PRM(layer, 19));\n\tvec3  colB     = vec3(PRM(layer, 20), PRM(layer, 21), PRM(layer, 22));\n\tvec3  colL     = vec3(PRM(layer, 23), PRM(layer, 24), PRM(layer, 25));\n\tfloat useLine  = PRM(layer, 26);\n\tint   alternate = int(PRM(layer, 27));\n\tfloat opacity  = clamp(lfo(PRM(layer, 28), PRM(layer, 56), PRM(layer, 57), t, lph), 0.0, 1.0);\n\tfloat lwidth   = max(0.0, lfo(PRM(layer, 29), PRM(layer, 54), PRM(layer, 55), t, lph));\n\tfloat wobble   = PRM(layer, 30);\n\tfloat wobscale = PRM(layer, 31);\n\tfloat seed     = PRM(layer, 32);\n\tfloat waveAmt  = PRM(layer, 33) * uEnergy;\n\tfloat waveRate = PRM(layer, 34);\n\tfloat waveCyc  = max(PRM(layer, 35), 1.0);\n\tfloat colWave  = min(1.0, PRM(layer, 36) * uEnergy);\n\tfloat colRate  = PRM(layer, 37);\n\tfloat tumble   = PRM(layer, 38) * uEnergy;\n\tfloat tumbleRate
    = PRM(layer, 39);\n\tfloat nestSpin = PRM(layer, 40);\n\tfloat wobRate  = PRM(layer, 41);\n\tfloat ink      = PRM(layer, 58);\n\tfloat gap      = PRM(layer, 59);\n\n\t// visibility: Active plus the Style gate for this stream (line / fill / both)\n\tbool show = (isOn > 0.5) && ((uIsFill == 1) ? (style != 0) : ((uIsFill == 2) ? (ink > 0.0) : (style != 1)));\n\tfloat alpha = show ? opacity : 0.0;\n\n\tbool centre = (uIsFill == 1) && (dot(pin.xy, pin.xy) < 1e-8);   // fan centre of the filled circle\n\tfloat u = atan(pin.y, pin.x);\n\tif (u < 0.0) u += TAU;\n\tfloat cph = float(ci) / float(count);\n\tfloat wphase = cph * TAU * waveCyc + float(ni) * 0.7;\n\tfloat wave = (waveAmt != 0.0) ? waveAmt * sin(t * qrate(waveRate) + wphase) : 0.0;\n\tfloat R = radius * (1.0 + wave);\n\tfloat k = float(max(lobes, 1));\n\tvec2 dir = vec2(cos(u), sin(u));\n\tvec2 q;\n\tvec2 pivot = vec2(0.0);\n\n\tif (shape == 1) {                               // regular polygon, circumradius R\n\t\tfloat kk = max(k, 3.0);\n\t\tfloat sec = TAU / kk;\n\t\tfloat a = mod(u, sec) - sec * 0.5;\n\t\tq = dir * (R * cos(sec * 0.5) / cos(a));\n\t} else if (shape == 2) {                        // star\n\t\tfloat f = fract(u * k / TAU);\n\t\tfloat tri = 1.0 - abs(2.0 * f - 1.0);\n\t\tq = dir * (R * (1.0 - amp * pow(tri, sharp)));\n\t} else if (shape == 3) {                        // rosette\n\t\tfloat c = 0.5 + 0.5 * cos(k * u);\n\t\tq = dir * (R * (1.0 + amp * (2.0 * pow(c, sharp) - 1.0)));\n\t} else if (shape == 4) {                        // scallop\n\t\tfloat b = abs(sin(k * u * 0.5));\n\t\tq = dir * (R * (1.0 + amp * pow(b, sharp)));\n\t} else if (shape == 5) {                        // petal\n\t\tfloat s = 0.5 - 0.5 * cos(u);\n\t\tfloat e = mix(0.7, sharp, s);\n\t\tfloat w = pow(max(sin(PI * s), 0.0), e);\n\t\tfloat side = (u < PI) ? 1.0 : -1.0;\n\t\tq = vec2(R + len * s, side * wid * w);\n\t\tpivot = vec2(R + len * 0.5, 0.0);\n\t} else if (shape == 6) {                        // bar\n\t\tfloat s = 0.5 - 0.5 * cos(u);\n\t\tfloat capLen = 0.12 / max(sharp, 0.1);          // Sharpness > 1 squares the bar ends\n\t\tfloat cap = smoothstep(0.0, capLen, s) * smoothstep(0.0, capLen, 1.0 - s);\n\t\tfloat side = (u < PI) ? 1.0 : -1.0;\n\t\tq = vec2(R + len * s, side * wid * sqrt(cap));\n\t\tpivot = vec2(R + len * 0.5, 0.0);\n\t} else if (shape == 8) {                        // arc: ring segment; Length = share of its slot, Width = half-thickness\n\t\tfloat hspan = len * (PI / float(count));\n\t\tfloat s = u / TAU;\n\t\tfloat a = (s < 0.5) ? mix(-hspan, hspan, s * 2.0) : mix(hspan, -hspan, (s - 0.5) * 2.0);\n\t\tfloat rr = (s < 0.5) ? (R + wid) : (R - wid);\n\t\tq = vec2(cos(a), sin(a)) * rr;\n\t\tpivot = vec2(R, 0.0);\n\t} else if (shape == 7) {                        // dot\n\t\tq = vec2(R + len * cos(u), len * sin(u));\n\t\tpivot = vec2(R, 0.0);\n\t} else {                                        // circle\n\t\tq = dir * R;\n\t}\n\tif (centre) q = pivot;\n\t// Gap: cut the middle of each edge / lobe sector (corners-only frames, dashed rings)\n\tif (gap > 0.0 && !centre) {\n\t\tfloat f = fract(u * k / TAU);\n\t\tif (abs(f - 0.5) < gap * 0.5) alpha = 0.0;\n\t}\n\n\tfloat ns = pow(max(1.0 - nestgap, 0.01), float(ni));\n\tq = pivot + (q - pivot) * ns;\n\n\tif (tumble != 0.0 && shape >= 5) {\n\t\tfloat a = radians(tumble) * sin(t * qrate(tumbleRate) + wphase);\n\t\tq = pivot + rot2(q - pivot, a);\n\t}\n\n\t// symmetric period of the whole ring (deg): what a spin must cover per loop to land on itself\n\tfloat per = 360.0 / float(count);\n\tif (count == 1 && shape >= 1 && shape <= 4) per = 360.0 / k;\n\tbool wavy = (waveAmt != 0.0) || (tumble != 0.0) || (colWave > 0.0);\n\tif (wavy) per = (mod(float(count), waveCyc) < 0.5) ? 360.0 / waveCyc : 360.0;\n\tif (alternate == 1) {\n\t\tfloat per2 = (mod(float(count), 2.0) < 0.5) ? 720.0 / float(count) : 360.0;\n\t\tfloat r1 = per / per2, r2 = per2 / per;      // keep the coarser period when one divides the other\n\t\tif (abs(r2 - floor(r2 + 0.5)) < 1e-3) per = per2;\n\t\telse if (abs(r1 - floor(r1 + 0.5)) > 1e-3) per = 360.0;\n\t}\n\tfloat
    nestPer = (shape == 0) ? 0.0 : ((shape <= 4) ? 360.0 / k : 360.0);\n\n\tfloat spin = radians(rotate + uGlobalRot) + radians(qspin(speed, per, 1.0)) * t;\n\tfloat ang = cph * TAU + mod(radians(qspin(nestSpin, nestPer, 0.0)) * t * float(ni), TAU) + mod(spin, TAU);\n\tq = rot2(q, ang);\n\n\tif (pulse != 0.0)\n\t\tq *= 1.0 + pulse * uEnergy * sin(t * qrate(pulserate) + lph);\n\n\tif (wobble > 0.0 && !centre) {\n\t\tfloat nx, ny;\n\t\tif (uLoop > 0.5) {                          // seamless: walk a circle in the noise's zw plane\n\t\t\tfloat ph = TAU * t / uLoopLen;\n\t\t\tfloat r = wobRate * 0.5;\n\t\t\tvec4 z = vec4(q * wobscale, seed * 3.17 + r * cos(ph), r * sin(ph));\n\t\t\tnx = TDSimplexNoise(z);\n\t\t\tny = TDSimplexNoise(z + vec4(31.7, 17.3, 5.1, 2.3));\n\t\t} else {\n\t\t\tvec3 z = vec3(q * wobscale, seed * 3.17 + t * wobRate);\n\t\t\tnx = TDSimplexNoise(z);\n\t\t\tny = TDSimplexNoise(z + vec3(31.7, 17.3, 5.1));\n\t\t}\n\t\tq += vec2(nx, ny) * wobble;\n\t}\n\n\t// hidden streams park far behind every layer so they can neither show nor occlude\n\tfloat z = show ? order * 0.01 : -5.0;         // 0.01 per Draw Order step; fills sit 0.004 and ink 0.002 behind their layer's lines (geo tz)\n\tP[id] = vec3(q, z);\n\n\tfloat sel = 0.0;\n\tif (alternate == 1) sel = float(ci & 1);\n\telse if (alternate == 2) sel = float(ni & 1);\n\tif (colWave > 0.0) {\n\t\tfloat w = 0.5 + 0.5 * sin(t * qrate(colRate) + wphase);\n\t\tsel = mix(sel, w, colWave);\n\t}\n\tvec3 col = mix(colA, colB, sel);\n\tif (uIsFill == 0 && useLine > 0.5) col = colL;\n\tif (uIsFill == 2) {\n\t\tcol = uInkColor;\n\t\tlwidth = lwidth * ink * uInkWidth;\n\t}\n\tColor[id] = vec4(col * alpha, alpha);\n\tLineWidth[id] = lwidth;\n}\n"
  dat_content_format: text
- name: glsl_line_compute
  type: textDAT
  flags:
  - viewer
  position: [925, -1320]
  dock: glsl_line
  dat_content: "// Mandala stream shader (one instance for the line stream, one for the fill stream).\n// Every point carries LayerId / CopyId / NestId from the static per-layer copy chains; all layer\n// parameters live in the uP texture buffer (merge_params -> shuffle_params, 64 floats per layer),\n// so per frame only this shader cooks: outline, nesting, radial placement, every animation, colour.\n// Uniforms auto-declared from the Vectors / Arrays pages:\n//   samplerBuffer uP; float uTime, uEnergy, uGlobalRot, uLoop, uLoopLen, uInkWidth; vec3 uInkColor; int uIsFill.\n// uIsFill: 0 = coloured outline stream, 1 = filled fan stream, 2 = ink contour (the line geometry redrawn\n// thicker in the ink colour, sitting between a layer's fill and its coloured outline).\n// Loop mode (uLoop): every rate is snapped to whole cycles per uLoopLen seconds and every spin to a\n// symmetric position, so frame T equals frame 0 exactly (the wobble walks a circle in noise space).\n#define TAU 6.28318530718\n#define PI  3.14159265359\n#define STRIDE 64\n\nfloat PRM(int layer, int j) { return texelFetch(uP, layer * STRIDE + j).r; }\nvec2 rot2(vec2 v, float a) { float c = cos(a), s = sin(a); return vec2(c * v.x - s * v.y, s * v.x + c * v.y); }\n\n// snap an LFO rate (rad/s) to a whole number of cycles per loop (at least one)\nfloat qrate(float rate) {\n\tif (uLoop < 0.5 || rate == 0.0) return rate;\n\tfloat k = max(1.0, floor(abs(rate) * uLoopLen / TAU + 0.5));\n\treturn sign(rate) * k * TAU / uLoopLen;\n}\n// snap a spin (deg/s) to whole symmetric steps per loop; minK 0 lets a very slow spin stop instead\nfloat qspin(float dps, float period, float minK) {\n\tif (uLoop < 0.5 || dps == 0.0 || period <= 0.0) return dps;\n\tfloat k = max(minK, floor(abs(dps) * uLoopLen / period + 0.5));\n\treturn sign(dps) * k * period / uLoopLen;\n}\nfloat lfo(float base, float amt, float rate, float t, float ph) { return base + amt * uEnergy * sin(t * qrate(rate) + ph); }\n\nvoid main() {\n\tconst uint id = TDIndex();\n\tif (id >= TDNumElements())\n\t\treturn;\n\n\tvec3 pin = TDIn_P();\n\tint layer = int(TDIn_LayerId());\n\tint ci = int(TDIn_CopyId());\n\tint ni = int(TDIn_NestId());\n\tfloat t = uTime;\n\tfloat lph = float(layer) * 0.7;                 // per-layer phase so LFOs never sync\n\n\tfloat isOn     = PRM(layer, 0);                 // 'active' is a GLSL reserved word\n\tint   shape    = int(PRM(layer, 1));\n\tint   style    = int(PRM(layer, 2));\n\tfloat order    = PRM(layer, 3);\n\tfloat radius   = lfo(PRM(layer, 4), PRM(layer, 42), PRM(layer, 43), t, lph);\n\tint   lobes    = int(PRM(layer, 5));\n\tfloat amp      = lfo(PRM(layer, 6), PRM(layer, 44), PRM(layer, 45), t, lph);\n\tfloat sharp    = max(0.02, lfo(PRM(layer, 7), PRM(layer, 46), PRM(layer, 47), t, lph));\n\tfloat len      = lfo(PRM(layer, 8), PRM(layer, 48), PRM(layer, 49), t, lph);\n\tfloat wid      = lfo(PRM(layer, 9), PRM(layer, 50), PRM(layer, 51), t, lph);\n\tint   count    = max(int(PRM(layer, 10)), 1);\n\tfloat nestgap  = lfo(PRM(layer, 12), PRM(layer, 52), PRM(layer, 53), t, lph);\n\tfloat rotate   = PRM(layer, 13);\n\tfloat speed    = PRM(layer, 14);\n\tfloat pulse    = PRM(layer, 15);\n\tfloat pulserate = PRM(layer, 16);\n\tvec3  colA     = vec3(PRM(layer, 17), PRM(layer, 18), PRM(layer, 19));\n\tvec3  colB     = vec3(PRM(layer, 20), PRM(layer, 21), PRM(layer, 22));\n\tvec3  colL     = vec3(PRM(layer, 23), PRM(layer, 24), PRM(layer, 25));\n\tfloat useLine  = PRM(layer, 26);\n\tint   alternate = int(PRM(layer, 27));\n\tfloat opacity  = clamp(lfo(PRM(layer, 28), PRM(layer, 56), PRM(layer, 57), t, lph), 0.0, 1.0);\n\tfloat lwidth   = max(0.0, lfo(PRM(layer, 29), PRM(layer, 54), PRM(layer, 55), t, lph));\n\tfloat wobble   = PRM(layer, 30);\n\tfloat wobscale = PRM(layer, 31);\n\tfloat seed     = PRM(layer, 32);\n\tfloat waveAmt  = PRM(layer, 33) * uEnergy;\n\tfloat waveRate = PRM(layer, 34);\n\tfloat waveCyc  = max(PRM(layer, 35), 1.0);\n\tfloat colWave  = min(1.0, PRM(layer, 36) * uEnergy);\n\tfloat colRate  = PRM(layer, 37);\n\tfloat tumble   = PRM(layer, 38) * uEnergy;\n\tfloat tumbleRate
    = PRM(layer, 39);\n\tfloat nestSpin = PRM(layer, 40);\n\tfloat wobRate  = PRM(layer, 41);\n\tfloat ink      = PRM(layer, 58);\n\tfloat gap      = PRM(layer, 59);\n\n\t// visibility: Active plus the Style gate for this stream (line / fill / both)\n\tbool show = (isOn > 0.5) && ((uIsFill == 1) ? (style != 0) : ((uIsFill == 2) ? (ink > 0.0) : (style != 1)));\n\tfloat alpha = show ? opacity : 0.0;\n\n\tbool centre = (uIsFill == 1) && (dot(pin.xy, pin.xy) < 1e-8);   // fan centre of the filled circle\n\tfloat u = atan(pin.y, pin.x);\n\tif (u < 0.0) u += TAU;\n\tfloat cph = float(ci) / float(count);\n\tfloat wphase = cph * TAU * waveCyc + float(ni) * 0.7;\n\tfloat wave = (waveAmt != 0.0) ? waveAmt * sin(t * qrate(waveRate) + wphase) : 0.0;\n\tfloat R = radius * (1.0 + wave);\n\tfloat k = float(max(lobes, 1));\n\tvec2 dir = vec2(cos(u), sin(u));\n\tvec2 q;\n\tvec2 pivot = vec2(0.0);\n\n\tif (shape == 1) {                               // regular polygon, circumradius R\n\t\tfloat kk = max(k, 3.0);\n\t\tfloat sec = TAU / kk;\n\t\tfloat a = mod(u, sec) - sec * 0.5;\n\t\tq = dir * (R * cos(sec * 0.5) / cos(a));\n\t} else if (shape == 2) {                        // star\n\t\tfloat f = fract(u * k / TAU);\n\t\tfloat tri = 1.0 - abs(2.0 * f - 1.0);\n\t\tq = dir * (R * (1.0 - amp * pow(tri, sharp)));\n\t} else if (shape == 3) {                        // rosette\n\t\tfloat c = 0.5 + 0.5 * cos(k * u);\n\t\tq = dir * (R * (1.0 + amp * (2.0 * pow(c, sharp) - 1.0)));\n\t} else if (shape == 4) {                        // scallop\n\t\tfloat b = abs(sin(k * u * 0.5));\n\t\tq = dir * (R * (1.0 + amp * pow(b, sharp)));\n\t} else if (shape == 5) {                        // petal\n\t\tfloat s = 0.5 - 0.5 * cos(u);\n\t\tfloat e = mix(0.7, sharp, s);\n\t\tfloat w = pow(max(sin(PI * s), 0.0), e);\n\t\tfloat side = (u < PI) ? 1.0 : -1.0;\n\t\tq = vec2(R + len * s, side * wid * w);\n\t\tpivot = vec2(R + len * 0.5, 0.0);\n\t} else if (shape == 6) {                        // bar\n\t\tfloat s = 0.5 - 0.5 * cos(u);\n\t\tfloat capLen = 0.12 / max(sharp, 0.1);          // Sharpness > 1 squares the bar ends\n\t\tfloat cap = smoothstep(0.0, capLen, s) * smoothstep(0.0, capLen, 1.0 - s);\n\t\tfloat side = (u < PI) ? 1.0 : -1.0;\n\t\tq = vec2(R + len * s, side * wid * sqrt(cap));\n\t\tpivot = vec2(R + len * 0.5, 0.0);\n\t} else if (shape == 8) {                        // arc: ring segment; Length = share of its slot, Width = half-thickness\n\t\tfloat hspan = len * (PI / float(count));\n\t\tfloat s = u / TAU;\n\t\tfloat a = (s < 0.5) ? mix(-hspan, hspan, s * 2.0) : mix(hspan, -hspan, (s - 0.5) * 2.0);\n\t\tfloat rr = (s < 0.5) ? (R + wid) : (R - wid);\n\t\tq = vec2(cos(a), sin(a)) * rr;\n\t\tpivot = vec2(R, 0.0);\n\t} else if (shape == 7) {                        // dot\n\t\tq = vec2(R + len * cos(u), len * sin(u));\n\t\tpivot = vec2(R, 0.0);\n\t} else {                                        // circle\n\t\tq = dir * R;\n\t}\n\tif (centre) q = pivot;\n\t// Gap: cut the middle of each edge / lobe sector (corners-only frames, dashed rings)\n\tif (gap > 0.0 && !centre) {\n\t\tfloat f = fract(u * k / TAU);\n\t\tif (abs(f - 0.5) < gap * 0.5) alpha = 0.0;\n\t}\n\n\tfloat ns = pow(max(1.0 - nestgap, 0.01), float(ni));\n\tq = pivot + (q - pivot) * ns;\n\n\tif (tumble != 0.0 && shape >= 5) {\n\t\tfloat a = radians(tumble) * sin(t * qrate(tumbleRate) + wphase);\n\t\tq = pivot + rot2(q - pivot, a);\n\t}\n\n\t// symmetric period of the whole ring (deg): what a spin must cover per loop to land on itself\n\tfloat per = 360.0 / float(count);\n\tif (count == 1 && shape >= 1 && shape <= 4) per = 360.0 / k;\n\tbool wavy = (waveAmt != 0.0) || (tumble != 0.0) || (colWave > 0.0);\n\tif (wavy) per = (mod(float(count), waveCyc) < 0.5) ? 360.0 / waveCyc : 360.0;\n\tif (alternate == 1) {\n\t\tfloat per2 = (mod(float(count), 2.0) < 0.5) ? 720.0 / float(count) : 360.0;\n\t\tfloat r1 = per / per2, r2 = per2 / per;      // keep the coarser period when one divides the other\n\t\tif (abs(r2 - floor(r2 + 0.5)) < 1e-3) per = per2;\n\t\telse if (abs(r1 - floor(r1 + 0.5)) > 1e-3) per = 360.0;\n\t}\n\tfloat
    nestPer = (shape == 0) ? 0.0 : ((shape <= 4) ? 360.0 / k : 360.0);\n\n\tfloat spin = radians(rotate + uGlobalRot) + radians(qspin(speed, per, 1.0)) * t;\n\tfloat ang = cph * TAU + mod(radians(qspin(nestSpin, nestPer, 0.0)) * t * float(ni), TAU) + mod(spin, TAU);\n\tq = rot2(q, ang);\n\n\tif (pulse != 0.0)\n\t\tq *= 1.0 + pulse * uEnergy * sin(t * qrate(pulserate) + lph);\n\n\tif (wobble > 0.0 && !centre) {\n\t\tfloat nx, ny;\n\t\tif (uLoop > 0.5) {                          // seamless: walk a circle in the noise's zw plane\n\t\t\tfloat ph = TAU * t / uLoopLen;\n\t\t\tfloat r = wobRate * 0.5;\n\t\t\tvec4 z = vec4(q * wobscale, seed * 3.17 + r * cos(ph), r * sin(ph));\n\t\t\tnx = TDSimplexNoise(z);\n\t\t\tny = TDSimplexNoise(z + vec4(31.7, 17.3, 5.1, 2.3));\n\t\t} else {\n\t\t\tvec3 z = vec3(q * wobscale, seed * 3.17 + t * wobRate);\n\t\t\tnx = TDSimplexNoise(z);\n\t\t\tny = TDSimplexNoise(z + vec3(31.7, 17.3, 5.1));\n\t\t}\n\t\tq += vec2(nx, ny) * wobble;\n\t}\n\n\t// hidden streams park far behind every layer so they can neither show nor occlude\n\tfloat z = show ? order * 0.01 : -5.0;         // 0.01 per Draw Order step; fills sit 0.004 and ink 0.002 behind their layer's lines (geo tz)\n\tP[id] = vec3(q, z);\n\n\tfloat sel = 0.0;\n\tif (alternate == 1) sel = float(ci & 1);\n\telse if (alternate == 2) sel = float(ni & 1);\n\tif (colWave > 0.0) {\n\t\tfloat w = 0.5 + 0.5 * sin(t * qrate(colRate) + wphase);\n\t\tsel = mix(sel, w, colWave);\n\t}\n\tvec3 col = mix(colA, colB, sel);\n\tif (uIsFill == 0 && useLine > 0.5) col = colL;\n\tif (uIsFill == 2) {\n\t\tcol = uInkColor;\n\t\tlwidth = lwidth * ink * uInkWidth;\n\t}\n\tColor[id] = vec4(col * alpha, alpha);\n\tLineWidth[id] = lwidth;\n}\n"
  dat_content_format: text
- name: glsl_outline_info
  type: infoDAT
  parameters:
    op: glsl_outline
  position: [1075, -1620]
  dock: glsl_outline
  dat_read_only: true
- name: glsl_scroll_pixel
  type: textDAT
  parameters:
    extension: frag
  flags:
  - viewer
  position: [2350, -2620]
  dock: glsl_scroll
  dat_content: "// Ornamental scrollwork for the field: domain-warped simplex fBm in polar coordinates, folded\n// into mirrored sectors like carpet ornament. Two interlocking families of FILLED organic lobes\n// (orange and green, each with a thin ink rim) like thangka cloud scrolls, plus optional faint\n// squiggle lines. Evolves by walking a circle in the noise's zw plane, so it loops exactly.\n// Output is premultiplied; drawn on a quad inside the main render.\n// Uniform values come from the Vectors page (GLSL TOP uniforms must be declared here).\n\nuniform float uTime;\nuniform float uLoop;\nuniform float uLoopLen;\nuniform float uSeed;\nuniform float uAmount;\nuniform float uScale;\nuniform float uWarp;\nuniform float uDensity;\nuniform float uLeaves;      // opacity of the faint squiggle lines (0 = fills only)\nuniform float uInner;\nuniform float uOuter;\nuniform float uFlow;        // radial stretch of the lobes\nuniform float uEvolve;      // outward growth speed, pattern units per second\nuniform float uMorph;       // in-place morph amount (bends the warp, swells the lobes)\nuniform float uMorphRate;   // morph rate, radians per second\nuniform float uSymmetry;\nuniform float uDetail;\nuniform float uRes;\nuniform vec3 uLineColor;    // fill family A (orange)\nuniform vec3 uLeafColor;    // fill family B (green, lifted toward gold in the shader)\nuniform vec3 uInkColor;\n\nout vec4 fragColor;\n\n#define TAU 6.28318530718\n\nfloat fbm(vec4 p) {\n\tfloat a = 0.5;\n\tfloat s = 0.0;\n\tfor (int i = 0; i < 6; i++) {\n\t\tif (float(i) >= uDetail) break;\n\t\ts += a * TDSimplexNoise(p);\n\t\tp = p * 2.03 + 1.7;\n\t\ta *= 0.5;\n\t}\n\treturn s;\n}\n\n// the radial coordinate lives on a circle in the noise's xy plane (period P), so sliding it with\n// time carries every lobe from the centre toward the rim with no seam and an exact loop\nvec4 cyl(float ur, float arc, float P) {\n\tfloat a = TAU * ur / P;\n\tfloat Rc = P / TAU;\n\treturn vec4(cos(a) * Rc, sin(a) * Rc, arc, uSeed);\n}\n\nvec4 over(vec4 acc, vec3 c, float a) {\n\treturn vec4(c * a + acc.rgb * (1.0 - a), a + acc.a * (1.0 - a));\n}\n\nvoid main() {\n\tvec2 p = vUV.st * 2.0 - 1.0;                    // the quad spans -1..1 scene units\n\tfloat r = length(p);\n\tfloat m = smoothstep(uInner - 0.025, uInner + 0.025, r)\n\t        * (1.0 - smoothstep(uOuter - 0.025, uOuter + 0.025, r));\n\tif (m <= 0.002 || uAmount <= 0.0) {\n\t\tfragColor = vec4(0.0);\n\t\treturn;\n\t}\n\n\tfloat th = atan(p.y, p.x);\n\tfloat k = max(uSymmetry, 1.0);\n\tfloat sec = TAU / k;\n\tfloat thf = abs(mod(th + sec * 0.5, sec) - sec * 0.5);   // mirrored fold, 0 .. sec/2\n\n\t// outward growth: shift the radial coordinate with time, whole pattern periods per loop\n\tfloat P = 4.0;\n\tfloat shift;\n\tif (uLoop > 0.5) {\n\t\tfloat n = max(1.0, floor(uEvolve * uLoopLen / P + 0.5));\n\t\tshift = n * P * fract(uTime / uLoopLen);\n\t} else {\n\t\tshift = uEvolve * uTime;\n\t}\n\tfloat stretch = 1.0 / (1.0 + uFlow);            // lobes elongated along the growth direction\n\tfloat ur = r * uScale * stretch - shift;        // falls with time, so every feature moves outward\n\tfloat arc = thf * r * uScale;\n\tvec4 q = cyl(ur, arc, P);\n\tvec2 w = vec2(fbm(q * 0.8 + vec4(3.1, 3.1, 3.1, 0.0)), fbm(q * 0.8 + vec4(7.7, 7.7, 7.7, 2.0)));\n\t// organic breathing: a second field walks a circle in noise space over the loop and bends the\n\t// domain warp, so the lobes writhe and swell as they grow instead of sliding like a stamp\n\tfloat mph;\n\tif (uLoop > 0.5) {\n\t\tfloat mc = max(1.0, floor(uMorphRate * uLoopLen / TAU + 0.5));\n\t\tmph = TAU * mc * fract(uTime / uLoopLen);\n\t} else {\n\t\tmph = uTime * uMorphRate;\n\t}\n\tvec2 mcirc = vec2(cos(mph), sin(mph)) * 0.9;\n\tvec4 qm = vec4(mcirc, r * uScale * 0.45 + 5.0, arc * 0.45 + uSeed);\n\tvec2 mw = vec2(fbm(qm), fbm(qm + vec4(0.0, 0.0, 13.0, 17.0)));\n\tw += uMorph * mw;\n\tq = cyl(ur + uWarp * w.x, arc + uWarp * w.y, P);\n\tfloat ps = max(uRes / 1080.0, 0.25);            // widths authored at 1080, scale with Resolution\n\n\t// two families of filled
    lobes sharing the warped space, so they interlock\n\tfloat gA = fbm(q * 0.9 + vec4(11.3, 11.3, 11.3, 9.0));\n\tfloat gB = fbm(q * 0.9 + vec4(29.7, 29.7, 29.7, 17.0));\n\tgA += 0.12 * uMorph * mw.x;                     // lobes swell and shrink with the morph\n\tgB += 0.12 * uMorph * mw.y;\n\tfloat tA = 0.17;                                // low thresholds: dense, minute lobes\n\tfloat tB = 0.12;\n\tfloat aaA = fwidth(gA) * 1.5 + 1e-4;\n\tfloat aaB = fwidth(gB) * 1.5 + 1e-4;\n\tfloat fillA = smoothstep(tA - aaA, tA + aaA, gA);\n\tfloat fillB = smoothstep(tB - aaB, tB + aaB, gB) * (1.0 - fillA);\n\tfloat rimW = 0.035;\n\tfloat rimA = smoothstep(tA - rimW - aaA, tA - rimW + aaA, gA) * (1.0 - fillA);\n\tfloat rimB = smoothstep(tB - rimW - aaB, tB - rimW + aaB, gB) * (1.0 - fillB) * (1.0 - fillA) * (1.0 - rimA);\n\n\t// colour variation inside the orange family (saffron toward vermilion)\n\tfloat hue = 0.5 + 0.5 * fbm(q * 0.5 + vec4(41.0, 41.0, 41.0, 0.0));\n\tvec3 orange = mix(uLineColor, vec3(0.90, 0.30, 0.12), hue * 0.45) * 1.12;\n\tvec3 green = mix(uLeafColor, vec3(0.72, 0.92, 0.36), 0.5) * 1.25;   // lime that lifts off the teal field\n\n\tvec4 acc = vec4(0.0);\n\tacc = over(acc, green, fillB * 0.92);\n\tacc = over(acc, uInkColor, rimB * 0.9);\n\tacc = over(acc, orange, fillA * 0.95);\n\tacc = over(acc, uInkColor, rimA * 0.9);\n\n\t// optional faint squiggle lines over the fills\n\tif (uLeaves > 0.0) {\n\t\tfloat f = fbm(q + vec4(0.0, 0.0, 0.0, 5.0));\n\t\tfloat v = f * uDensity;\n\t\tfloat fw = fwidth(v) + 1e-5;\n\t\tfloat d = abs(fract(v) - 0.5);\n\t\tfloat thin = 1.0 - smoothstep(0.0, fw * 1.8 * ps, d);\n\t\tacc = over(acc, vec3(0.96, 0.91, 0.78), thin * uLeaves * 0.6);\n\t}\n\n\tacc *= m * uAmount;\n\tfragColor = TDOutputSwizzle(acc);\n}\n"
  dat_content_format: text
- name: glsl_wear_compute
  type: textDAT
  flags:
  - viewer
  - -showDocked
  position: [3250, -1520]
  dock: glsl_wear
  dat_content: "// Example Compute Shader\n\n// uniform float exampleUniform;\n\nlayout (local_size_x = 8, local_size_y = 4) in;\nvoid main()\n{\n\t// This code is running 1:1 per pixel, so early-exit\n\t// if this thread overhangs the edge of the output\n\tif (any(greaterThanEqual(ivec2(gl_GlobalInvocationID.xy), ivec2(uTDOutputInfo.res.zw))))\n\t\treturn;\n\n\tvec4 color;\n\t//color = texelFetch(sTD2DInputs[0], ivec2(gl_GlobalInvocationID.xy), 0);\n\tcolor = vec4(1.0);\n\t// We need to use TDImageStoreOutput() so that 8-bit textures that are sRGB\n\t// encoded can be written to correctly from incoming linear values.\n\t// imageStore() does not do this automatically, while pixel shader outputs do.\n\tTDImageStoreOutput(0, gl_GlobalInvocationID, color);\n}\n"
  dat_content_format: text
- name: palace_gold_frame
  type: baseCOMP
  custom_pars:
