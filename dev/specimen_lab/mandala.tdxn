      - name: Wobble
        value: =parent.Layer.par.Wobble
      - name: Wobblescale
        value: =parent.Layer.par.Wobblescale
      - name: Seed
        value: =parent.Mandala.par.Seed + next((i for i, o in enumerate(parent.Mandala.op('merge_params').inputs) if o.path.startswith(parent.Layer.path)), 0)
      - name: Wave
        value: =parent.Layer.par.Wave
      - name: Waverate
        value: =parent.Layer.par.Waverate
      - name: Wavecycles
        value: =parent.Layer.par.Wavecycles
      - name: Colorwave
        value: =parent.Layer.par.Colorwave
      - name: Colorrate
        value: =parent.Layer.par.Colorrate
      - name: Tumble
        value: =parent.Layer.par.Tumble
      - name: Tumblerate
        value: =parent.Layer.par.Tumblerate
      - name: Nestspin
        value: =parent.Layer.par.Nestspin
      - name: Wobblerate
        value: =parent.Layer.par.Wobblerate
      - name: Radiusanim
        value: =parent.Layer.par.Radiusanim
      - name: Radiusrate
        value: =parent.Layer.par.Radiusrate
      - name: Amplitudeanim
        value: =parent.Layer.par.Amplitudeanim
      - name: Amplituderate
        value: =parent.Layer.par.Amplituderate
      - name: Sharpnessanim
        value: =parent.Layer.par.Sharpnessanim
      - name: Sharpnessrate
