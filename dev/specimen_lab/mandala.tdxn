- name: glsl_outline
  type: glslPOP
  parameters:
    computedat: glsl_outline_compute
  sequences:
    attr:
    - name: color
      numcomps: '4'
    - name: linewidth
    vec:
    - name: uTime
      valuex: =(parent.Mandala.par.Manualtime if parent.Mandala.par.Timemode.eval() == 'manual' else absTime.seconds) * parent.Mandala.par.Speedmult
    - name: uEnergy
      valuex: =parent.Mandala.par.Energy
    - name: uGlobalRot
      valuex: =parent.Mandala.par.Rotate
    - name: uIsFill
      type: int
      valuex: 2
    - name: uLoop
      valuex: =parent.Mandala.par.Loop
    - name: uLoopLen
      valuex: =parent.Mandala.par.Looplength
    - name: uInkColor
      type: vec3
      valuex: =parent.Mandala.par['Col%dr' % int(parent.Mandala.par.Inkcolor)]
      valuey: =parent.Mandala.par['Col%dg' % int(parent.Mandala.par.Inkcolor)]
      valuez: =parent.Mandala.par['Col%db' % int(parent.Mandala.par.Inkcolor)]
    - name: uInkWidth
      valuex: =parent.Mandala.par.Inkwidth
    array:
    - name: uP
      chop: /specimen_lab/mandala/shuffle_params
      arraytype: texturebuffer
  position: [1000, -1500]
  inputs:
  - merge_line
