format: tdxn
version: '2.1'
build: 2
generator: Embody/6.2.53
td_build: 099.2025.33230
network_path: /specimen_lab/mandala
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  attributePOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  baseCOMP:
    parameters:
      parentshortcut: Layer
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  circlePOP:
    parameters:
      divs: =parent.Layer.par.Detail
      endangle: 360
      normal: none
      texture: none
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantCHOP:
    parameters:
      autoexportroot: =parent()
      rate: =me.time.rate
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantMAT:
    parameters:
      blending: true
      skelrootpath: =parent()
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  copyPOP:
    parameters:
      copyid: point
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  geometryCOMP:
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  glslPOP:
    parameters:
      initoutputattrs: false
      outputattrs: P
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  glslTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  inPOP:
    parameters:
      label: =me.name
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  infoDAT:
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  mergePOP:
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  noiseTOP:
    parameters:
      resolutionh: =parent.Mandala.par.Resolution
      resolutionw: =parent.Mandala.par.Resolution
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullPOP:
    flags:
    - display
    - render
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  outCHOP:
    parameters:
      autoexportroot: =parent()
      label: =me.name
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  outPOP:
    parameters:
      label: =me.name
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textDAT:
    parameters:
      language: glsl
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
par_templates:
  layer:
  - default: true
    help: Turn this layer on or off.
    name: Active
    style: Toggle
  - default: circle
    help: 'Base outline: circle, regular polygon (Lobes = sides), star (Lobes = points), rosette (Lobes = smooth petal lobes), scallop (Lobes = outward bumps), petal (one leaf at Radius, radial copies via Count), bar (rounded bar at Radius, e.g. palace gates), dot (small circle of radius Length at Radius).'
    menuLabels:
    - Circle
    - Polygon
    - Star
    - Rosette
    - Scallop
    - Petal
    - Bar
    - Dot
    - Arc
    menuNames:
    - circle
    - polygon
    - star
    - rosette
    - scallop
    - petal
    - bar
    - dot
    - arc
    name: Shape
    style: Menu
  - default: line
    help: line = outline only, fill = filled shape only, both = fill with its outline on top.
    menuLabels:
    - Line
    - Fill
    - Both
    menuNames:
    - line
    - fill
    - both
    name: Style
    style: Menu
  - clampMax: true
    clampMin: true
    default: 1
    help: Stacking order. Higher draws on top of lower (each step lifts the layer a little toward the camera).
    label: Draw Order
    max: 200.0
    name: Order
    normMax: 40.0
    style: Int
  - default: 0.8
    help: Ring radius (for rings) or base distance from the center (petal, bar, dot). The visible field is about 1.1 wide at Scale 1.
    name: Radius
    normMax: 1.2
    startSection: true
    style: Float
  - clampMax: true
    clampMin: true
    default: 8
    help: 'Symmetry of the outline: polygon sides, star points, rosette lobes, scallop bumps.'
    max: 1024.0
    min: 1.0
    name: Lobes
    normMax: 64.0
    normMin: 2.0
    style: Int
  - default: 0.15
    help: Depth of the star / rosette / scallop bumps as a fraction of Radius.
    name: Amplitude
    style: Float
  - clampMax: true
    clampMin: true
    default: 1
    help: Tip shaping. Above 1 = pointier star points, petal tips and scallops; below 1 = rounder.
    max: 32.0
    min: 0.02
    name: Sharpness
    normMax: 4.0
    normMin: 0.1
    style: Float
  - default: 0.2
    help: Petal / bar length along the radius, the dot radius, or the arc share of its slot (1 = touching neighbours).
    name: Length
    normMax: 0.6
    style: Float
  - default: 0.06
    help: Petal / bar half-width across the radius, or the arc half-thickness.
    name: Width
    normMax: 0.3
    style: Float
  - clampMax: true
    clampMin: true
    default: 96
    help: Points around each outline. More = smoother curves and finer wobble; the fill triangulation is capped at 512.
    max: 512.0
    min: 4.0
    name: Detail
    normMax: 256.0
    normMin: 8.0
    style: Int
  - clampMax: true
    clampMin: true
    help: 'Cuts the middle of every edge (polygon) or lobe sector (other shapes) out of the outline: 0 = closed, 0.6 = only the corners remain. Applies to the fill and ink contour too.'
    max: 0.98
    name: Gap
    style: Float
  - clampMax: true
    clampMin: true
    default: 1
    help: Radial copies around the center (petals, dots, bars, and repeated rings).
    max: 2048.0
    min: 1.0
    name: Count
    normMax: 64.0
    normMin: 1.0
    startSection: true
    style: Int
  - clampMax: true
    clampMin: true
    default: 1
    help: Concentric copies of the shape (double and triple outlines, nested petals).
    max: 64.0
    min: 1.0
    name: Nest
    normMax: 8.0
    normMin: 1.0
    style: Int
  - default: 0.04
    help: Shrink per nested copy (0.04 = each inner copy is 4 percent smaller, about its own center for petals, bars and dots).
    label: Nest Gap
    name: Nestgap
    normMax: 0.3
    style: Float
  - help: Static rotation of the whole layer in degrees.
    name: Rotate
    normMax: 180.0
    normMin: -180.0
    startSection: true
    style: Float
  - help: Continuous spin in degrees per second (negative = counter-clockwise). Scaled by the Mandala Speed Multiplier.
    name: Speed
    normMax: 10.0
    normMin: -10.0
    style: Float
  - help: Breathing scale amount (0.03 = plus or minus 3 percent).
    name: Pulse
    normMax: 0.2
    style: Float
  - default: 0.5
    help: Breathing speed in radians per second.
    label: Pulse Rate
    name: Pulserate
    normMax: 3.0
    style: Float
  - clampMax: true
    clampMin: true
    default: 5
    help: Palette slot (1-8 on the Mandala Palette page) for this layer.
    label: Color A
    max: 8.0
    min: 1.0
    name: Colora
    normMax: 8.0
    normMin: 1.0
    startSection: true
    style: Int
  - clampMax: true
    clampMin: true
    default: 3
    help: Second palette slot, used when Alternate is on.
    label: Color B
    max: 8.0
    min: 1.0
    name: Colorb
    normMax: 8.0
    normMin: 1.0
    style: Int
  - clampMax: true
    clampMin: true
    help: Palette slot for the outline when Style is Both (or any line layer). 0 = same colors as the fill (Color A / Color B).
    label: Line Color
    max: 8.0
    name: Linecolor
    normMax: 8.0
    style: Int
  - default: 'off'
    help: Alternate Color A / Color B per radial copy or per nested copy.
    menuLabels:
    - 'Off'
    - Per Copy
    - Per Nest
    menuNames:
    - 'off'
    - copy
    - nest
    name: Alternate
    style: Menu
  - clampMax: true
    clampMin: true
    default: 1
    help: Opacity of this layer (fills and lines).
    name: Opacity
    style: Float
  - clampMax: true
    clampMin: true
    default: 1
    help: Multiplier on the Mandala base Line Width for this layer.
    label: Line Width
    max: 50.0
    name: Linewidth
    normMax: 4.0
    normMin: 0.2
    style: Float
  - clampMax: true
    clampMin: true
    help: 'Dark contour behind this element: width as a multiple of its Line Width (0 = none, 1.5 = a clear dark rim around outlines and fills). Drawn in the Mandala Ink Color.'
    max: 20.0
    name: Ink
    normMax: 3.0
    style: Float
  - help: 'Hand-drawn imperfection: noise displacement of every point, in scene units (0.002-0.006 is subtle).'
    name: Wobble
    normMax: 0.02
    style: Float
  - default: 6
    help: Spatial frequency of the wobble noise.
    label: Wobble Scale
    name: Wobblescale
    normMax: 30.0
    normMin: 1.0
    style: Float
  animate:
  - help: 'Traveling wave around the ring: each radial copy pushes outward and back in turn (fraction of Radius). Energetic on petal, dot and bar rings.'
    name: Wave
    normMax: 0.3
    startSection: true
    style: Float
  - default: 1
    help: Wave speed in radians per second.
    label: Wave Rate
    name: Waverate
    normMax: 6.0
    style: Float
  - clampMax: true
    clampMin: true
    default: 1
    help: How many wave crests travel around the ring at once (also phases the color wave and tumble).
    label: Wave Cycles
    max: 64.0
    min: 1.0
    name: Wavecycles
    normMax: 12.0
    normMin: 1.0
    style: Int
  - clampMax: true
    clampMin: true
    help: Cross-fades each copy between Color A and Color B in a traveling wave (0 = static alternation only).
    label: Color Wave
    name: Colorwave
    startSection: true
    style: Float
  - default: 1
    help: Color wave speed in radians per second.
    label: Color Rate
    name: Colorrate
    normMax: 6.0
    style: Float
  - help: Each petal / bar / dot rocks about its own center by this many degrees, phased around the ring.
    name: Tumble
    normMax: 45.0
    startSection: true
    style: Float
  - default: 1
    help: Tumble speed in radians per second.
    label: Tumble Rate
    name: Tumblerate
    normMax: 6.0
    style: Float
  - help: 'Extra spin per nested copy in degrees per second (copy 1 spins once, copy 2 twice ...): spirograph motion on nested rings.'
    label: Nest Spin
    name: Nestspin
    normMax: 30.0
    normMin: -30.0
    startSection: true
    style: Float
  - help: Makes the hand-drawn Wobble crawl over time (0 = frozen ink).
    label: Wobble Rate
    name: Wobblerate
    normMax: 2.0
    style: Float
  - help: Breathes the whole layer Radius by this amount (scene units).
    label: Radius LFO
    name: Radiusanim
    normMax: 0.2
    startSection: true
    style: Float
  - default: 1
    help: Radius LFO speed in radians per second.
    label: Radius Rate
    name: Radiusrate
    normMax: 6.0
    style: Float
  - help: Swings the star / rosette / scallop Amplitude by this amount.
    label: Amplitude LFO
    name: Amplitudeanim
    normMax: 0.5
    style: Float
  - default: 1
    help: Amplitude LFO speed in radians per second.
    label: Amplitude Rate
    name: Amplituderate
    normMax: 6.0
    style: Float
  - help: Swings Sharpness by this amount (tips flex between round and pointed).
    label: Sharpness LFO
    name: Sharpnessanim
    normMax: 2.0
    style: Float
  - default: 1
    help: Sharpness LFO speed in radians per second.
    label: Sharpness Rate
    name: Sharpnessrate
    normMax: 6.0
    style: Float
  - help: Swings petal / bar Length (or dot radius) by this amount.
    label: Length LFO
    name: Lengthanim
    normMax: 0.3
    style: Float
  - default: 1
    help: Length LFO speed in radians per second.
    label: Length Rate
    name: Lengthrate
    normMax: 6.0
    style: Float
  - help: Swings petal / bar Width by this amount.
    label: Width LFO
    name: Widthanim
    normMax: 0.15
    style: Float
  - default: 1
    help: Width LFO speed in radians per second.
    label: Width Rate
    name: Widthrate
    normMax: 6.0
    style: Float
  - help: Breathes the spacing of nested copies by this amount.
    label: Nest Gap LFO
    name: Nestgapanim
    normMax: 0.2
    style: Float
  - default: 1
    help: Nest gap LFO speed in radians per second.
    label: Nest Gap Rate
    name: Nestgaprate
    normMax: 6.0
    style: Float
  - help: Swings the line width multiplier by this amount (throbbing outlines).
    label: Line Width LFO
    name: Linewidthanim
    normMax: 2.0
    style: Float
  - default: 1
    help: Line width LFO speed in radians per second.
    label: Line Width Rate
    name: Linewidthrate
    normMax: 6.0
    style: Float
  - clampMax: true
    clampMin: true
    help: Dims and restores the layer by this amount (twinkle).
    label: Opacity LFO
    name: Opacityanim
    style: Float
  - default: 1
    help: Opacity LFO speed in radians per second.
    label: Opacity Rate
    name: Opacityrate
    normMax: 6.0
    style: Float
type: baseCOMP
custom_pars:
  Mandala:
  - name: Resolution
    style: Int
    default: 1080
    min: 64.0
    max: 4096.0
    clampMin: true
    clampMax: true
    normMin: 256.0
    normMax: 2160.0
    help: Output size in pixels (square). Render, noise and finishing TOPs all follow it.
  - name: Scale
    style: Float
    default: 1
    min: 0.05
    max: 10.0
    clampMin: true
    clampMax: true
    normMin: 0.5
    normMax: 2.0
    help: Global zoom. 1.0 fits a radius-1 mandala with a small margin.
    value: 0.92
  - name: Rotate
    style: Float
    normMin: -180.0
    normMax: 180.0
    help: Global rotation of the whole mandala in degrees, added to every layer.
  - name: Speedmult
    style: Float
    label: Speed Multiplier
    default: 1
    max: 100.0
    clampMin: true
    clampMax: true
    normMax: 4.0
    help: Multiplies every layer Speed and Pulse Rate. 0 freezes the animation.
    value: 2
  - name: Energy
    style: Float
    default: 1
    max: 10.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Multiplies every layer animation AMOUNT (waves, tumble, LFO depths). 0 freezes shapes in place while spins continue; 2 doubles the motion.
    value: 1.5
  - name: Linewidth
    style: Float
    label: Line Width
    startSection: true
    default: 1.4
    min: 0.01
    max: 50.0
    clampMin: true
    clampMax: true
    normMin: 0.2
    normMax: 6.0
    help: 'Base line width for every line layer (Line MAT units: 1 = 1/1000 of the image width). Each layer multiplies it with its own Line Width.'
    value: 2
  - name: Loop
    style: Toggle
    startSection: true
    help: Quantize every animation rate and spin so the whole mandala repeats exactly every Loop Length seconds (for seamless renders). Wobble crawl walks a circle in noise space instead of drifting.
  - name: Inkwidth
    style: Float
    label: Ink Width
    default: 1
    max: 20.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Global multiplier on every layer Ink contour (the dark stroke drawn behind outlines and around fills).
    value: 1.15
  - name: Looplength
    style: Float
    label: Loop Length
    default: 12
    min: 0.5
    max: 3600.0
    clampMin: true
    clampMax: true
    normMin: 2.0
    normMax: 60.0
    help: Seconds per seamless loop when Loop is on.
  - name: Fillopacity
    style: Float
    label: Fill Opacity
    default: 1
    clampMin: true
    clampMax: true
    help: Global opacity of every filled shape.
  - name: Inkcolor
    style: Int
    label: Ink Color
    default: 8
    min: 1.0
    max: 8.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 8.0
    help: Palette slot used for the Ink contours (8 = Ink by default).
  - name: Timemode
    style: Menu
    label: Time Mode
    default: realtime
    menuNames:
    - realtime
    - manual
    menuLabels:
    - Realtime
    - Manual
    help: realtime = wall clock (absTime); manual = the Manual Time parameter drives every animation (used by frame-accurate offline renders).
  - name: Manualtime
    style: Float
    label: Manual Time
    normMax: 60.0
    help: Animation time in seconds when Time Mode is manual.
  - name: Saturation
    style: Float
    default: 0.92
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 1.5
    help: Global color saturation multiplier applied before the wear pass. Below 1 ages the pigments (0.85 = gently faded).
  - name: Background
    style: RGBA
    size: 3
    startSection: true
    default: [0.06, 0.16, 0.46]
    help: Background field color behind the mandala (the deep thangka blue by default).
  Palette:
  - name: Col1
    style: RGBA
    label: 1 Vermilion
    size: 3
    startSection: true
    default: [0.82, 0.2, 0.13]
    help: Palette slot 1 (Vermilion). Layers pick slots by number with Color A / Color B, so recoloring here restyles every layer that uses it.
  - name: Col2
    style: RGBA
    label: 2 Saffron
    size: 3
    default: [0.94, 0.53, 0.12]
    help: Palette slot 2 (Saffron). Layers pick slots by number with Color A / Color B, so recoloring here restyles every layer that uses it.
  - name: Col3
    style: RGBA
    label: 3 Gold
    size: 3
    default: [0.93, 0.76, 0.3]
    help: Palette slot 3 (Gold). Layers pick slots by number with Color A / Color B, so recoloring here restyles every layer that uses it.
  - name: Col4
    style: RGBA
    label: 4 Teal
    size: 3
    default: [0.12, 0.5, 0.41]
    help: Palette slot 4 (Teal). Layers pick slots by number with Color A / Color B, so recoloring here restyles every layer that uses it.
  - name: Col5
    style: RGBA
    label: 5 Cream
    size: 3
    default: [0.96, 0.91, 0.78]
    help: Palette slot 5 (Cream). Layers pick slots by number with Color A / Color B, so recoloring here restyles every layer that uses it.
  - name: Col6
    style: RGBA
    label: 6 Indigo
    size: 3
    default: [0.13, 0.3, 0.66]
    help: Palette slot 6 (Indigo). Layers pick slots by number with Color A / Color B, so recoloring here restyles every layer that uses it.
  - name: Col7
    style: RGBA
    label: 7 Rose
    size: 3
    default: [0.8, 0.3, 0.44]
    help: Palette slot 7 (Rose). Layers pick slots by number with Color A / Color B, so recoloring here restyles every layer that uses it.
  - name: Col8
    style: RGBA
    label: 8 Ink
    size: 3
    default: [0.1, 0.07, 0.09]
    help: Palette slot 8 (Ink). Layers pick slots by number with Color A / Color B, so recoloring here restyles every layer that uses it.
  Wear:
  - name: Grunge
    style: Float
    default: 0.35
    max: 2.0
    clampMin: true
    clampMax: true
    help: Strength of the paper-fiber texture inside the worn patches. 0 = clean vector look.
  - name: Grungebase
    style: Float
    label: Grunge Base
    default: 0.14
    max: 2.0
    clampMin: true
    clampMax: true
    normMax: 0.5
    help: Uniform paper-fibre texture over the WHOLE image, mandala included (the patchy Grunge sits on top of it). Keep it low.
  - name: Grungescale
    style: Float
    label: Grunge Scale
    default: 1
    min: 0.01
    max: 50.0
    clampMin: true
    clampMax: true
    normMin: 0.25
    normMax: 4.0
    help: Size of the fiber texture. Higher = finer grain.
    value: 2
  - name: Coverage
    style: Float
    default: 0.35
    clampMin: true
    clampMax: true
    help: How much of the image is worn. 0 = pristine everywhere, 1 = worn everywhere. The wear is patchy, never uniform.
    value: 0.3
  - name: Patchscale
    style: Float
    label: Patch Scale
    default: 1
    min: 0.01
    max: 50.0
    clampMin: true
    clampMax: true
    normMin: 0.25
    normMax: 4.0
    help: Size of the worn patches. Lower = a few big faded regions, higher = many small spots.
    value: 0.7
  - name: Fade
    style: Float
    default: 0.35
    clampMin: true
    clampMax: true
    help: How far the worn patches fade toward the Paper color (faded ink / rubbed pigment).
    value: 0.1
  - name: Paper
    style: RGBA
    size: 3
    default: [0.84, 0.76, 0.6]
    help: Color the worn patches fade toward (old cloth / paper).
  - name: Seed
    style: Float
    default: 1
    normMax: 100.0
    help: Random seed for the wear pattern. Change it to get a different distribution of patches.
  - name: Vignette
    style: Float
    startSection: true
    default: 0.22
    clampMin: true
    clampMax: true
    help: Darkening of the frame corners. Keep it subtle.
  - name: Grain
    style: Float
    default: 0.035
    clampMin: true
    clampMax: true
    normMax: 0.2
    help: Animated film grain added last. 0.03-0.06 is subtle.
  - name: Sparkle
    style: Float
    label: Sparkle Density
    startSection: true
    default: 0.0001
    max: 0.05
    clampMin: true
    clampMax: true
    normMax: 0.0005
    help: Fraction of pixels that carry a bright shimmering speck (0.00001 = 0.001 percent). Very sparse by design; raise to 0.0001 for a visible dusting.
  - name: Sparkleclump
    style: Float
    label: Sparkle Clumping
    default: 0.7
    clampMin: true
    clampMax: true
    help: How much the specks gather into a few clusters instead of spreading evenly.
  - name: Sparklerate
    style: Float
    label: Sparkle Shimmer
    default: 2.5
    max: 100.0
    clampMin: true
    clampMax: true
    normMax: 8.0
    help: Twinkle speed of the specks in radians per second (snapped to whole cycles in Loop mode).
  Scroll:
  - name: Scrollwork
    style: Float
    startSection: true
    default: 0.85
    clampMin: true
    clampMax: true
    help: Opacity of the ornamental scrollwork layer drawn over the field (0 = off). Squiggling contour lines and small leaf lobes, folded into mirrored sectors like carpet ornament.
  - name: Scrollscale
    style: Float
    label: Scale
    default: 4
    min: 0.1
    max: 100.0
    clampMin: true
    clampMax: true
    normMin: 2.0
    normMax: 16.0
    help: Size of the ornament. Higher = finer, more squiggles.
    value: 12
  - name: Scrolldetail
    style: Int
    label: Detail
    default: 3
    min: 1.0
    max: 6.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 6.0
    help: 'Noise octaves in the ornament: 2-3 = smooth graceful curls, 5-6 = crackly fine detail.'
    value: 4
  - name: Scrollwarp
    style: Float
    label: Warp
    default: 0.7
    max: 10.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: 'Domain warp strength: how much the lines curl and swirl (the liquid look).'
  - name: Scrolldensity
    style: Float
    label: Line Density
    default: 3.2
    min: 0.1
    max: 60.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 12.0
    help: Number of contour squiggles across the field.
  - name: Scrollleaves
    style: Float
    label: Squiggle Lines
    clampMin: true
    clampMax: true
    help: Opacity of faint contour squiggles drawn over the filled lobes (0 = fills only).
  - name: Scrollsymmetry
    style: Int
    label: Symmetry
    default: 8
    min: 1.0
    max: 64.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 24.0
    help: Mirrored sectors around the centre (8 = matches the vases and gates).
  - name: Scrollinner
    style: Float
    label: Inner Radius
    default: 0.5
    max: 2.0
    clampMin: true
    clampMax: true
    normMin: 0.3
    normMax: 0.8
    help: Where the ornament starts (scene units; the palace wall sits at about 0.47).
  - name: Scrollouter
    style: Float
    label: Outer Radius
    default: 0.855
    max: 2.0
    clampMin: true
    clampMax: true
    normMin: 0.5
    help: Where the ornament stops (the beads sit at 0.86).
  - name: Scrollflow
    style: Float
    label: Growth Stretch
    default: 0.35
    max: 10.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Radial elongation of the ornament lobes along their growth direction (0 = round, 1 = twice as long radially).
  - name: Scrollevolve
    style: Float
    label: Growth Speed
    default: 0.15
    max: 20.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Outward growth speed of the ornament in pattern units per second (snapped to whole pattern periods per loop in Loop mode). Always outward from the centre.
  - name: Scrolllinecolor
    style: Int
    label: Fill Color A
    startSection: true
    default: 2
    min: 1.0
    max: 8.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 8.0
    help: Palette slot for the first lobe family (saffron by default; varies toward vermilion).
  - name: Scrollleafcolor
    style: Int
    label: Fill Color B
    default: 4
    min: 1.0
    max: 8.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 8.0
    help: Palette slot for the second lobe family (teal by default, lifted toward gold in the shader).
  - name: Scrollmorph
    style: Float
    label: Organic Morph
    default: 0.8
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 1.5
    help: How much the ornament writhes and swells in place while it grows (a second noise field bends the domain warp). 0 = rigid stamp sliding outward.
  - name: Scrollmorphrate
    style: Float
    label: Morph Rate
    default: 0.3
    max: 5.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Speed of the in-place morph in radians per second (snapped to whole cycles per loop in Loop mode).
parameters:
  parentshortcut: Mandala
flags:
- viewer
color: [0.3, 0.5, 0.9]
tags:
- tdxn
operators:
- name: cam
  type: cameraCOMP
  parameters:
    tz: 10
    projection: ortho
    orthowidth: =2.3 / parent.Mandala.par.Scale
  position: [2200, -1000]
  size: [160, 130]
  color: [0.67, 0.67, 0.67]
  children:
  - name: file1
    type: fileinPOP
    parameters:
      file: =app.samplesFolder + '/Geo/defcam.tog'
    flags:
    - display
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
- name: out1
  type: outTOP
  parameters:
    label: =me.name
  flags:
  - display
  - viewer
  position: [3800, -1400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - glsl_wear
- name: render
  type: renderTOP
  parameters:
    camera: cam
    geometry: geo_fill geo_scroll geo_outline geo_line
    antialias: aa8
    resolutionw: =parent.Mandala.par.Resolution
    resolutionh: =parent.Mandala.par.Resolution
  position: [2200, -1400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: comp_bg
  type: compositeTOP
  parameters:
    operand: over
  position: [2600, -1400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - render
  - constant_bg
- name: hsv_age
  type: hsvadjustTOP
  parameters:
    saturationmult: =parent.Mandala.par.Saturation
  position: [3000, -1400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - comp_bg
- name: geo_fill
  type: geometryCOMP
  parameters:
    tz: -0.004
    material: mat_fill
  position: [1400, -1800]
  inputs:
  - glsl_fill
  children:
  - name: in1
    type: inPOP
  - name: null_out
    type: nullPOP
    position: [400, 0]
    inputs:
    - in1
- name: geo_line
  type: geometryCOMP
  parameters:
    material: mat_line
  position: [1400, -1200]
  inputs:
  - glsl_line
  children:
  - name: in1
    type: inPOP
  - name: null_out
    type: nullPOP
    position: [400, 0]
    inputs:
    - in1
- name: mat_fill
  type: constantMAT
  parameters:
    alpha: =parent.Mandala.par.Fillopacity
  position: [1400, -1650]
- name: mat_line
  type: lineMAT
  parameters:
    widthnear: =parent.Mandala.par.Linewidth
    widthfar: =parent.Mandala.par.Linewidth
    liftscale: 0
    linenearcolorr: 1
    linenearcolorg: 1
    linenearcolorb: 1
    skelrootpath: =parent()
    blending: true
  position: [1400, -1000]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: bead_ring
  type: baseCOMP
  custom_pars:
    Layer:
      $t: layer
      Shape: dot
      Style: fill
      Order: 7
      Radius: 0.86
      Length: 0.011
      Detail: 24
      Count: 96
      Speed: 1.5
      Ink: 1.3
    Animate:
      $t: animate
      Wave: 0.02
      Waverate: 2.5
      Wavecycles: 4
      Lengthanim: 0.004
      Lengthrate: 3
      Opacityanim: 0.25
      Opacityrate: 2
  position: [0, -1400]
  children:
  - name: params
    type: constantCHOP
    sequences:
      const:
      - name: Active
        value: =parent.Layer.par.Active
      - name: Shape
        value: =parent.Layer.par.Shape.menuIndex
      - name: Style
        value: =parent.Layer.par.Style.menuIndex
      - name: Order
        value: =parent.Layer.par.Order
      - name: Radius
        value: =parent.Layer.par.Radius
      - name: Lobes
        value: =parent.Layer.par.Lobes
      - name: Amplitude
        value: =parent.Layer.par.Amplitude
      - name: Sharpness
        value: =parent.Layer.par.Sharpness
      - name: Length
        value: =parent.Layer.par.Length
      - name: Width
        value: =parent.Layer.par.Width
      - name: Count
        value: =parent.Layer.par.Count
      - name: Nest
        value: =parent.Layer.par.Nest
      - name: Nestgap
        value: =parent.Layer.par.Nestgap
      - name: Rotate
        value: =parent.Layer.par.Rotate
      - name: Speed
        value: =parent.Layer.par.Speed
      - name: Pulse
        value: =parent.Layer.par.Pulse
      - name: Pulserate
        value: =parent.Layer.par.Pulserate
      - name: ColAr
        value: =parent.Mandala.par['Col%dr' % int(parent.Layer.par.Colora)]
      - name: ColAg
        value: =parent.Mandala.par['Col%dg' % int(parent.Layer.par.Colora)]
      - name: ColAb
        value: =parent.Mandala.par['Col%db' % int(parent.Layer.par.Colora)]
      - name: ColBr
        value: =parent.Mandala.par['Col%dr' % int(parent.Layer.par.Colorb)]
      - name: ColBg
        value: =parent.Mandala.par['Col%dg' % int(parent.Layer.par.Colorb)]
      - name: ColBb
        value: =parent.Mandala.par['Col%db' % int(parent.Layer.par.Colorb)]
      - name: ColLr
        value: =parent.Mandala.par['Col%dr' % max(1, int(parent.Layer.par.Linecolor))]
      - name: ColLg
        value: =parent.Mandala.par['Col%dg' % max(1, int(parent.Layer.par.Linecolor))]
      - name: ColLb
        value: =parent.Mandala.par['Col%db' % max(1, int(parent.Layer.par.Linecolor))]
      - name: Uselinecol
        value: =1 if parent.Layer.par.Linecolor > 0 else 0
      - name: Alternate
        value: =parent.Layer.par.Alternate.menuIndex
      - name: Opacity
        value: =parent.Layer.par.Opacity
      - name: Linewidth
        value: =parent.Layer.par.Linewidth
      - name: Wobble
        value: =parent.Layer.par.Wobble
      - name: Wobblescale
        value: =parent.Layer.par.Wobblescale
      - name: Seed
        value: =parent.Mandala.par.Seed + next((i for i, o in enumerate(parent.Mandala.op('merge_params').inputs) if o.path.startswith(parent.Layer.path)), 0)
      - name: Wave
        value: =parent.Layer.par.Wave
      - name: Waverate
        value: =parent.Layer.par.Waverate
      - name: Wavecycles
        value: =parent.Layer.par.Wavecycles
      - name: Colorwave
        value: =parent.Layer.par.Colorwave
      - name: Colorrate
        value: =parent.Layer.par.Colorrate
      - name: Tumble
        value: =parent.Layer.par.Tumble
      - name: Tumblerate
        value: =parent.Layer.par.Tumblerate
      - name: Nestspin
        value: =parent.Layer.par.Nestspin
      - name: Wobblerate
        value: =parent.Layer.par.Wobblerate
      - name: Radiusanim
        value: =parent.Layer.par.Radiusanim
      - name: Radiusrate
        value: =parent.Layer.par.Radiusrate
      - name: Amplitudeanim
        value: =parent.Layer.par.Amplitudeanim
      - name: Amplituderate
        value: =parent.Layer.par.Amplituderate
      - name: Sharpnessanim
        value: =parent.Layer.par.Sharpnessanim
      - name: Sharpnessrate
        value: =parent.Layer.par.Sharpnessrate
      - name: Lengthanim
        value: =parent.Layer.par.Lengthanim
      - name: Lengthrate
        value: =parent.Layer.par.Lengthrate
      - name: Widthanim
        value: =parent.Layer.par.Widthanim
      - name: Widthrate
        value: =parent.Layer.par.Widthrate
      - name: Nestgapanim
        value: =parent.Layer.par.Nestgapanim
      - name: Nestgaprate
        value: =parent.Layer.par.Nestgaprate
      - name: Linewidthanim
        value: =parent.Layer.par.Linewidthanim
      - name: Linewidthrate
        value: =parent.Layer.par.Linewidthrate
      - name: Opacityanim
        value: =parent.Layer.par.Opacityanim
      - name: Opacityrate
        value: =parent.Layer.par.Opacityrate
      - name: Ink
        value: =parent.Layer.par.Ink
      - name: Gap
        value: =parent.Layer.par.Gap
      - name: pad60
      - name: pad61
      - name: pad62
      - name: pad63
    position: [0, -600]
  - name: out_fill
    type: outPOP
    parameters:
      connectorder: 1
    position: [1600, -200]
    inputs:
    - copy_radial_f
  - name: out_line
    type: outPOP
    position: [1600, 200]
    inputs:
    - copy_radial
  - name: attr_fill
    type: attributePOP
    sequences:
      attr:
      - customname: LayerId
        type: int
        value0: =next((i for i, o in enumerate(parent.Mandala.op('merge_params').inputs) if o.path.startswith(parent.Layer.path)), 0)
      - customname: IsFill
        type: int
        value0: 1
    position: [400, -200]
    inputs:
    - circle_fill
  - name: attr_line
    type: attributePOP
    sequences:
      attr:
      - customname: LayerId
        type: int
        value0: =next((i for i, o in enumerate(parent.Mandala.op('merge_params').inputs) if o.path.startswith(parent.Layer.path)), 0)
      - customname: IsFill
        type: int
    position: [400, 200]
    inputs:
    - circle_line
  - name: copy_nest
    type: copyPOP
    parameters:
      ncy: =parent.Layer.par.Nest
      copyidname: NestId
    position: [800, 200]
    inputs:
    - attr_line
  - name: out_params
    type: outCHOP
    position: [400, -600]
    inputs:
    - params
  - name: circle_fill
    type: circlePOP
    parameters:
      connectivity: surface
    position: [0, -200]
  - name: circle_line
    type: circlePOP
    position: [0, 200]
  - name: copy_nest_f
    type: copyPOP
    parameters:
      ncy: =parent.Layer.par.Nest
      copyidname: NestId
    position: [800, -200]
    inputs:
    - attr_fill
  - name: copy_radial
    type: copyPOP
    parameters:
      ncy: =parent.Layer.par.Count
    position: [1200, 200]
    inputs:
    - copy_nest
  - name: copy_radial_f
    type: copyPOP
    parameters:
      ncy: =parent.Layer.par.Count
    position: [1200, -200]
    inputs:
    - copy_nest_f
  annotations:
  - name: annotate1
    mode: annotate
    title: 'Layer element: static copy chains + parameter channels'
    text: 'Top row: line strip chain -> out_line. Bottom row: filled fan chain -> out_fill. params CHOP = 64 channels bound to the Layer + Animate pages; the parent''s glsl_line / glsl_fill do all per-frame work.'
    position: [-70, -670]
    size: [1870, 1130]
    color: [0.55, 0.35, 0.25]
    opacity: 0.35
- name: glsl_fill
  type: glslPOP
  parameters:
    computedat: glsl_fill_compute
  sequences:
    attr:
    - name: color
      numcomps: '4'
    - name: linewidth
    vec:
    - name: uTime
      valuex: =(parent.Mandala.par.Manualtime if parent.Mandala.par.Timemode.eval() == 'manual' else absTime.seconds) * parent.Mandala.par.Speedmult
    - name: uEnergy
      valuex: =parent.Mandala.par.Energy
    - name: uGlobalRot
      valuex: =parent.Mandala.par.Rotate
    - name: uIsFill
      type: int
      valuex: 1
    - name: uLoop
      valuex: =parent.Mandala.par.Loop
    - name: uLoopLen
      valuex: =parent.Mandala.par.Looplength
    - name: uInkColor
      type: vec3
      valuex: =parent.Mandala.par['Col%dr' % int(parent.Mandala.par.Inkcolor)]
      valuey: =parent.Mandala.par['Col%dg' % int(parent.Mandala.par.Inkcolor)]
      valuez: =parent.Mandala.par['Col%db' % int(parent.Mandala.par.Inkcolor)]
    - name: uInkWidth
      valuex: =parent.Mandala.par.Inkwidth
    array:
    - name: uP
      chop: /specimen_lab/mandala/shuffle_params
      arraytype: texturebuffer
  position: [1000, -1800]
  inputs:
  - merge_fill
- name: glsl_line
  type: glslPOP
  parameters:
    computedat: glsl_line_compute
  sequences:
    attr:
    - name: color
      numcomps: '4'
    - name: linewidth
    vec:
    - name: uTime
      valuex: =(parent.Mandala.par.Manualtime if parent.Mandala.par.Timemode.eval() == 'manual' else absTime.seconds) * parent.Mandala.par.Speedmult
    - name: uEnergy
      valuex: =parent.Mandala.par.Energy
    - name: uGlobalRot
      valuex: =parent.Mandala.par.Rotate
    - name: uIsFill
      type: int
      valuex: 0
    - name: uLoop
      valuex: =parent.Mandala.par.Loop
    - name: uLoopLen
      valuex: =parent.Mandala.par.Looplength
    - name: uInkColor
      type: vec3
      valuex: =parent.Mandala.par['Col%dr' % int(parent.Mandala.par.Inkcolor)]
      valuey: =parent.Mandala.par['Col%dg' % int(parent.Mandala.par.Inkcolor)]
      valuez: =parent.Mandala.par['Col%db' % int(parent.Mandala.par.Inkcolor)]
    - name: uInkWidth
      valuex: =parent.Mandala.par.Inkwidth
    array:
    - name: uP
      chop: /specimen_lab/mandala/shuffle_params
      arraytype: texturebuffer
  flags:
  - viewer
  position: [1000, -1200]
  inputs:
  - merge_line
- name: glsl_wear
  type: glslTOP
  parameters:
    pixeldat: glsl_wear_pixel
    computedat: glsl_wear_compute
  sequences:
    vec:
    - name: uGrunge
      valuex: =parent.Mandala.par.Grunge
    - name: uFade
      valuex: =parent.Mandala.par.Fade
    - name: uPaper
      valuex: =parent.Mandala.par.Paperr
      valuey: =parent.Mandala.par.Paperg
      valuez: =parent.Mandala.par.Paperb
    - name: uCoverage
      valuex: =parent.Mandala.par.Coverage
    - name: uVignette
      valuex: =parent.Mandala.par.Vignette
    - name: uGrain
      valuex: =parent.Mandala.par.Grain
    - name: uTime
      valuex: =((parent.Mandala.par.Manualtime if parent.Mandala.par.Timemode.eval() == 'manual' else absTime.seconds) if parent.Mandala.par.Grain > 0 else 0)
    - name: uSparkle
      valuex: =parent.Mandala.par.Sparkle
    - name: uSparkleClump
      valuex: =parent.Mandala.par.Sparkleclump
    - name: uSparkleRate
      valuex: =parent.Mandala.par.Sparklerate
    - name: uLoop
      valuex: =parent.Mandala.par.Loop
    - name: uLoopLen
      valuex: =parent.Mandala.par.Looplength / max(parent.Mandala.par.Speedmult, 1e-6)
    - name: uSeed
      valuex: =parent.Mandala.par.Seed
    - name: uGrungeBase
      valuex: =parent.Mandala.par.Grungebase
    - name: uRes
      valuex: =parent.Mandala.par.Resolution
  position: [3400, -1400]
  inputs:
  - hsv_age
  - noise_fiber
  - noise_patch
- name: tick_ring
  type: baseCOMP
  custom_pars:
    Layer:
      $t: layer
