- name: glsl_scroll
  type: glslTOP
  parameters:
    pixeldat: glsl_scroll_pixel
    computedat: glsl_scroll_compute
    outputresolution: custom
    resolutionw: =parent.Mandala.par.Resolution
    resolutionh: =parent.Mandala.par.Resolution
  sequences:
    vec:
    - name: uTime
      valuex: =(parent.Mandala.par.Manualtime if parent.Mandala.par.Timemode.eval() == 'manual' else absTime.seconds)
    - name: uLoop
      valuex: =parent.Mandala.par.Loop
    - name: uLoopLen
      valuex: =parent.Mandala.par.Looplength / max(parent.Mandala.par.Speedmult, 1e-6)
    - name: uSeed
      valuex: =parent.Mandala.par.Seed
    - name: uAmount
      valuex: =parent.Mandala.par.Scrollwork
    - name: uScale
      valuex: =parent.Mandala.par.Scrollscale
    - name: uWarp
      valuex: =parent.Mandala.par.Scrollwarp
    - name: uDensity
      valuex: =parent.Mandala.par.Scrolldensity
    - name: uLeaves
      valuex: =parent.Mandala.par.Scrollleaves
    - name: uInner
      valuex: =parent.Mandala.par.Scrollinner
    - name: uOuter
      valuex: =parent.Mandala.par.Scrollouter
    - name: uFlow
      valuex: =parent.Mandala.par.Scrollflow
    - name: uEvolve
      valuex: =parent.Mandala.par.Scrollevolve
    - name: uSymmetry
      valuex: =parent.Mandala.par.Scrollsymmetry
    - name: uLineColor
      valuex: =parent.Mandala.par['Col%dr' % int(parent.Mandala.par.Scrolllinecolor)]
      valuey: =parent.Mandala.par['Col%dg' % int(parent.Mandala.par.Scrolllinecolor)]
      valuez: =parent.Mandala.par['Col%db' % int(parent.Mandala.par.Scrolllinecolor)]
    - name: uLeafColor
      valuex: =parent.Mandala.par['Col%dr' % int(parent.Mandala.par.Scrollleafcolor)]
      valuey: =parent.Mandala.par['Col%dg' % int(parent.Mandala.par.Scrollleafcolor)]
      valuez: =parent.Mandala.par['Col%db' % int(parent.Mandala.par.Scrollleafcolor)]
    - name: uInkColor
      valuex: =parent.Mandala.par['Col%dr' % int(parent.Mandala.par.Inkcolor)]
      valuey: =parent.Mandala.par['Col%dg' % int(parent.Mandala.par.Inkcolor)]
      valuez: =parent.Mandala.par['Col%db' % int(parent.Mandala.par.Inkcolor)]
    - name: uDetail
      valuex: =parent.Mandala.par.Scrolldetail
    - name: uRes
      valuex: =parent.Mandala.par.Resolution
    - name: uMorph
      valuex: =parent.Mandala.par.Scrollmorph.eval()
    - name: uMorphRate
      valuex: =parent.Mandala.par.Scrollmorphrate.eval()
  position: [2200, -2500]
