        value: =parent.Layer.par.Linewidthrate
      - name: Opacityanim
        value: =parent.Layer.par.Opacityanim
      - name: Opacityrate
        value: =parent.Layer.par.Opacityrate
      - name: Ink
        value: =parent.Layer.par.Ink
      - name: Gap
        value: =parent.Layer.par.Gap
      - name: pad60
      - name: pad61
      - name: pad62
      - name: pad63
    position: [0, -600]
  - name: out_fill
    type: outPOP
    parameters:
      connectorder: 1
    position: [1600, -200]
    inputs:
    - copy_radial_f
  - name: out_line
    type: outPOP
    position: [1600, 200]
    inputs:
    - copy_radial
  - name: attr_fill
    type: attributePOP
    sequences:
      attr:
      - customname: LayerId
        type: int
        value0: =next((i for i, o in enumerate(parent.Mandala.op('merge_params').inputs) if o.path.startswith(parent.Layer.path)), 0)
      - customname: IsFill
        type: int
        value0: 1
    position: [400, -200]
    inputs:
    - circle_fill
  - name: attr_line
    type: attributePOP
    sequences:
      attr:
      - customname: LayerId
        type: int
        value0: =next((i for i, o in enumerate(parent.Mandala.op('merge_params').inputs) if o.path.startswith(parent.Layer.path)), 0)
      - customname: IsFill
        type: int
    position: [400, 200]
    inputs:
    - circle_line
  - name: copy_nest
    type: copyPOP
    parameters:
      ncy: =parent.Layer.par.Nest
      copyidname: NestId
    position: [800, 200]
    inputs:
    - attr_line
  - name: out_params
    type: outCHOP
    position: [400, -600]
    inputs:
    - params
  - name: circle_fill
    type: circlePOP
    parameters:
      connectivity: surface
    position: [0, -200]
  - name: circle_line
    type: circlePOP
    position: [0, 200]
  - name: copy_nest_f
    type: copyPOP
    parameters:
      ncy: =parent.Layer.par.Nest
      copyidname: NestId
    position: [800, -200]
    inputs:
    - attr_fill
  - name: copy_radial
    type: copyPOP
    parameters:
      ncy: =parent.Layer.par.Count
    position: [1200, 200]
    inputs:
    - copy_nest
  - name: copy_radial_f
    type: copyPOP
    parameters:
      ncy: =parent.Layer.par.Count
    position: [1200, -200]
    inputs:
    - copy_nest_f
  annotations:
  - name: annotate1
    mode: annotate
    title: 'Layer element: static copy chains + parameter channels'
    text: 'Top row: line strip chain -> out_line. Bottom row: filled fan chain -> out_fill. params CHOP = 64 channels bound to the Layer + Animate pages; the parent''s glsl_line / glsl_fill do all per-frame work.'
    position: [-70, -670]
    size: [1870, 1130]
    color: [0.55, 0.35, 0.25]
    opacity: 0.35
