- name: glsl_wear_pixel
  type: textDAT
  parameters:
    extension: frag
  flags:
  - viewer
  position: [3400, -1520]
  dock: glsl_wear
  dat_content: "// Worn-thangka finish: patchy fade toward paper, paper-fibre grunge inside the patches,\n// a soft vignette, animated grain, and sparse shimmering specks of light.\n// Inputs: 0 = image, 1 = fiber noise, 2 = patch noise.\n// Uniform values come from the Vectors page (GLSL TOP uniforms must be declared here).\n\nuniform float uGrunge;\nuniform float uFade;\nuniform vec3 uPaper;\nuniform float uCoverage;\nuniform float uVignette;\nuniform float uGrain;\nuniform float uTime;\nuniform float uSparkle;\nuniform float uSparkleClump;\nuniform float uSparkleRate;\nuniform float uLoop;\nuniform float uLoopLen;\nuniform float uSeed;\nuniform float uGrungeBase;\nuniform float uRes;\n\nout vec4 fragColor;\n\n#define TAU 6.28318530718\n\nfloat hash21(vec2 p) {\n\tp = fract(p * vec2(123.34, 456.21));\n\tp += dot(p, p + 45.32);\n\treturn fract(p.x * p.y);\n}\n\nvoid main() {\n\tvec2 uv = vUV.st;\n\tvec4 img = texture(sTD2DInputs[0], uv);\n\tfloat fiber = texture(sTD2DInputs[1], uv).r;\n\tfloat patchNoise = texture(sTD2DInputs[2], uv).r;\n\n\t// patchy coverage: threshold the low-frequency noise softly ('patch' is a GLSL keyword)\n\tfloat edge = 0.24;\n\tfloat m = smoothstep(1.0 - uCoverage - edge, 1.0 - uCoverage + edge, patchNoise);\n\tfloat wear = m * (0.35 + 0.65 * fiber);\n\n\tvec3 c = img.rgb;\n\tc = mix(c, uPaper, clamp(uFade * wear, 0.0, 1.0));\n\tc *= 1.0 + uGrunge * m * (fiber - 0.5) * 1.3;\n\tc *= 1.0 + uGrungeBase * (fiber - 0.5) * 1.3;       // faint fibre over everything, mandala included\n\n\tvec2 d = uv - 0.5;\n\tfloat r = length(d) * 1.41421356;\n\tc *= 1.0 - uVignette * smoothstep(0.5, 1.05, r);\n\n\tfloat g = fract(sin(dot(uv * 1417.0 + vec2(uTime * 13.7, uTime * 7.1), vec2(12.9898, 78.233))) * 43758.5453);\n\tc += (g - 0.5) * uGrain;\n\n\t// sparkles: specks on a 3px lattice that re-roll their spot every shimmer cycle (each cell has its\n\t// own phase, so they come and go at different moments), fading in and out so nothing pops; the\n\t// hot regions that clump them drift every few cycles. In Loop mode the cycle count is a whole\n\t// number per loop, so the same specks return at the seam.\n\tif (uSparkle > 0.0) {\n\t\tfloat ps = max(uRes / 1080.0, 0.25);        // speck lattice and size authored at 1080, scale with Resolution\n\t\tfloat cs = 3.0 * ps;\n\t\tvec2 px = uv * uTD2DInfos[0].res.zw;\n\t\tvec2 cell = floor(px / cs);\n\t\tvec2 coarse = floor(px / (64.0 * ps));\n\t\tfloat rate = uSparkleRate;\n\t\tfloat cycles = 1.0e9;\n\t\tif (uLoop > 0.5 && rate > 0.0) {\n\t\t\tcycles = max(1.0, floor(rate * uLoopLen / TAU + 0.5));\n\t\t\trate = cycles * TAU / uLoopLen;\n\t\t}\n\t\tfloat phase = hash21(cell + 3.3 + uSeed);\n\t\tfloat tcyc = uTime * rate / TAU + phase;\n\t\tfloat e = floor(tcyc);\n\t\tif (uLoop > 0.5) e = mod(e, cycles);\n\t\tfloat hot = pow(hash21(coarse + uSeed * 0.37 + floor(e / 3.0) * 11.0), 4.0) * 8.0;\n\t\tfloat dens = uSparkle * 9.0 * mix(1.0, hot, uSparkleClump);\n\t\tfloat h = hash21(cell + uSeed * 3.1 + e * 17.0);\n\t\tif (h < dens) {\n\t\t\tvec2 jitter = (vec2(hash21(cell + 7.7 + e), hash21(cell + 9.1 + e)) - 0.5) * 1.5;\n\t\t\tvec2 centre = (cell + 0.5 + jitter) * cs;\n\t\t\tfloat dist = length(px - centre);\n\t\t\tfloat size = (1.7 + 1.6 * hash21(cell + 5.5 + e)) * ps;\n\t\t\tfloat bright = 0.9 + 0.7 * hash21(cell + 2.2 + e);\n\t\t\tfloat tw = 0.5 - 0.5 * cos(TAU * fract(tcyc));\n\t\t\tfloat s = smoothstep(size, 0.15, dist) * tw;\n\t\t\t// composited OVER the colour (not added) so specks read on the mandala's reds and greens too\n\t\t\tc = mix(c, vec3(1.0, 0.97, 0.88) * bright, clamp(s, 0.0, 1.0));\n\t\t}\n\t}\n\n\tfragColor = TDOutputSwizzle(vec4(c, 1.0));\n}\n"
  dat_content_format: text
