format: tdxn
version: '2.1'
build: 1
generator: Embody/6.2.53
td_build: 099.2025.33230
network_path: /specimen_lab/prismatic_strata
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  glslTOP:
    parameters:
      format: rgba16float
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  infoDAT:
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  renderselectTOP:
    parameters:
      format: rgba16float
      top: glsl_strata
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textDAT:
    parameters:
      language: glsl
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
type: baseCOMP
custom_pars:
  Strata:
  - name: Scale
    style: Float
    label: Noise Scale
    startSection: true
    default: 1.2
    min: 0.3
    max: 4.0
    clampMin: true
    clampMax: true
    normMin: 0.3
    normMax: 4.0
    help: Noise features per frame height. Low = a few broad folds; high = many small strata.
  - name: Stretch
    style: Float
    default: 4
    min: 1.0
    max: 6.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 6.0
    help: Horizontal elongation of the noise. 1 = round blobs; 2.5+ = wide horizontal layers.
  - name: Bands
    style: Float
    default: 2
    min: 0.5
    max: 5.0
    clampMin: true
    clampMax: true
    normMin: 0.5
    normMax: 5.0
    help: How many strata (ramp cycles) span the frame height before displacement folds add more.
  - name: Displace
    style: Float
    default: 1.1
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: How far the noise displaces the ramp, in strata. Past ~1 the layers fold over into extra rims.
  - name: Warp
    style: Float
    default: 0.45
    max: 2.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: 'Domain warp: a low-frequency noise bends the sample coordinates so the layers curl instead of waving.'
  - name: Detail
    style: Int
    default: 5
    min: 1.0
    max: 6.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 6.0
    help: fBm octaves. More = finer veins on the layers; costs one noise evaluation each.
  - name: Relief
    style: Float
    default: 0.06
    clampMin: true
    clampMax: true
    help: 'Slope shading from above: compressed layers brighten, overhangs darken. 0 = flat ramp only.'
  - name: Edgesoft
    style: Float
    label: Edge Softness
    default: 0.1
    max: 0.2
    clampMin: true
    clampMax: true
    normMax: 0.2
    help: Width of the rim edge as a fraction of one stratum. 0 = hard cliff.
  - name: Layers
    style: Float
    label: Fine Layers
    default: 5
    max: 40.0
    clampMin: true
    clampMax: true
    normMax: 40.0
    help: 'Fine contour lines per stratum: thin sediment layers that follow every fold of the displaced ramp. 0 = none.'
  - name: Layergain
    style: Float
    label: Layer Gain
    default: 0.14
    clampMin: true
    clampMax: true
    help: Brightness of the fine layers. They read warm in the shadows and pale in the lit zones.
  - name: Grain
    style: Float
    label: Fine Grain
    default: 0.12
    max: 0.5
    clampMin: true
    clampMax: true
    normMax: 0.5
    help: Fine-scale fibrous noise on the layers (the small end of the scale stack).
  Motion:
  - name: Loopseconds
    style: Float
    label: Loop Seconds
    startSection: true
    default: 1.2
    min: 0.5
    max: 20.0
    clampMin: true
    clampMax: true
    normMin: 0.5
    normMax: 20.0
    help: Length of one seamless loop in seconds. The noise travels a closed circle, so the last frame meets the first.
  - name: Scroll
    style: Float
    default: 1
    min: -4.0
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Soft pulses that roll DOWN the frame per loop (the ripple). Keep it an integer for a seamless loop. The rims stay put; only the light wave moves.
  - name: Pulses
    style: Float
    label: Pulse Bands
    default: 1.5
    min: 0.25
    max: 4.0
    clampMin: true
    clampMax: true
    normMin: 0.25
    normMax: 4.0
    help: How many soft brightness pulses span the frame height. They are the smooth, large-scale wave that rolls down through the layers.
  - name: Pulsegain
    style: Float
    label: Pulse Gain
    default: 0.7
    max: 1.5
    clampMin: true
    clampMax: true
    normMax: 1.5
    help: Depth of the rolling pulses. 0 = the layers only morph; the rims themselves never move with the pulses.
  - name: Evolution
    style: Float
    default: 0.14
    max: 2.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: 'Radius of that circle in noise units: how much the layers morph within one loop. 0 = frozen.'
  - name: Seed
    style: Float
    max: 100.0
    clampMin: true
    clampMax: true
    normMax: 100.0
    help: Offsets the noise field. Any value gives a different arrangement of layers.
  Look:
  - name: Flow
    style: Float
    startSection: true
    default: 0.06
    max: 0.3
    clampMin: true
    clampMax: true
    normMax: 0.2
    help: Base displacement of the finished strata by the stratum-scale flow field, as a fraction of the frame height. The whole image swirls with it; Dispersion splits the channels around it.
  - name: Dispersion
    style: Float
    default: 0.12
    max: 1.5
    clampMin: true
    clampMax: true
    help: 'Per-channel share of Flow: red takes 1-d of it, green 1, blue 1+d. 0 = neutral grey warp; 0.45 = orange/azure fringes and stratum-sized warm or cool patches.'
  - name: Tint
    style: Float
    default: 0.9
    max: 1.5
    clampMin: true
    clampMax: true
    normMax: 1.5
    help: 'Regional warm/cool tint: a stratum-scale field pushes mids and shadows toward rust or steel blue. 0 = neutral.'
  - name: Iridescence
    style: Float
    default: 0.12
    max: 0.5
    clampMin: true
    clampMax: true
    normMax: 0.5
    help: 'Thin-film hue cycle along the layer coordinate: pastel pink / yellow / cyan bands that follow the folds. 0 = none.'
  - name: Cellscale
    style: Float
    label: Caustic Cells
    default: 18
    min: 4.0
    max: 60.0
    clampMin: true
    clampMax: true
    normMin: 4.0
    normMax: 60.0
    help: Caustic web cell count per frame height.
  - name: Cellwidth
    style: Float
    label: Caustic Width
    default: 0.05
    min: 0.01
    max: 0.4
    clampMin: true
    clampMax: true
    normMin: 0.01
    normMax: 0.4
    help: Thickness of the caustic veins (0..1 of a cell).
  - name: Causticgain
    style: Float
    label: Caustic Gain
    default: 0.5
    max: 2.0
    clampMin: true
    clampMax: true
    normMax: 2.0
    help: Brightness added along the caustic veins. 0 = no web.
  - name: Streaklength
    style: Float
    label: Streak Length
    startSection: true
    default: 0.35
    max: 0.6
    clampMin: true
    clampMax: true
    normMax: 0.6
    help: Half-length of the vertical light streaks, as a fraction of the frame height.
  - name: Streakgain
    style: Float
    label: Streak Gain
    default: 0.9
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Brightness of the streaks. 0 = none.
  - name: Streakthreshold
    style: Float
    label: Streak Threshold
    default: 0.12
    max: 0.5
    clampMin: true
    clampMax: true
    normMax: 0.5
    help: Only thin features brighter than their surroundings by this much seed a streak.
  - name: Glow
    style: Float
    startSection: true
    default: 0.22
    max: 1.5
    clampMin: true
    clampMax: true
    normMax: 1.5
    help: A broad drifting light field that lifts regions toward white (the backlit fog).
  - name: Bloom
    style: Float
    default: 0.25
    max: 3.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: Bloom TOP intensity on the final image.
  Output:
  - name: Resw
    style: Int
    label: Width
    startSection: true
    default: 1920
    min: 256.0
    max: 7680.0
    clampMin: true
    clampMax: true
    normMin: 256.0
    normMax: 7680.0
    help: Render width (px). Drives every resolution-bearing op in this specimen.
  - name: Resh
    style: Int
    label: Height
    default: 1080
    min: 256.0
    max: 7680.0
    clampMin: true
    clampMax: true
    normMin: 256.0
    normMax: 7680.0
    help: Render height (px).
parameters:
  parentshortcut: Specimen
color: [0.3, 0.5, 0.9]
tags:
- tdxn
operators:
- name: out1
  type: outTOP
  parameters:
    label: =me.name
  flags:
  - display
  position: [5400, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - bloom
- name: bloom
  type: bloomTOP
  parameters:
    preblacklevel: 0.8
    minbloomradius: 0.15
    maxbloomradius: 0.8
    bloomthreshold: 0
    bloomintensity: =parent.Specimen.par.Bloom.eval()
  position: [5000, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - glsl_streaks
- name: glsl_prism
  type: glslTOP
  parameters:
    pixeldat: glsl_prism_pixel
    computedat: glsl_prism_compute
    inputextenduv: mirror
    premultrgbbyalpha: false
  sequences:
    vec:
    - name: uPrism
      valuex: =parent.Specimen.par.Flow.eval()
      valuey: =parent.Specimen.par.Dispersion.eval()
      valuez: =parent.Specimen.par.Streakthreshold.eval()
    - name: uDetail
      valuex: =parent.Specimen.par.Causticgain.eval()
      valuey: =parent.Specimen.par.Layergain.eval()
      valuez: 0
      valuew: 0
  position: [2800, 0]
  inputs:
  - glsl_strata
  - renderselect_disp
- name: glsl_strata
  type: glslTOP
  parameters:
    pixeldat: glsl_strata_pixel
    computedat: glsl_strata_compute
    inputextenduv: hold
    numcolorbufs: 3
    outputresolution: custom
    resolutionw: =parent.Specimen.par.Resw.eval()
    resolutionh: =parent.Specimen.par.Resh.eval()
  sequences:
    vec:
    - name: uField
      valuex: =parent.Specimen.par.Scale.eval()
      valuey: =parent.Specimen.par.Stretch.eval()
      valuez: =parent.Specimen.par.Warp.eval()
      valuew: =parent.Specimen.par.Detail.eval()
    - name: uStrata
      valuex: =parent.Specimen.par.Bands.eval()
      valuey: =parent.Specimen.par.Displace.eval()
      valuez: =parent.Specimen.par.Relief.eval()
      valuew: =parent.Specimen.par.Edgesoft.eval()
    - name: uTime
      valuex: =(absTime.seconds % parent.Specimen.par.Loopseconds.eval()) / parent.Specimen.par.Loopseconds.eval()
      valuey: =parent.Specimen.par.Evolution.eval()
      valuez: =parent.Specimen.par.Seed.eval()
      valuew: =parent.Specimen.par.Glow.eval()
    - name: uCaustic
      valuex: =parent.Specimen.par.Cellscale.eval()
      valuey: =parent.Specimen.par.Cellwidth.eval()
      valuez: =parent.Specimen.par.Tint.eval()
      valuew: =parent.Specimen.par.Iridescence.eval()
    - name: uLayers
      valuex: =parent.Specimen.par.Layers.eval()
      valuey: =parent.Specimen.par.Scroll.eval()
      valuez: =parent.Specimen.par.Grain.eval()
      valuew: 0
    - name: uPulse
      valuex: =parent.Specimen.par.Pulses.eval()
      valuey: =parent.Specimen.par.Pulsegain.eval()
      valuez: 0
      valuew: 0
  flags:
  - viewer
  position: [1400, 0]
  inputs:
  - ramp_strata
- name: ramp_strata
  type: rampTOP
  parameters:
    dat: ramp_strata_keys
    color1: 0.400000006
    color2: 0.2700000107
    color3: 0.200000003
    extendleft: hold
    outputresolution: custom
    resolutionw: 512
    resolutionh: 4
    format: rgba16float
  position: [400, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: glsl_streaks
  type: glslTOP
  parameters:
    pixeldat: glsl_streaks_pixel
    computedat: glsl_streaks_compute
    inputextenduv: mirror
  sequences:
    vec:
    - name: uStreak
      valuex: =parent.Specimen.par.Streaklength.eval()
      valuey: =parent.Specimen.par.Streakgain.eval()
  position: [4000, 0]
  inputs:
  - glsl_prism
  - renderselect_grad
- name: glsl_prism_info
  type: infoDAT
  parameters:
    op: glsl_prism
  position: [2950, -120]
  dock: glsl_prism
  dat_read_only: true
- name: glsl_prism_pixel
  type: textDAT
  parameters:
    extension: frag
  flags:
  - viewer
  position: [2800, -120]
  dock: glsl_prism
  dat_content: |
    // glsl_prism -- the rainbow. A Displace TOP run three times: a smooth base displacement field
    // (Flow) warps the whole soft image, and each channel takes a different share of it (Dispersion):
    // red 1-d, green 1, blue 1+d. Where the field is strong, red and blue land tens of pixels apart,
    // so every gradient picks up a regional warm or cool tint and every edge comes apart into
    // orange / azure fringes; where the field is weak the channels line up and the image stays neutral.
    // The detail (caustic web, fine layers) is composited AFTER the split, sampled at the green
    // position so it stays glued to the layers -- crisp lines that were split would leave green and
    // magenta copies the reference never shows.
    // Input 0 = soft strata (glsl_strata buffer 0). Input 1 = field (buffer 1 via renderselect_disp):
    // xy = flow vector encoded 0.5 + 0.5 * w, z = web mask, w = fine layers.
    // Alpha out = streak seeds for glsl_streaks: thin bright vertical features (a horizontal high-pass
    // of the base and of the web, weighted toward bright pixels, dilated a few px along y so the streak
    // pass cannot step over one, gated per column so the streaks cluster).
    uniform vec4 uPrism;    // x = Flow (base displacement, fraction of frame height)  y = Dispersion (per-channel share)  z = Streakthreshold  w unused
    uniform vec4 uDetail;   // x = Causticgain  y = Layergain  z,w unused
    out vec4 fragColor;

    float lum(vec3 c){ return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
    float lumAt(vec2 uv){ return lum(texture(sTD2DInputs[0], uv).rgb); }
    float webAt(vec2 uv){ return texture(sTD2DInputs[1], uv).z; }

    float seedAt(vec2 uv, vec2 px){
        vec2 dx = vec2(3.0 * px.x, 0.0);
        float c = lumAt(uv);
        float hpBase = c - 0.5 * (lumAt(uv - dx) + lumAt(uv + dx));
        float hpWeb  = webAt(uv) - 0.5 * (webAt(uv - dx) + webAt(uv + dx));
        float hp = max(hpBase, 0.5 * hpWeb);
        return smoothstep(uPrism.z, uPrism.z + 0.12, hp) * smoothstep(0.45, 0.9, c);
    }

    void main(){
        vec2 uv  = vUV.st;
        vec2 res = uTD2DInfos[0].res.zw;                          // width, height
        vec2 px  = uTD2DInfos[0].res.xy;                          // 1/width, 1/height
        vec2 w   = texture(sTD2DInputs[1], uv).xy * 2.0 - 1.0;    // decode -1..1
        vec2 d   = uPrism.x * w * vec2(res.y / res.x, 1.0);       // height-relative -> uv (x shrinks by aspect)
        float share = uPrism.y;
        float r = texture(sTD2DInputs[0], uv + d * (1.0 - share)).r;
        float g = texture(sTD2DInputs[0], uv + d).g;
        float b = texture(sTD2DInputs[0], uv + d * (1.0 + share)).b;
        vec3 col = vec3(r, g, b);
        float L = lum(col);

        // detail rides with the green channel
        vec4 f = texture(sTD2DInputs[1], uv + d);
        float fine = f.w;
        col *= 1.0 + uDetail.y * (fine - 0.3) * mix(vec3(1.1, 0.95, 0.85), vec3(1.0), smoothstep(0.1, 0.6, L));
        float web = f.z;
        col += web * uDetail.x * mix(0.8, 0.02, smoothstep(0.15, 0.8, L)) * vec3(1.0, 0.75, 0.55) * (0.5 + col);

        float seed = 0.0;
        for(int j = -2; j <= 2; j++){
            seed = max(seed, seedAt(uv + d + vec2(0.0, float(j) * 2.0 * px.y), px));
        }
        float colBin = floor(uv.x * res.x / 3.0);
        float gate = fract(sin(colBin * 12.9898) * 43758.5453);
        seed *= smoothstep(0.62, 0.85, gate);

        fragColor = TDOutputSwizzle(vec4(col, seed));
    }
  dat_content_format: text
- name: glsl_strata_info
  type: infoDAT
  parameters:
    op: glsl_strata
  position: [1550, -120]
  dock: glsl_strata
  dat_read_only: true
- name: ramp_strata_keys
  type: tableDAT
  flags:
  - viewer
  - -showDocked
  position: [400, -120]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dock: ramp_strata
  dat_content:
  - - pos
    - r
    - g
    - b
    - a
  - - '0'
    - '0.93'
    - '0.85'
    - '0.75'
    - '1'
  - - '0.03'
    - '0.82'
    - '0.81'
    - '0.80'
    - '1'
  - - '0.10'
    - '0.72'
    - '0.72'
    - '0.73'
    - '1'
  - - '0.30'
    - '0.60'
    - '0.60'
    - '0.62'
    - '1'
  - - '0.55'
    - '0.46'
    - '0.46'
    - '0.48'
    - '1'
  - - '0.72'
    - '0.30'
    - '0.30'
    - '0.32'
    - '1'
  - - '0.82'
    - '0.14'
    - '0.13'
    - '0.14'
    - '1'
  - - '0.90'
    - '0.08'
    - '0.07'
    - '0.08'
    - '1'
  - - '0.95'
    - '0.17'
    - '0.11'
    - '0.09'
    - '1'
  - - '1'
    - '0.40'
    - '0.27'
    - '0.20'
    - '1'
  dat_content_format: table
- name: glsl_strata_pixel
  type: textDAT
  parameters:
    extension: frag
  flags:
  - viewer
  position: [1400, -120]
  dock: glsl_strata
  dat_content: |
    // glsl_strata -- the layered field, built as a stack of scales:
    //   coarse : soft brightness PULSES (a cosine wave bent by very low-frequency noise) that roll down
    //            the frame once per loop -- the ripple. Smooth and wide, never hard-edged.
    //   mid    : the STRATA -- a vertical ramp cycling Bands times per frame height, displaced by
    //            domain-warped fBm; fract() of that is the stratum phase, which indexes the 1D color
    //            ramp on input 0. The rims are jagged silhouettes that only morph slowly (Evolution).
    //   fine   : contour layers that follow every fold, a caustic web, and fibrous grain.
    // Output 0 = the SOFT strata (ramp + relief + light + pulses + color) -- what glsl_prism splits per channel.
    // Output 1 = detail composited back after the split: xy = flow field (encoded 0.5+0.5*w),
    // z = caustic web mask, w = fine contour layers.
    // Output 2 = the streak direction field: the local "up" through the layers (gradient of the
    // displaced ramp coordinate, encoded 0.5+0.5*dir), so glsl_streaks can bend its rays with the folds.
    uniform vec4 uField;    // x=Scale (noise cycles / frame height)  y=Stretch (horizontal elongation)  z=Warp  w=Detail (octaves)
    uniform vec4 uStrata;   // x=Bands (strata / frame height)  y=Displace (ramp displacement, in strata)  z=Relief  w=Edgesoft
    uniform vec4 uTime;     // x=loop phase 0..1  y=Evolution (loop circle radius)  z=Seed  w=Glow
    uniform vec4 uCaustic;  // x=Cellscale (cells / frame height)  y=Cellwidth  z=Tint  w=Iridescence
    uniform vec4 uLayers;   // x=Layers (fine contour lines per stratum)  y=Scroll (pulses per loop)  z=Grain  w unused
    uniform vec4 uPulse;    // x=Pulses (pulse bands / frame height)  y=Pulsegain  z,w unused

    layout(location = 0) out vec4 fragColor;
    layout(location = 1) out vec4 fragField;
    layout(location = 2) out vec4 fragDir;

    const float TAU = 6.28318530718;

    // One swap point for the noise. TD's built-in 4D simplex: xy = space, zw = a point on a circle
    // that the loop phase walks around, so every frame of the loop is a fresh field and frame N meets frame 0.
    float n4(vec4 v){ return TDSimplexNoise(v); }

    // Anisotropy fades with the octave: the broad shapes are long horizontal ridges (stretched by
    // `stretch`), the fine octaves are isotropic, so every rim is a jagged mountain profile.
    float fbm(vec2 q, vec2 zw, int oct, float stretch){
        float sum = 0.0, amp = 0.5, norm = 0.0;
        float sx = 1.0 / stretch;
        for(int i = 0; i < 6; i++){
            if(i >= oct) break;
            sum  += amp * n4(vec4(q.x * sx, q.y, zw));
            norm += amp;
            q *= 2.03; zw *= 1.15; amp *= 0.5;    // zw grows slowly: fine detail must not flicker
            sx = min(1.0, sx * 1.8);
        }
        return sum / norm;   // ~[-1, 1]
    }

    vec2 hash22(vec2 p){
        vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
        p3 += dot(p3, p3.yzx + 33.33);
        return fract((p3.xx + p3.yz) * p3.zy);
    }

    // Worley cells whose feature points orbit with the loop phase (periodic -> seamless). Returns (F1, F2).
    vec2 worley(vec2 x, float phase){
        vec2 n = floor(x), f = fract(x);
        float f1 = 8.0, f2 = 8.0;
        for(int j = -1; j <= 1; j++){
            for(int i = -1; i <= 1; i++){
                vec2 g = vec2(float(i), float(j));
                vec2 o = 0.5 + 0.4 * sin(TAU * (hash22(n + g) + phase));
                vec2 r = g + o - f;
                float d = dot(r, r);
                if(d < f1){ f2 = f1; f1 = d; }
                else if(d < f2){ f2 = d; }
            }
        }
        return sqrt(vec2(f1, f2));
    }

    void main(){
        vec2 res = uTDOutputInfo.res.zw;                  // output res: zw = width, height
        float aspect = res.x / res.y;
        vec2 uv = vUV.st;
        vec2 p = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);  // frame height = 1 unit, y up

        float scale   = max(0.05, uField.x);
        float stretch = max(0.2, uField.y);
        float warp    = uField.z;
        int   oct     = int(clamp(uField.w, 1.0, 6.0));

        float phase = uTime.x;
        vec2  loop  = uTime.y * vec2(cos(TAU * phase), sin(TAU * phase)) + uTime.z;
        float drift = uLayers.y * phase;                   // the pulses' downward travel, in pulse bands

        vec2 q = p * scale;

        // Low-frequency warp vector: bends the layers into folds.
        vec2 w = vec2(n4(vec4(q * 0.5 + 7.3, loop)),
                      n4(vec4(q * 0.5 - 3.1, loop + 5.0)));
        vec2 qw = q + warp * w;

        // Stratum-scale flow field for the prism pass: regions the size of a layer get displaced.
        // STATIC in time on purpose -- a fixed curved-space lens the layers scroll and morph through;
        // an evolving field made the whole image swim. (simplex sits mostly within +-0.5, so it is
        // doubled: the field reaches full strength in patches.)
        vec2 wd = clamp(2.0 * vec2(n4(vec4(q * 1.8 + 19.0, uTime.z + 3.7, -2.1)),
                                   n4(vec4(q * 1.8 - 14.0, uTime.z - 6.3, 4.4))), -1.0, 1.0);

        // ---- mid scale: the strata ----
        float n = fbm(qw, loop + 11.0, oct, stretch);
        float v = uv.y * uStrata.x + uStrata.y * n;        // the displaced ramp coordinate (the rims do not scroll)
        float s = fract(v);                                // s = 0 just above a rim (lit top), s = 1 just below (shadow)

        // Soften the cliff: blend the shadow end of the ramp back into the lit start over Edgesoft of a period.
        float soft = max(uStrata.w, 0.001);
        vec3 col = texture(sTD2DInputs[0], vec2(s, 0.5)).rgb;
        vec3 top = texture(sTD2DInputs[0], vec2(0.0, 0.5)).rgb;
        col = mix(col, top, smoothstep(1.0 - soft, 1.0, s));

        // Relief: lit from above. Slope of v per unit height, sign-normalized so it does not depend on the API's y.
        float dvdy = dFdy(v) / dFdy(uv.y);
        float lit = 1.0 + uStrata.z * clamp(dvdy / max(uStrata.x, 0.01) - 1.0, -1.0, 1.0);
        col *= lit;

        // ---- coarse scale: light and pulses ----
        // A broad drifting field: positive lifts regions toward white (the backlit fog), negative sinks
        // whole layers into shadow, so the frame keeps deep darks as well as blown highlights.
        float g = fbm(q * 0.4 + 23.0, loop * 0.7 + 3.0, 2, 1.5);
        float shade = mix(1.0 - clamp(1.5 * uTime.w, 0.0, 0.6), 1.0, smoothstep(-0.6, -0.05, g));
        col *= shade;
        float fog = uTime.w * smoothstep(0.05, 0.75, g);
        col *= 1.0 + 1.0 * fog;
        col = mix(col, vec3(0.97), 0.3 * fog * fog);

        // The pulses: a cosine wave in a coordinate that is mostly y, bent by very coarse smooth noise
        // and a little by the strata folds, rolling down `Scroll` bands per loop. Squared for wide soft
        // crests; it only modulates brightness, so there is no edge anywhere in it.
        float nc = fbm(q * 0.35 + 47.0, loop * 0.5 + 13.0, 2, 2.0);
        float pc = uv.y * uPulse.x + drift + 0.45 * nc + 0.12 * n;
        float pulse = 0.5 + 0.5 * cos(TAU * pc);
        pulse *= pulse;
        col *= 1.0 + uPulse.y * (pulse - 0.5);            // centred low: the troughs dim about as much as the crests lift

        // ---- color ----
        // Two soft hue mechanisms on the soft base (the prism pass only fringes the edges): a regional
        // temperature field tints mids and shadows rust or steel blue, and a thin-film hue cycle that
        // rides the pulse coordinate lays pastel pink / peach / azure bands that roll down with the light.
        float L = dot(col, vec3(0.2126, 0.7152, 0.0722));
        float temp = n4(vec4(q * 0.9 + 31.0, loop * 0.6 + 9.0));
        float tk = uCaustic.z * (1.0 - smoothstep(0.7, 1.0, L));
        col *= vec3(1.0 + 0.55 * tk * temp, 1.0 - 0.06 * tk * temp, 1.0 - 0.75 * tk * temp);   // rust, not yellow
        float phi = TAU * (pc * 2.0 + v * 0.5) + 2.0 * temp;
        float ik = uCaustic.w * smoothstep(0.25, 0.7, L);
        col *= 1.0 + ik * vec3(cos(phi), 0.6 * cos(phi + 2.6), cos(phi + 4.2));

        // ---- fine scale ----
        // Fibrous grain: two octaves of small noise, strongest in the mids.
        float fg = fbm(q * 5.0 + 61.0, loop + 51.0, 2, 1.0);
        col *= 1.0 + uLayers.z * fg * (0.4 + 0.6 * smoothstep(0.15, 0.7, L));

        // Fine sediment layers: thin contour lines of the SAME displaced coordinate, so they follow every
        // fold and run continuously through the rims. A fine noise bends the line phase and gates the
        // amplitude, so they read as brushed fibres in patches.
        float grain = n4(vec4(q * vec2(6.0, 12.0) + 5.0, loop + 21.0));
        float fine = pow(0.5 + 0.5 * cos(TAU * v * uLayers.x + 3.0 * grain), 10.0);
        fine *= smoothstep(-0.4, 0.4, n4(vec4(q * 1.5 + 41.0, loop + 33.0)));

        // Caustic web on the warped coordinates, so the veins follow the folds; brightness varies along each vein.
        vec2 pw = qw / scale;
        vec2 F  = worley(pw * uCaustic.x * vec2(0.75, 1.0), phase);
        float web = 1.0 - smoothstep(0.0, max(uCaustic.y, 0.005), F.y - F.x);
        web *= web;
        web *= 0.55 + 0.45 * n4(vec4(pw * 6.0, loop + 17.0));

        // Streak direction: the local "up" through the layers. Taken from a 2-octave version of the same
        // coordinate so the field is smooth (screen derivatives of the full fBm would jitter the rays).
        float vLow = uv.y * uStrata.x + uStrata.y * fbm(qw, loop + 11.0, 2, stretch);
        vec2 gv = vec2(dFdx(vLow) / dFdx(uv.x) / aspect, dFdy(vLow) / dFdy(uv.y));   // per unit height
        vec2 dir = normalize(gv + vec2(0.0, 1e-4));

        fragColor = TDOutputSwizzle(vec4(col, 1.0));
        fragField = TDOutputSwizzle(vec4(0.5 + 0.5 * wd, web, fine));
        fragDir   = TDOutputSwizzle(vec4(0.5 + 0.5 * dir, 0.0, 1.0));
    }
  dat_content_format: text
