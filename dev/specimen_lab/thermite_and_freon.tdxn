format: tdxn
version: '2.1'
build: 21
generator: Embody/6.2.70
td_build: 099.2025.33230
network_path: /specimen_lab/thermite_and_freon
options:
  include_dat_content: true
  include_storage: false
type_defaults:
  audioplayCHOP:
    parameters:
      autoexportroot: =parent()
      file: =app.configFolder+'/Audio/Notify.aiff'
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  blurTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  constantTOP:
    parameters:
      alpha: 0
      colorb: 0
      colorg: 0
      colorr: 0
      outputresolution: custom
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  feedbackPOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  feedbackTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  geometryCOMP:
    parameters:
      material: sprite_sediment
    size: [160, 130]
    color: [0.67, 0.67, 0.67]
  glslPOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  glslTOP:
    parameters:
      premultrgbbyalpha: false
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  glslmultiTOP:
    parameters:
      premultrgbbyalpha: false
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  gridPOP:
    parameters:
      surftype: points
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  infoDAT:
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullPOP:
    flags:
    - display
    - render
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  nullTOP:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  renderTOP:
    parameters:
      antialias: aa1
      camera: cam_sediment
      format: rgba16float
      lights: ''
      resolutionh: =parent.Specimen.par.Resolution
      resolutionw: =parent.Specimen.par.Resolution * parent.Specimen.par.Aspect
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  tableDAT:
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textDAT:
    parameters:
      language: glsl
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  toptoCHOP:
    parameters:
      autoexportroot: =parent()
      outputcolorspace: passthrough
      rate: =me.time.rate
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
type: baseCOMP
custom_pars:
  World:
  - name: Collapse
    style: Float
    startSection: true
    default: 0.035
    max: 0.3
    clampMin: true
    normMax: 0.3
    help: How fast the world caves in toward the drain, in octaves per second. Structure is born at the edges and swallowed at the drain.
  - name: Twist
    style: Float
    default: 0.25
    min: -3.0
    max: 3.0
    clampMin: true
    clampMax: true
    normMin: -3.0
    normMax: 3.0
    help: 'Rotation per octave of collapse: the world spirals into the drain along a logarithmic spiral. Negative twists the other way.'
  - name: Warp
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: Domain-warp distortion of the ground. Higher folds and smears the landforms.
  - name: Morph
    style: Float
    default: 1
    max: 5.0
    clampMin: true
    normMax: 5.0
    help: How fast the warp evolves in place, so the land keeps reshaping as it falls in.
  Flow:
  - name: Tidelevel
    style: Float
    label: Tide Level
    startSection: true
    default: 0.31
    max: 0.6
    clampMin: true
    normMax: 0.6
    help: Mean water level in terrain height units. Raise it to flood more of the drainage network.
    value: 0.4600000083
  - name: Tiderange
    style: Float
    label: Tide Range
    default: 0.05
    max: 0.2
    clampMin: true
    normMax: 0.2
    help: How far the tide rises and falls around the mean level. 0 holds the water still.
    value: 0.0900000036
  - name: Tideperiod
    style: Float
    label: Tide Period
    default: 48
    min: 5.0
    max: 300.0
    clampMin: true
    clampMax: true
    normMin: 5.0
    normMax: 300.0
    help: Seconds for one full tide cycle (rise and fall).
  - name: Runoff
    style: Float
    startSection: true
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: Strength of the downhill flow that drains the land into the channels. Carries the grains and silt.
    value: 1.7999999523
  - name: Swirl
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: Curl-noise stirring of the open water. Higher values break the plumes into finer eddies.
    value: 1.1399999857
  - name: Jets
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: How hard the channels discharge into the lagoon, setting off vortices at the mouths.
    value: 1.6599999666
  - name: Vorticity
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: 'Vorticity confinement: restores the small eddies numerical diffusion smears away.'
  - name: Carve
    style: Float
    startSection: true
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: How deeply grain trails engrave the terrain. The engraved channels pull more flow, so the drainage tree reinforces itself.
  Pigment:
  - name: Silt
    style: Float
    startSection: true
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: Pale sediment picked up by fast runoff and carried into the water as plumes.
  - name: Trails
    style: Float
    startSection: true
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: How strongly the moving grains leave lines on the ground. These lines are the visible drainage tree.
  - name: Spores
    style: Float
    startSection: true
    default: 2
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: How fast new organism colonies seed in the water. Runoff grains also carry spores in at the channel mouths.
  - name: Rdsteps
    style: Int
    label: RD Steps
    default: 8
    min: 1.0
    max: 24.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 24.0
    help: Reaction-diffusion iterations per frame. More makes the organism grow and divide faster (and costs GPU time).
  - name: Patternscale
    style: Float
    label: Pattern Scale
    default: 1
    min: 1.0
    max: 4.0
    clampMin: true
    clampMax: true
    normMin: 1.0
    normMax: 4.0
    help: Size of the reaction-diffusion features, in output pixels per diffusion step.
  - name: Feed
    style: Float
    label: Feed Bias
    min: -0.015
    max: 0.015
    clampMin: true
    clampMax: true
    normMin: -0.015
    normMax: 0.015
    help: Offset added to the Gray-Scott feed rate everywhere. Positive grows denser labyrinths, negative thins it to spots.
  - name: Kill
    style: Float
    label: Kill Bias
    min: -0.006
    max: 0.006
    clampMin: true
    clampMax: true
    normMin: -0.006
    normMax: 0.006
    help: Offset added to the Gray-Scott kill rate everywhere. Small changes swing the pattern between coral, worms and dividing spots.
  - name: Sizerange
    style: Float
    label: Size Range
    default: 1
    max: 2.0
    clampMin: true
    normMax: 2.0
    help: How far feature sizes vary across the water within each layer. 0 gives each layer a single width.
  - name: Flares
    style: Float
    default: 1
    max: 4.0
    clampMin: true
    normMax: 2.5
    help: How far the flares can reach out from the sun, relative to its radius. 0 keeps everything in the core.
  - name: Sunsize
    style: Float
    label: Large Sun
    startSection: true
    default: 0.255
    min: 0.03
    max: 0.3
    clampMin: true
    clampMax: true
    normMin: 0.05
    normMax: 0.3
    help: Radius of the large sun as a fraction of the frame. The flares reach out in multiples of it.
  - name: Smallsun
    style: Float
    label: Small Sun
    default: 0.21
    min: 0.15
    clampMin: true
    clampMax: true
    normMin: 0.15
    help: Radius of the small sun relative to the large one.
  - name: Watersize
    style: Float
    label: Water Size
    startSection: true
    default: 0.75
    min: 0.2
    max: 2.5
    clampMin: true
    clampMax: true
    normMin: 0.3
    normMax: 2.0
    help: Scale of every zero-g water drop and spray droplet. At 1 the largest glob is two thirds of the large sun's radius and the finest droplets about a hundredth of that.
  - name: Waterpull
    style: Float
    label: Water Pull
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: How strongly the water falls back toward the large sun. 0 lets flung drops drift free.
  - name: Waterfling
    style: Float
    label: Water Fling
    default: 1
    max: 5.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: How often drops are flung off the large sun. 0 keeps them clinging until the suns collide.
  - name: Waterspray
    style: Float
    label: Water Spray
    default: 1
    max: 4.0
    clampMin: true
    clampMax: true
    normMax: 3.0
    help: 'How much spray the water throws when it is hit: the small sun ploughing through it, the suns colliding, drops flung off or slamming together. 0 turns the spray off.'
  - name: Separation
    style: Float
    default: 1
    min: 0.4
    max: 2.0
    clampMin: true
    normMin: 0.4
    normMax: 2.0
    help: Scale of the distance the two suns keep. Lower keeps them touching more of the time.
  - name: Orbitspeed
    style: Float
    label: Orbit Speed
    default: 2.2
    max: 4.0
    clampMin: true
    normMax: 4.0
    help: Speed of the two suns' dance around each other.
  - name: Bursts
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: Strength of the slow colour explosions released while the suns touch.
  - name: Streaks
    style: Float
    default: 2
    min: 0.03
    max: 6.0
    clampMin: true
    normMin: 0.03
    normMax: 4.0
    help: How long the spark trails linger, as the time each colour channel takes to fade. Higher keeps long cooling lines behind the embers; low gives a short comet flick. Trails cool lemon to gold to orange to vermilion.
  Look:
  - name: Exposure
    style: Float
    startSection: true
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: Overall exposure before tone mapping.
  - name: Sunazimuth
    style: Float
    label: Sun Azimuth
    default: 142
    max: 360.0
    clampMin: true
    clampMax: true
    normMax: 360.0
    help: Sun direction in degrees, counterclockwise from the right edge of the frame.
  - name: Sunelevation
    style: Float
    label: Sun Elevation
    default: 28
    min: 5.0
    max: 85.0
    clampMin: true
    clampMax: true
    normMin: 5.0
    normMax: 85.0
    help: Sun height above the ground in degrees. Low sun means long shadows and strong relief.
  - name: Relief
    style: Float
    default: 0.06
    max: 0.2
    clampMin: true
    normMax: 0.2
    help: Vertical exaggeration of the terrain for lighting and shadows.
  - name: Vignette
    style: Float
    default: 0.35
    clampMin: true
    clampMax: true
    help: Darkening of the outer third of the frame.
  - name: Grain
    style: Float
    default: 0.07
    max: 0.2
    clampMin: true
    normMax: 0.2
    help: Film grain amount, applied last.
  - name: Glow
    style: Float
    startSection: true
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: Ember glow bleeding off the hot organism.
  - name: Melt
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: How strongly the heat refracts and sags everything around the hot masses.
  - name: Shimmer
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: Fast heat-haze shimmer over the hot areas.
  - name: Halation
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: 'Film halation: the tight hot bloom and the wide red bleed that bright light leaves in the dark.'
  - name: Imperfections
    style: Float
    default: 1
    max: 3.0
    clampMin: true
    normMax: 3.0
    help: 'Strength of the film and lens flaws: gate weave, flicker, chromatic fringing, edge softness, dust and the light leak.'
  Sim:
  - name: Resolution
    style: Int
    startSection: true
    default: 2048
    min: 256.0
    max: 4096.0
    clampMin: true
    clampMax: true
    normMin: 256.0
    normMax: 4096.0
    help: Output height in pixels; the width is height x Aspect.
    value: 2160
  - name: Aspect
    style: Float
    default: 0.8
    min: 0.4
    max: 2.5
    clampMin: true
    clampMax: true
    normMin: 0.5625
    normMax: 1.7778
    help: 'Frame width divided by height: 1 is square, 0.8 is Instagram''s 4:5 portrait, 0.5625 is 9:16. Resolution sets the height. Every shape stays round at any aspect; the frame widens or narrows around the suns.'
  - name: Simresolution
    style: Int
    label: Sim Resolution
    default: 384
    min: 128.0
    max: 1024.0
    clampMin: true
    clampMax: true
    normMin: 128.0
    normMax: 1024.0
    help: Square resolution of the velocity solver. The flow is smooth, so it runs well below the output resolution.
  - name: Pressureiterations
    style: Int
    label: Pressure Iterations
    default: 16
    min: 4.0
    max: 120.0
    clampMin: true
    clampMax: true
    normMin: 4.0
    normMax: 120.0
    help: Jacobi iterations per frame for the pressure solve. More keeps the water closer to incompressible.
  Sound:
  - name: Sound
    style: Toggle
    startSection: true
    default: true
    help: 'Play the ElevenLabs sound library: the loops, plus collisions, sparks and moon passes as they happen.'
  - name: Volume
    style: Float
    default: 0.7
    clampMin: true
    help: Master volume of all sound.
  - name: Beds
    style: Float
    default: 1
    max: 2.0
    clampMin: true
    normMax: 2.0
    help: Level of the three continuous loops (sun drone, plasma crackle, magnetic hum), relative to the master volume.
  - name: Events
    style: Float
    default: 1
    max: 2.0
    clampMin: true
    normMax: 2.0
    help: Level of the event one-shots (collisions, sparks, moon passes), relative to the master volume.
  - name: Watersfx
    style: Float
    label: Water
    default: 0.5
    clampMin: true
    clampMax: true
    help: Level of the water sounds (soft sloshes when a drop is shoved, a faint spray patter on the big hits), relative to the event level.
parameters:
  parentshortcut: Specimen
flags:
- viewer
color: [0.3, 0.5, 0.9]
tags:
- tdxn
storage:
  embed_dats_in_tdn: true
  embed_storage_in_tdn: false
operators:
- name: out1
  type: outTOP
  parameters:
    label: =me.name
  position: [8000, -800]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - glsl_finish
- name: blur_heat
  type: blurTOP
  parameters:
    size: 40
  position: [5200, -2400]
  inputs:
  - glsl_heat
- name: glsl_heat
  type: glslmultiTOP
  parameters:
    pixeldat: glsl_heat_pixel
    outputresolution: custom
    resolutionw: =parent.Specimen.par.Resolution * parent.Specimen.par.Aspect / 4
    resolutionh: =parent.Specimen.par.Resolution // 4
    format: rgba16float
  sequences:
    vec:
    - {}
    - name: uWin
      valuex: 0
      valuey: 0
  position: [4800, -2400]
  inputs:
  - null_life
  - null_pigment
  - null_streaks
- name: glsl_life
  type: glslmultiTOP
  parameters:
    pixeldat: glsl_life_pixel
    inputextenduv: hold
    npasses: =parent.Specimen.par.Rdsteps + 1
    format: rg32float
  sequences:
    vec:
    - name: uLife
      valuex: =parent.Specimen.par.Spores * 1.5
      valuey: 140
      valuez: =parent.Specimen.par.Sizerange * 0.45
      valuew: =1.0 + 1.6 * parent.Specimen.par.Flares
    - name: uRD
      valuex: =parent.Specimen.par.Feed
      valuey: =parent.Specimen.par.Kill
      valuez: =parent.Specimen.par.Patternscale
      valuew: 0
    - name: uTime
      valuex: =absTime.seconds
      valuey: 0
      valuez: 0
      valuew: 0
    - name: uWin
      valuex: 0
      valuey: 0
      valuew: 0
    - name: uAspect
      valuex: =parent.Specimen.par.Aspect
  position: [4000, -2000]
  inputs:
  - feedback_life
  - rselect_flow
  - glsl_canopy
- name: null_life
  type: nullTOP
  position: [4400, -2000]
  inputs:
  - glsl_life
- name: audio_beds
  type: audioplayCHOP
  parameters:
    datlist: table_sfx_beds
  position: [2000, -4600]
  inputs:
  - null
  - const_bed_levels
- name: blur_bloom
  type: blurTOP
  parameters:
    size: 5
  position: [6800, -1200]
  inputs:
  - glsl_bright
- name: geo_sparks
  type: geometryCOMP
  position: [2400, -4000]
  children:
  - name: grid_spark
    type: gridPOP
    parameters:
      cols: 128
      rows: 128
  - name: glsl_sparks
    type: glslPOP
    parameters:
      computedat: glsl_sparks_compute
      outputattrs: P N Tex Age Color PointScale
    sequences:
      vec:
      - name: uSpark
        type: vec4
        valuex: =parent.Specimen.par.Bursts
        valuey: =absTime.seconds
        valuez: =absTime.frame
        valuew: =parent.Specimen.par.Aspect
      sampler:
      - name: sFlow
        top: ../rselect_flow
      - name: sOrbit
        top: ../glsl_orbit
        filter: nearest
    position: [1200, 0]
    inputs:
    - feedback_sparks
  - name: null_sparks
    type: nullPOP
    position: [1600, 0]
    inputs:
    - glsl_sparks
  - name: feedback_sparks
    type: feedbackPOP
    parameters:
      targetpop: null_sparks
    position: [800, 0]
    inputs:
    - glsl_spark_seed
  - name: glsl_spark_seed
    type: glslPOP
    parameters:
      computedat: glsl_spark_seed_compute
      outputattrs: P N Tex Age Color PointScale
    sequences:
      attr:
      - customname: Age
      - name: color
      - name: pointscale
    position: [400, 0]
    inputs:
    - grid_spark
  - name: glsl_sparks_info
    type: infoDAT
    parameters:
      op: glsl_sparks
    position: [1275, -120]
    dock: glsl_sparks
    dat_read_only: true
  - name: glsl_sparks_compute
    type: textDAT
    position: [1125, -120]
    dock: glsl_sparks
    dat_content: |
      // electric light: sparks fired where the two suns collide, into each impact's own direction and
      // spread (glsl_orbit), steering along the simulation's streamlines with a jagged sideways kick. Each spark
      // rolls a heavily skewed reach: most burst out about a tenth of the frame and slow like embers, a rare few
      // fly further -- faster, longer lived, less damped -- dimming as they go. Each spark is a chain of K consecutive points that all
      // carry the same state -- Tex.xy position and N.xy velocity per frame (world units: height 1, width = aspect,
      // uSpark.w), N.z reach, Age -- and
      // draw themselves along the segment travelled this frame, so the streak buffer gets a line, not dots.
      // sFlow: xy flow (uv per frame). sOrbit: texel 0 sun positions, 2 radii/touch/envelope, 3 direction/spread.
      // uSpark: x strength, y seconds, z frame, w aspect
      const uint K = 8u;

      float hash1(uint n) {
          n = (n << 13U) ^ n;
          n = n * (n * n * 15731U + 789221U) + 1376312589U;
          return float(n & 0x7fffffffU) / float(0x7fffffff);
      }

      void main() {
          const uint id = TDIndex();
          if (id >= TDNumElements())
              return;
          uint s = id / K;                     // the spark this point belongs to: every hash keys on it
          uint k = id % K;
          uint fr = uint(uSpark.z);
          vec2 pos = TDIn_Tex().xy;
          vec3 nv = TDIn_N();
          vec2 vel = nv.xy;
          float reach = nv.z;
          float age = TDIn_Age();
          vec2 prev = pos;
          vec2 asp = vec2(uSpark.w, 1.0);

          if (age < 0.0) {
              vec4 sp = texelFetch(sOrbit, ivec2(0, 0), 0);
              vec4 rd = texelFetch(sOrbit, ivec2(2, 0), 0);
              vec4 ev = texelFetch(sOrbit, ivec2(3, 0), 0);
              if (hash1(s * 7919U + fr * 104729U) >= uSpark.x * rd.w * 0.02) {
                  P[id] = vec3(-9.0, -9.0, 0.0);
                  N[id] = vec3(0.0);
                  Tex[id] = vec3(0.0);
                  Age[id] = -1.0;
                  Color[id] = vec4(0.0);
                  PointScale[id] = 1.0;
                  return;
              }
              vec2 contact = mix(sp.xy, sp.zw, rd.x / (rd.x + rd.y));
              float a = ev.x + (hash1(s * 31U + fr * 17U) - 0.5) * ev.y * 6.2831853;
              vec2 dir = vec2(cos(a), sin(a));
              reach = pow(hash1(s * 211U + fr * 3U), 5.0);
              pos = contact + dir * 0.012;
              prev = pos;
              vel = dir * (0.0035 + 0.0025 * hash1(s * 53U + fr * 7U) + 0.006 * reach);
              age = 0.0;
          } else {
              age += 1.0 / 60.0;
              vec4 F = texture(sFlow, pos / asp);
              float sp = length(vel);
              if (length(F.xy) > 1e-7)
                  vel = mix(vel, normalize(F.xy * asp) * sp, 0.02 * (1.0 - 0.6 * reach));   // long shots hold their line
              // electricity seeks the water: steer up the wetness gradient, race along the channels,
              // lose energy fast over dry land
              const float E = 0.004;
              vec2 gw = vec2(texture(sFlow, (pos + vec2(E, 0.0)) / asp).z - texture(sFlow, (pos - vec2(E, 0.0)) / asp).z,
                             texture(sFlow, (pos + vec2(0.0, E)) / asp).z - texture(sFlow, (pos - vec2(0.0, E)) / asp).z);
              vel += gw * sp * 0.03;
              // strong drag: most sparks burst out about a tenth of the frame and slow like embers
              vel *= mix(0.94, 0.985, reach) * mix(0.995, 1.0, F.z);
              prev = pos;
              vec2 side = vec2(-vel.y, vel.x) / max(sp, 1e-6);
              pos += vel + side * (hash1(s * 13U + fr * 7919U) - 0.5) * 0.0011;   // electric: a jagged kick
          }
          float life = 0.6 + 0.8 * hash1(s * 97U + 11U) + 3.0 * reach;
          bool dead = age > life || pos.x < -0.05 || pos.y < -0.05 || pos.x > asp.x + 0.05 || pos.y > 1.05;
          float a = dead ? 0.0 : (1.0 - smoothstep(life * 0.6, life, age)) * mix(1.0, 0.5, age / life);
          P[id] = vec3(mix(prev, pos, (float(k) + 0.5) / float(K)) - vec2(0.5 * asp.x, 0.5), 0.0);   // centred for the ortho camera
          N[id] = vec3(vel, reach);
          Tex[id] = vec3(pos, 0.0);
          Age[id] = dead ? -1.0 : age;
          Color[id] = vec4(a, a, a, a);
          PointScale[id] = 1.0;
      }
    dat_content_format: text
  - name: glsl_spark_seed_info
    type: infoDAT
    parameters:
      op: glsl_spark_seed
    position: [475, -120]
    dock: glsl_spark_seed
    dat_read_only: true
  - name: glsl_spark_seed_compute
    type: textDAT
    position: [325, -120]
    dock: glsl_spark_seed
    dat_content: |
      // every spark starts dead (Age < 0), waiting for the suns to touch (static: cooks once)
      void main() {
          const uint id = TDIndex();
          if (id >= TDNumElements())
              return;
          P[id] = vec3(-9.0, -9.0, 0.0);
          N[id] = vec3(0.0);
          Tex[id] = vec3(0.0);
          Age[id] = -1.0;
          Color[id] = vec4(0.0);
          PointScale[id] = 1.0;
      }
    dat_content_format: text
