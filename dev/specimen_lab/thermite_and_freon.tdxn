- name: glsl_bright_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [6325, -1320]
  dock: glsl_bright
  dat_content: |
    // the light that blooms: whatever burns brighter than the threshold, at half resolution
    layout(location = 0) out vec4 fragColor;
    void main() {
        vec3 c = texture(sTD2DInputs[0], vUV.st).rgb;
        float l = max(c.r, max(c.g, c.b));
        fragColor = TDOutputSwizzle(vec4(c * smoothstep(0.3, 0.9, l), 1.0));
    }
  dat_content_format: text
- name: glsl_canopy_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [3525, -520]
  dock: glsl_canopy
  dat_content: |
    // the two suns' fields, shared by the organism (it grows from the suns) and the compose (it draws them).
    // Each sun is a noisy molten disc placed by glsl_orbit. Around each limb a slowly rotating noise picks a
    // few active regions: only there can flares ignite and feed, so the corona breaks into separate eruptions.
    // out: r = activity of the nearest body's limb at this angle (0 quiet .. 1 erupting), g = distance from the
    //      nearest small body (the small sun or one of the three moons) in its own radii, b = log2 pattern
    //      scale for the organism, a = distance from the large sun's centre in its radii
    // in0: glsl_orbit (texel 0 positions, texel 2 radii, texels 4-5 moons)
    uniform vec4 uTime;   // x = seconds
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    // distance from a sun's centre in units of its boiling, irregular limb
    float limbDist(vec2 uv, vec2 c, float r, float tt, float seed) {
        vec2 dv = uv - c;
        vec2 dir = normalize(dv + 1e-6);
        float edge = r * (1.0 + 0.035 * TDSimplexNoise(vec3(dir * 1.8 + seed, tt * 0.15))
                              + 0.015 * TDSimplexNoise(vec3(dir * 6.0 + seed, tt * 0.5))
                              + 0.007 * TDSimplexNoise(vec3(dir * 22.0 + seed, tt * 1.1)));
        return length(dv) / edge;
    }
    // a few active sectors around a limb, rotating and reshaping slowly
    float activity(vec2 uv, vec2 c, float tt, float seed) {
        vec2 dir = normalize(uv - c + 1e-6);
        return smoothstep(0.05, 0.4, TDSimplexNoise(vec3(dir * 1.6 + seed, tt * 0.07)));
    }

    void main() {
        vec2 uv = vUV.st * vec2(uAspect.x, 1.0);           // world units: the discs stay round at any aspect
        float tt = uTime.x;
        vec4 pos = texelFetch(sTD2DInputs[0], ivec2(0, 0), 0);
        vec4 rad = texelFetch(sTD2DInputs[0], ivec2(2, 0), 0);
        float rhoL = limbDist(uv, pos.xy, rad.x, tt, 0.0);
        float rhoS = limbDist(uv, pos.zw, rad.y, tt * 1.4, 7.3);
        vec2 cS = pos.zw;
        // the three tiny moons join the small-body channel: drawn, flaring and erupting like the small sun
        vec4 m01 = texelFetch(sTD2DInputs[0], ivec2(4, 0), 0);
        vec2 m2 = texelFetch(sTD2DInputs[0], ivec2(5, 0), 0).xy;
        vec2 mc[3] = vec2[3](m01.xy, m01.zw, m2);
        const float MR[3] = float[3](0.087, 0.067, 0.107);   // moon radii relative to the large sun
        for (int k = 0; k < 3; k++) {
            float rk = limbDist(uv, mc[k], rad.x * MR[k], tt * (1.6 + 0.3 * float(k)), 19.0 + 5.0 * float(k));
            if (rk < rhoS) { rhoS = rk; cS = mc[k]; }
        }
        float act = rhoL < rhoS ? activity(uv, pos.xy, tt, 3.1) : activity(uv, cS, tt * 1.3, 11.7);
        float sizes = 1.6 * TDSimplexNoise(vec3(uv * 1.7, tt * 0.012)) + 0.7 * TDSimplexNoise(vec3(uv * 6.5 + 3.0, tt * 0.02)) + 0.3;
        fragColor = TDOutputSwizzle(vec4(act, rhoS, sizes, rhoL));
    }
  dat_content_format: text
- name: glsl_compose_info
  type: infoDAT
  parameters:
    op: glsl_compose
  position: [5925, -920]
  dock: glsl_compose
  dat_read_only: true
- name: glsl_finish_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [7675, -920]
  dock: glsl_finish
  dat_content: |
    // film pass: the frame is treated as if it were shot on film through an imperfect lens. Gate weave and
    // drift, slight barrel distortion, the heat refraction around the suns, chromatic fringing that grows
    // toward the edges, edge softness, exposure flicker, halation (a tight hot bloom plus a wide bleed that
    // turns red as it spreads into the dark), the ember glow, a slow warm light leak, a drifting irregular
    // vignette, a soft highlight shoulder over near-black space, then clumped colour grain and dust.
    // The inks upstream are display-referred.
    // in0: compose, in1: blurred heat, in2: tight bloom, in3: wide halation
    uniform vec4 uFinish;   // x exposure, y vignette strength, z grain amount, w seconds
    uniform vec4 uHeat;     // x melt (refraction), y shimmer, z glow
    uniform vec4 uFilm;     // x frame, y halation, z imperfections
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    const vec3 VERM   = vec3(0.871, 0.069, 0.013);
    const vec3 ORANGE = vec3(0.955, 0.188, 0.021);

    float hash12(vec2 p) {
        vec3 p3 = fract(vec3(p.xyx) * 0.1031);
        p3 += dot(p3, p3.yzx + 33.33);
        return fract((p3.x + p3.y) * p3.z);
    }
    float hash11(float n) { return hash12(vec2(n, n * 0.618 + 17.0)); }
    float vnoise(vec2 p) {
        vec2 i = floor(p), f = fract(p);
        f = f * f * (3.0 - 2.0 * f);
        return mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), f.x),
                   mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), f.x), f.y);
    }

    void main() {
        vec2 uv = vUV.st;
        float t = uFinish.w, fr = uFilm.x, imp = uFilm.z;
        vec2 res = uTD2DInfos[0].res.zw;

        // gate weave: a sub-pixel jitter every frame plus a slow drift; slight barrel distortion
        vec2 p = uv + (vec2(hash11(fr), hash11(fr + 3.1)) - 0.5) * 0.0009 * imp
                    + vec2(sin(t * 0.7), cos(t * 0.53)) * 0.0012 * imp;
        vec2 asp = vec2(uAspect.x, 1.0);
        vec2 cc = (p - 0.5) * asp;                        // world units: the lens stays round at any aspect
        float r2 = dot(cc, cc);
        p = 0.5 + cc * (1.0 + 0.035 * imp * r2) / asp;

        // heat refraction: dragged into the heat, dripping, and a haze that splits the inks
        vec2 ht = 2.0 * uTD2DInfos[1].res.xy;
        float h = texture(sTD2DInputs[1], p).r;
        vec2 grad = vec2(texture(sTD2DInputs[1], p + vec2(ht.x, 0.0)).r - texture(sTD2DInputs[1], p - vec2(ht.x, 0.0)).r,
                         texture(sTD2DInputs[1], p + vec2(0.0, ht.y)).r - texture(sTD2DInputs[1], p - vec2(0.0, ht.y)).r);
        float hot = smoothstep(0.05, 0.6, h);
        float core = smoothstep(0.9, 1.4, h);
        vec2 shimmer = vec2(TDSimplexNoise(vec3(p * asp * 26.0, t * 2.3)), TDSimplexNoise(vec3(p * asp * 26.0 + 17.0, t * 2.3)));
        vec2 off = (-grad * 0.035 * uHeat.x + vec2(0.0, 0.006) * hot * uHeat.x + shimmer * 0.0022 * uHeat.y * hot) * (1.0 - 0.6 * core);
        vec2 split = shimmer.yx * 0.0012 * uHeat.y * hot;
        vec2 q = p + off;

        // chromatic fringing grows toward the edges
        vec2 ca = cc * (0.002 + 0.008 * r2) * imp / asp;
        vec3 c;
        c.r = texture(sTD2DInputs[0], q + ca + split).r;
        c.g = texture(sTD2DInputs[0], q).g;
        c.b = texture(sTD2DInputs[0], q - ca - split).b;
        // edge softness: the lens loses focus toward the corners
        float soft = smoothstep(0.1, 0.42, r2) * min(imp, 1.5);
        if (soft > 0.01) {
            vec2 px = uTD2DInfos[0].res.xy * (1.0 + 3.0 * soft);
            vec3 b = 0.25 * (texture(sTD2DInputs[0], q + px).rgb + texture(sTD2DInputs[0], q - px).rgb
                           + texture(sTD2DInputs[0], q + vec2(px.x, -px.y)).rgb + texture(sTD2DInputs[0], q + vec2(-px.x, px.y)).rgb);
            c = mix(c, b, soft * 0.8);
        }

        // exposure with a little flicker
        c *= uFinish.x * (1.0 + (hash11(floor(fr * 0.5)) - 0.5) * 0.06 * imp + 0.015 * sin(t * 11.0) * imp);

        // halation: a tight hot bloom, and a wide bleed that turns red as it spreads into the dark
        vec3 bl = texture(sTD2DInputs[2], q).rgb;
        float hl = dot(texture(sTD2DInputs[3], q).rgb, vec3(0.45, 0.4, 0.15));
        c += uFilm.y * (bl * vec3(1.0, 0.8, 0.6) * 0.5 + hl * vec3(1.0, 0.2, 0.05) * 0.85);
        // the ember glow from the heat, gentler now that halation carries the light
        vec3 glow = mix(VERM, ORANGE, smoothstep(0.3, 1.0, h)) * pow(clamp(h, 0.0, 1.5), 1.8) * 0.14 * uHeat.z * (1.0 - 0.75 * core);
        c += glow;
        // a slow warm light leak drifting along the left edge
        vec2 lk = vec2(-0.05 + 0.12 * sin(t * 0.05), 0.75 + 0.2 * sin(t * 0.031));
        vec2 dl = (uv - lk) * vec2(1.7, 1.0);
        c += exp(-dot(dl, dl) / 0.1) * (0.5 + 0.5 * sin(t * 0.13)) * vec3(1.0, 0.32, 0.07) * 0.09 * imp;
        // an irregular vignette that wanders a little
        float vg = length((uv - 0.5 - 0.03 * vec2(sin(t * 0.07), cos(t * 0.05))) * vec2(1.0, 1.08));
        c *= 1.0 - uFinish.y * smoothstep(0.3, 0.8, vg + 0.05 * (vnoise(uv * 3.0 + t * 0.05) - 0.5));

        // tone: a soft shoulder over near-black space, then display gamma
        c = max(c, 0.0);
        c = c / (1.0 + 0.3 * c) * 1.3;
        c = vec3(0.0009, 0.0011, 0.0022) + clamp(c, 0.0, 1.0) * 0.99;
        c = pow(c, vec3(1.0 / 2.2));

        // grain: clumped and fine, mostly luminance with a little colour, strongest in the midtones
        vec2 pxc = uv * res;
        float sd = fract(fr * 0.1234) * 1000.0;
        vec3 gn = vec3(vnoise(pxc * 0.55 + sd), vnoise(pxc * 0.55 + sd + 31.7), vnoise(pxc * 0.55 + sd + 63.1)) * 0.6
                + vec3(hash12(pxc + sd), hash12(pxc + sd + 7.1), hash12(pxc + sd + 3.3)) * 0.4;
        gn = mix(vec3(gn.g), gn, 0.35) - 0.5;
        float lum = dot(c, vec3(0.3333));
        c += gn * uFinish.z * (0.35 + 2.4 * lum * (1.0 - lum));

        // dust: a few soft specks each frame, mostly dark, sometimes bright
        vec2 uw = uv * asp;
        vec2 cell = floor(uw * 28.0);
        if (hash12(cell + fr * 7.13) > 1.0 - 0.01 * imp) {
            vec2 dc = (cell + vec2(hash12(cell + 1.7 + fr), hash12(cell + 9.3 + fr))) / 28.0;
            float dr = 0.0008 + 0.0024 * hash12(cell + 4.4 + fr);
            float speck = 1.0 - smoothstep(dr * 0.5, dr, length((uw - dc) * vec2(1.0, 1.0 + hash12(cell + 2.2))));
            c = mix(c, hash12(cell + 5.5 + fr) > 0.3 ? vec3(0.015) : vec3(0.88, 0.84, 0.78), speck * 0.85);
        }
        fragColor = TDOutputSwizzle(vec4(c, 1.0));
    }
  dat_content_format: text
- name: glsl_ground_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [325, -120]
  dock: glsl_ground
  dat_content: |
    // static ground material: mudflat albedo with baked cavity occlusion; a = soft sun visibility
    // in0: glsl_terrain (r height, g ripple, b grain, a macro). noise is band-limited like the terrain's.
    uniform vec4 uSun;    // x azimuth deg (ccw from the right edge), y elevation deg, z height scale
    uniform vec4 uTide;   // x = mean water level (the intertidal band centres on it)
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    const mat2 OCT = mat2(1.6, 1.2, -1.2, 1.6);

    float fbm(vec2 p, int oct, float fp) {
        float a = 0.5, s = 0.0;
        for (int i = 0; i < 8; i++) {
            if (i >= oct) break;
            s += a * TDSimplexNoise(p) * (1.0 - smoothstep(0.2, 0.45, fp));
            p = OCT * p + 3.17;
            a *= 0.5;
            fp *= 2.0;
        }
        return s;
    }
    vec4 T(vec2 uv) { return texture(sTD2DInputs[0], uv); }

    void main() {
        vec2 uv = vUV.st;
        vec2 px = uTD2DInfos[0].res.xy;
        vec2 asp = vec2(uAspect.x, 1.0);               // offsets are world units; / asp turns them into uv
        vec2 pw = uv * asp;
        vec4 t = T(uv);
        float hs = uSun.z;

        // cavity occlusion at three radii (world units, so it holds its scale at any resolution and aspect)
        float cav = 0.0;
        for (int k = 0; k < 2; k++) {
            float rad = 0.003 * pow(4.0, float(k));
            float s = 0.0;
            for (int i = 0; i < 6; i++) {
                float a = float(i) * 1.0471976 + float(k) * 0.52;
                s += T(uv + vec2(cos(a), sin(a)) * rad / asp).r;
            }
            cav += max(s / 6.0 - t.r, 0.0) / (1.0 + float(k));
        }
        float occl = clamp(1.0 - cav * 9.0, 0.0, 1.0);

        // soft shadow: march toward the sun; a per-pixel jitter turns step banding into fine noise
        float az = radians(uSun.x), el = radians(uSun.y);
        vec3 L = vec3(cos(el) * cos(az), cos(el) * sin(az), sin(el));
        vec2 dirD = normalize(L.xy);
        float rise = L.z / length(L.xy);
        float h0 = t.r * hs;
        float jit = fract(52.9829189 * fract(dot(gl_FragCoord.xy, vec2(0.06711056, 0.00583715))));
        float vis = 1.0;
        for (int i = 1; i <= 24; i++) {
            float fi = float(i) - jit * 0.9;
            float d = 0.0018 * fi + 0.00028 * fi * fi;
            float clear = h0 + d * rise - T(uv + dirD * d / asp).r * hs;
            vis = min(vis, clamp(10.0 * (clear + 0.0003) / d, 0.0, 1.0));
        }

        float h = t.r + 0.06 * t.a;                     // band edges wander with the macro field
        float n2 = fbm(pw * 40.0 + 7.0, 4, 40.0 * px.y);
        float grain = t.b;

        vec3 bed   = vec3(0.040, 0.042, 0.034);
        vec3 silt  = vec3(0.150, 0.128, 0.096);
        vec3 sand  = vec3(0.400, 0.350, 0.265);
        vec3 salt  = vec3(0.600, 0.575, 0.510);
        vec3 ochre = vec3(0.330, 0.180, 0.065);
        vec3 algaD = vec3(0.050, 0.070, 0.028);
        vec3 algaL = vec3(0.165, 0.205, 0.060);

        vec3 col = mix(bed, silt, smoothstep(uTide.x - 0.12, uTide.x + 0.12, h));
        col = mix(col, sand, smoothstep(0.45, 0.75, h + 0.1 * n2));
        col = mix(col, salt, smoothstep(0.78, 0.95, h + 0.08 * n2) * smoothstep(0.1, 0.5, grain + 0.3 * n2));

        // intertidal algae mats: patchy, densest just above the mean waterline
        float band = exp(-pow((h - uTide.x - 0.06) / 0.09, 2.0));
        float mats = smoothstep(-0.1, 0.35, fbm(pw * 9.0 + 2.0, 5, 9.0 * px.y) + 0.3 * t.a) * band;
        col = mix(col, mix(algaD, algaL, smoothstep(0.3, 0.8, grain + 0.3 * n2)), mats * 0.9);

        // iron oxide bleeding down the steeper banks
        vec2 e5 = 4.0 * px;
        float slope = length(vec2(T(uv + vec2(e5.x, 0.0)).r - T(uv - vec2(e5.x, 0.0)).r,
                                  T(uv + vec2(0.0, e5.y)).r - T(uv - vec2(0.0, e5.y)).r) / (2.0 * e5 * asp));
        col = mix(col, ochre * (0.7 + 0.6 * grain), smoothstep(1.2, 3.0, slope) * smoothstep(-0.3, 0.3, n2 + t.a) * 0.7);


        // faint strata where the relief cuts the layers; fades before the bands get under a pixel
        float phase = t.r * 140.0 + 6.0 * t.a;
        float strata = (0.5 + 0.5 * sin(phase)) * (1.0 - smoothstep(0.6, 1.4, fwidth(phase)));
        col *= 1.0 - 0.05 * strata * smoothstep(0.3, 0.9, h);

        col *= mix(0.3, 1.0, occl);
        fragColor = TDOutputSwizzle(vec4(col, vis));
    }
  dat_content_format: text
- name: glsl_pigment_info
  type: infoDAT
  parameters:
    op: glsl_pigment
  position: [3275, -1720]
  dock: glsl_pigment
  dat_read_only: true
- name: glsl_project_info
  type: infoDAT
  parameters:
    op: glsl_project
  position: [1675, -920]
  dock: glsl_project
  dat_read_only: true
- name: glsl_streaks_info
  type: infoDAT
  parameters:
    op: glsl_streaks
  position: [3675, -4120]
  dock: glsl_streaks
  dat_read_only: true
- name: glsl_stream_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [-75, -720]
  dock: glsl_stream
  dat_content: |
    // stream function psi for the curl-noise stirring: two de-synced fbm layers that evolve in place
    uniform vec4 uStream;   // x = seconds
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    const mat2 OCT = mat2(1.6, 1.2, -1.2, 1.6);

    float fbm3(vec3 p, int oct) {
        float a = 0.5, s = 0.0;
        for (int i = 0; i < 6; i++) {
            if (i >= oct) break;
            s += a * TDSimplexNoise(p);
            p = vec3(OCT * p.xy, p.z * 1.7) + 3.17;
            a *= 0.5;
        }
        return s;
    }

    void main() {
        vec2 uv = vUV.st * vec2(uAspect.x, 1.0);            // world units: the stirring stays isotropic
        float t = uStream.x;
        float big = fbm3(vec3(uv * 2.5, t * 0.035), 3);
        float small = fbm3(vec3(uv * 9.0 + 4.0, t * 0.11), 3);
        fragColor = TDOutputSwizzle(vec4(big + 0.35 * small, 0.0, 0.0, 1.0));
    }
  dat_content_format: text
- name: glsl_terrain_info
  type: infoDAT
  parameters:
    op: glsl_terrain
  position: [75, -120]
  dock: glsl_terrain
  dat_read_only: true
- name: const_pigment_seed
  type: constantTOP
  parameters:
    resolutionw: =parent.Specimen.par.Resolution * parent.Specimen.par.Aspect
    resolutionh: =parent.Specimen.par.Resolution
    format: rgba16float
  position: [0, -1600]
- name: glsl_compose_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [6075, -920]
  dock: glsl_compose
  dat_content: |
    // Japanese retro screen print: the scene reduced to a handful of inks -- sumi (indigo-black), deep sage,
    // sage, paper cream, vermilion and orange -- laid down as flat, soft-edged bands. Land is paper and sage
    // with topographic contour lines; water is sage by depth with paper silt wisps. The organism is the one
    // intense accent in two populations: large vermilion bodies with deep red cores and fine orange specks,
    // keylined in sumi and printed a hair off register. Around the heat everything chars toward oxblood.
    // The field is one uniform deep dark -- no light pool -- so the suns and their fire carry all the contrast.
    // in0: terrain, in1: ground (a = sun visibility), in2: pigment (r silt, a trails), in3: flow,
    // in4: rendered grains, in5: specks (r V, g eaten), in6: suns (g / a distance in small / large radii),
    // in7: zero-g water (r field, gb gradient, a blended radius), in11: glsl_orbit (sun positions and radii),
    // in12: glsl_spray (spray droplets, one per cell, 96 cells per world unit),
    // positions are world units (height 1, width = aspect); textures are sampled in frame uv
    // in8: blurred heat, in9: light streaks, in10: blurred streaks (their spilled light)
    uniform vec4 uSun;    // x azimuth deg, y elevation deg, z relief
    uniform vec4 uTide;   // x mean level, y range, z cycles, w carve depth
    uniform vec4 uWin;    // the speck field's window: xy frame-uv origin, z size
    uniform vec4 uTime;   // x seconds
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    // inks, linear (sRGB #1C1E26 #4A5E4C #96A884 #C4CEAC #F2E6CE #F04A1E #FA7828 #6E1A10 #B0260E)
    const vec3 SUMI    = vec3(0.011, 0.013, 0.019);
    const vec3 SAGE_D  = vec3(0.069, 0.111, 0.072);
    const vec3 SAGE    = vec3(0.305, 0.392, 0.231);
    const vec3 SAGE_L  = vec3(0.552, 0.617, 0.413);
    const vec3 PAPER   = vec3(0.888, 0.791, 0.617);
    const vec3 VERM    = vec3(0.871, 0.069, 0.013);
    const vec3 ORANGE  = vec3(0.955, 0.188, 0.021);
    const vec3 OXBLOOD = vec3(0.155, 0.010, 0.005);
    const vec3 CORE    = vec3(0.431, 0.019, 0.004);
    const vec3 HOT     = vec3(1.000, 0.716, 0.352);   // sRGB #FFDCA0, the large sun's white-hot centre
    const vec3 LEMON   = vec3(1.000, 0.871, 0.456);   // sRGB #FFF0B4, the small sun's centre
    const vec3 CITRUS  = vec3(1.000, 0.434, 0.000);   // sRGB #FFB000

    float HC(vec2 uv) { return texture(sTD2DInputs[0], uv).r - uTide.w * texture(sTD2DInputs[2], uv).a; }

    // n flat bands with anti-aliased steps
    float bands(float x, float n) {
        float y = clamp(x, 0.0, 1.0) * n;
        float f = fract(y);
        float w = fwidth(y) + 0.06;
        return min((floor(y) + smoothstep(0.5 - w, 0.5 + w, f)) / n, 1.0);
    }
    vec3 ramp4(float x, vec3 a, vec3 b, vec3 c, vec3 d) {
        x = clamp(x, 0.0, 1.0) * 3.0;
        return x < 1.0 ? mix(a, b, x) : (x < 2.0 ? mix(b, c, x - 1.0) : mix(c, d, x - 2.0));
    }
    // a sun: rho is the distance from its centre in its own (boiling) radii; gran the speck granulation.
    // The surface is never a smooth gradient: warped convection bands drift outward, cells boil, hot spots
    // wander, and the speck field's low cells read as dark lanes
    vec3 drawSun(vec3 col, float rho, float gran, vec2 uv, float t, float seed,
                 vec3 hot, vec3 mid, vec3 limb, vec3 lanes) {
        float fr = fwidth(rho);
        vec3 outc = col;
        if (rho < 1.25) {
            float core = 1.0 - smoothstep(1.0 - 1.5 * fr, 1.0 + 1.5 * fr, rho);
            float w = TDSimplexNoise(vec3(uv * 9.0 + seed, t * 0.25));
            float cells = TDSimplexNoise(vec3(uv * 48.0 + seed, t * 0.6));
            float bands = 0.5 + 0.5 * sin(rho * 13.0 + w * 4.5 - t * 0.8);
            float r = clamp(rho + 0.18 * w, 0.0, 1.0);
            vec3 s = mix(hot, mid, smoothstep(0.0, 0.6, r));
            s = mix(s, limb, smoothstep(0.7, 1.0, rho));
            s = mix(s, lanes, 0.35 * smoothstep(0.55, 0.95, bands) * smoothstep(0.15, 0.6, rho));
            s *= 0.78 + 0.32 * smoothstep(-0.4, 0.6, cells);
            // faculae: small, faint, warped flecks, strongest toward the limb
            s = mix(s, hot * 1.08, 0.2 * smoothstep(0.6, 0.92, TDSimplexNoise(vec3(uv * 34.0 + w * 0.8 + seed + 5.0, t * 0.35)))
                                 * (0.35 + 0.65 * smoothstep(0.3, 0.9, rho)));
            s = mix(lanes, s, 0.4 + 0.6 * gran);
            outc = mix(col, s, core);
            outc = mix(outc, SUMI, (1.0 - smoothstep(0.5 * fr, 1.6 * fr, abs(rho - 1.0))) * 0.85);
        }
        return outc;
    }

    void main() {
        vec2 uv = vUV.st;
        vec2 asp = vec2(uAspect.x, 1.0);
        vec2 pw = uv * asp;                               // world units
        vec2 px = uTD2DInfos[2].res.xy;                   // output-resolution texel (pigment is full res)
        float az = radians(uSun.x), el = radians(uSun.y);
        vec3 L = vec3(cos(el) * cos(az), cos(el) * sin(az), sin(el));
        float lv = uTide.x + uTide.y * sin(6.2831853 * uTide.z);

        vec4 t  = texture(sTD2DInputs[0], uv);
        vec4 g  = texture(sTD2DInputs[1], uv);
        vec4 pg = texture(sTD2DInputs[2], uv);
        vec4 gr = texture(sTD2DInputs[4], uv);
        // the specks live in a window around the sun at full density (uWin matches glsl_life)
        vec2 lw = (uv - uWin.xy) / uWin.z;
        float inWin = step(0.0, lw.x) * step(lw.x, 1.0) * step(0.0, lw.y) * step(lw.y, 1.0);
        vec2 sp = texture(sTD2DInputs[5], lw).rg * inWin;
        float heat = texture(sTD2DInputs[8], uv).r;

        vec2 e = 1.5 * px;
        float hs = uSun.z * 1.2;
        float hx = (HC(uv + vec2(e.x, 0.0)) - HC(uv - vec2(e.x, 0.0))) / (2.0 * e.x * asp.x);
        float hy = (HC(uv + vec2(0.0, e.y)) - HC(uv - vec2(0.0, e.y))) / (2.0 * e.y);
        vec3 N = normalize(vec3(-hx * hs, -hy * hs, 1.0));
        float h = t.r - uTide.w * pg.a;
        float depth = lv - h;
        float inW = smoothstep(0.0, 0.004, depth);

        // land: three printed tones from the relief lighting
        float shade = max(dot(N, L), 0.0) * g.a * 0.9;
        shade *= 0.85 + 0.3 * t.b;                        // paper tooth
        vec3 land = ramp4(bands(shade * 1.25, 3.0), SUMI, SAGE_D, mix(SAGE_L, PAPER, 0.4), PAPER);
        float ch = h * 34.0;
        float contour = 1.0 - smoothstep(0.4 * fwidth(ch), 1.3 * fwidth(ch), abs(fract(ch + 0.5) - 0.5));
        land = mix(land, SUMI, contour * 0.55);
        land = mix(land, SUMI, smoothstep(0.15, 0.7, pg.a) * 0.55);               // drainage trails
        land = mix(land, SUMI, clamp(gr.a * 1.6, 0.0, 1.0) * 0.6);                // running grains

        // water: sage by depth, three bands, lifted by the pool; paper silt wisps
        float wv = clamp(1.0 - depth * 5.0, 0.0, 1.0) * 0.75;
        vec3 water = ramp4(bands(wv, 3.0), mix(SUMI, SAGE_D, 0.5), SAGE_D, SAGE, SAGE_L);
        water = mix(water, mix(SAGE_L, PAPER, 0.7), (1.0 - exp(-pg.r * 0.9)) * 0.8);

        // the field sits far back: almost black, deep blues. Land and water keep only their value structure,
        // re-inked between space black and the faintest deep blue, so the suns and their fire carry everything
        const vec3 NIGHT = vec3(0.0001, 0.00012, 0.0003);
        const vec3 NAVY  = vec3(0.0018, 0.0036, 0.0140);
        land  = mix(NIGHT, NAVY, clamp(dot(land,  vec3(0.3, 0.55, 0.15)) * 1.3, 0.0, 1.0));
        water = mix(NIGHT, NAVY, clamp(dot(water, vec3(0.3, 0.55, 0.15)) * 1.3, 0.0, 1.0));
        // the streaks' light spills on the world around them in their own colours; water scatters it more
        vec3 spill = texture(sTD2DInputs[10], uv).rgb;
        land += spill * (0.1 + 0.8 * land);
        water += spill * (0.15 + 0.6 * water);

        // the substrate the specks have eaten leaves only a faint dark-red warmth
        water = mix(water, CORE * 0.6, smoothstep(0.12, 0.5, sp.y) * 0.2);

        // small specks stay crisp and bright, over everything but the suns (laid down after the water)
        vec2 mis = px * vec2(1.8, -1.3);
        float sR = texture(sTD2DInputs[5], lw + mis / uWin.z).r * inWin;
        vec3 speckInk = mix(ORANGE, mix(CITRUS, LEMON, 0.5), smoothstep(0.24, 0.36, sR));
        float speckM = smoothstep(0.07, 0.10, sR) * inW;

        vec3 col = mix(land, water, inW);
        // charred halo: whatever sits near the heat burns toward oxblood (never the organism itself)
        float scorch = smoothstep(0.15, 0.6, heat) * (1.0 - speckM);
        col = mix(col, mix(col * vec3(0.5, 0.22, 0.16), OXBLOOD, 0.45), scorch * 0.4);
        // the waterline as a keyline
        col = mix(col, NIGHT, (1.0 - smoothstep(0.5 * fwidth(depth), 1.6 * fwidth(depth), abs(depth))) * 0.9);

        // zero-g water (in7, the drops' merged field), lit by both suns as liquid: a deep sage body that swallows
        // what is behind it, warm light soaking in from the sun side, a fresnel rim, a white-hot glint toward each
        // sun, and the caustic crescent a lit drop focuses on its far side
        vec4 wf = texture(sTD2DInputs[7], uv);
        // the spray joins the field here at full resolution; a droplet's kernel never reaches past half a cell
        // (glsl_spray caps it), so a pixel only needs the 2x2 cells whose centres surround it
        float radSum = wf.a * wf.r;
        ivec2 gc = ivec2(floor(pw * 96.0 - 0.5));
        ivec2 gmax = ivec2(int(uTD2DInfos[12].res.z), 96);
        for (int kk = 0; kk < 4; kk++) {
            ivec2 c = gc + ivec2(kk & 1, kk >> 1);
            if (any(lessThan(c, ivec2(0))) || any(greaterThanEqual(c, gmax))) continue;
            vec4 A = texelFetch(sTD2DInputs[12], c, 0);
            if (A.z <= 0.0) continue;
            float R = A.z / 0.608;
            vec2 q = pw - A.xy;
            float x2 = dot(q, q) / (R * R);
            if (x2 >= 1.0) continue;
            float w = 1.0 - x2;
            wf.r += w * w * w;
            wf.gb -= 6.0 * w * w * q / R;
            radSum += w * w * w * R;
        }
        wf.a = radSum / max(wf.r, 1e-4);
        float fwW = fwidth(wf.r) + 1e-4;                   // derivatives outside the branch
        float wm = smoothstep(0.25 - fwW, 0.25 + fwW, wf.r);
        if (wf.r > 0.25 - 2.0 * fwW) {
            vec4 O0 = texelFetch(sTD2DInputs[11], ivec2(0, 0), 0);
            vec4 O2 = texelFetch(sTD2DInputs[11], ivec2(2, 0), 0);
            float hh = sqrt(max(wf.r - 0.25, 0.0) + 2e-3);
            vec3 n = normalize(vec3(-wf.gb * 0.3 / hh, 1.0));   // 0.3 keeps a lone drop's profile spherical
            float nl = length(n.xy);
            vec2 nd = n.xy / max(nl, 1e-4);
            vec2 t1 = O0.xy - pw, t2 = O0.zw - pw;
            float d1 = length(t1), d2 = length(t2);
            vec2 l1 = t1 / max(d1, 1e-4), l2 = t2 / max(d2, 1e-4);
            // the light falls off away from each limb
            float I1 = 1.0 / (1.0 + pow(max(d1 - O2.x, 0.0) / (O2.x * 0.8), 2.0));
            float I2 = 0.6 / (1.0 + pow(max(d2 - O2.y, 0.0) / (O2.y * 1.6), 2.0));
            vec3 L1 = normalize(vec3(l1, 0.4)), L2 = normalize(vec3(l2, 0.4));
            float thick = 1.0 - exp(-3.0 * max(wf.r - 0.25, 0.0));
            // a sphere of water is a lens: what lies behind it shows through inverted and magnified -- the dark
            // field, and the suns, moons and flares beside it. wf.a (the blended kernel radius) sizes the lens.
            vec2 ru = uv - n.xy * 1.8 * wf.a / asp;
            vec4 cr = texture(sTD2DInputs[6], ru);
            vec3 seen = col * 0.7;
            seen = mix(seen, mix(mix(HOT, ORANGE, 0.6), VERM, smoothstep(0.1, 1.0, cr.a)) * 0.55, 1.0 - smoothstep(0.96, 1.04, cr.a));   // dimmer than the sun itself
            seen = mix(seen, mix(CITRUS, ORANGE, smoothstep(0.1, 1.0, cr.g)) * 0.55, 1.0 - smoothstep(0.96, 1.04, cr.g));
            vec2 lr = (ru - uWin.xy) / uWin.z;
            float sRr = texture(sTD2DInputs[5], lr).r * step(0.0, lr.x) * step(lr.x, 1.0) * step(0.0, lr.y) * step(lr.y, 1.0);
            seen = mix(seen, mix(ORANGE, CITRUS, smoothstep(0.24, 0.36, sRr)), smoothstep(0.07, 0.10, sRr));
            // clear water, a little sage in the thick of it
            vec3 wc = seen * mix(vec3(0.85, 0.94, 0.96), vec3(0.5, 0.66, 0.68), thick) + SAGE_D * 0.04 * thick;
            wc += mix(CORE, VERM, I1) * I1 * I1 * thick * 0.08 * (0.3 + 0.7 * max(dot(nd, l1), 0.0));   // light soaking in
            wc += ORANGE * pow(max(dot(n, L1), 0.0), 4.0) * I1 * 0.07 + CITRUS * pow(max(dot(n, L2), 0.0), 4.0) * I2 * 0.06;
            float fres = 0.02 + 0.98 * pow(1.0 - n.z, 5.0);     // Schlick: the rim, not the face
            wc += fres * (SAGE_L * 0.05 + ORANGE * I1 * 1.1 * smoothstep(-0.3, 0.9, dot(nd, l1))
                                        + CITRUS * I2 * 0.9 * smoothstep(-0.3, 0.9, dot(nd, l2)));
            float band = smoothstep(0.55, 0.8, nl) * (1.0 - smoothstep(0.88, 0.98, nl));
            wc += (mix(ORANGE, CITRUS, 0.6) * I1 * pow(max(dot(nd, -l1), 0.0), 6.0)
                 + LEMON * I2 * pow(max(dot(nd, -l2), 0.0), 6.0)) * band * 0.6;
            vec3 hv1 = normalize(L1 + vec3(0.0, 0.0, 1.0)), hv2 = normalize(L2 + vec3(0.0, 0.0, 1.0));
            wc += HOT * pow(max(dot(n, hv1), 0.0), 140.0) * I1 * 2.5 + LEMON * pow(max(dot(n, hv2), 0.0), 140.0) * I2 * 2.0;
            col = mix(col, wc, wm);
        }
        col = mix(col, speckInk, speckM);

        // the two suns: the large one vermilion, the small one citrus. Each is white-hot at the centre with a
        // darkened limb, boiling with the speck layer's granulation, keylined in sumi like everything else
        vec4 cn = texture(sTD2DInputs[6], uv);
        float gran = smoothstep(0.1, 0.36, sp.x);
        col = drawSun(col, cn.a, gran, pw, uTime.x, 0.0, HOT, ORANGE, VERM, mix(VERM, CORE, 0.35));
        col = drawSun(col, cn.g, gran, pw, uTime.x * 1.3, 9.0, LEMON, CITRUS, ORANGE, mix(ORANGE, VERM, 0.6));

        // colour explosions where they collide, as plasma on the golden ramp: a soft deep-red front, vermilion,
        // a citrus body, a lemon heart -- never screened
        float E = pg.g;
        vec3 burst = mix(CORE, VERM, smoothstep(0.03, 0.12, E));
        burst = mix(burst, CITRUS, smoothstep(0.18, 0.35, E));
        burst = mix(burst, LEMON, smoothstep(0.5, 0.85, E));
        burst *= 0.7 + 0.55 * smoothstep(0.05, 0.3, sp.x);   // the fine field textures it from inside
        col = mix(col, burst, smoothstep(0.02, 0.3, E) * 0.85);

        // electric light streaks: their per-channel falloff (blue fades first, red last) picks the ink --
        // lemon at the head, citrus gold, then orange and vermilion down the tail
        // a slightly softened read of the streak buffer: fresh bright heads clear the threshold wide, fading
        // tails only along their spine -- so every streak tapers from a fat head to a hairline tail
        vec3 stk = 0.4 * texture(sTD2DInputs[9], uv).rgb
                 + 0.15 * (texture(sTD2DInputs[9], uv + vec2(px.x, 0.0)).rgb + texture(sTD2DInputs[9], uv - vec2(px.x, 0.0)).rgb
                         + texture(sTD2DInputs[9], uv + vec2(0.0, px.y)).rgb + texture(sTD2DInputs[9], uv - vec2(0.0, px.y)).rgb);
        float sa = max(stk.r, max(stk.g, stk.b));
        float sg = stk.g / max(stk.r, 1e-4), sb = stk.b / max(stk.r, 1e-4);
        vec3 sInk = mix(mix(VERM, ORANGE, smoothstep(0.1, 0.4, sg)), CITRUS, smoothstep(0.45, 0.8, sg));
        sInk = mix(sInk, LEMON, smoothstep(0.4, 0.9, sb));
        col = mix(col, sInk, smoothstep(0.06, 0.35, sa) * 0.85);
        fragColor = TDOutputSwizzle(vec4(col, 1.0));
    }
  dat_content_format: text
- name: glsl_pigment_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [3125, -1720]
  dock: glsl_pigment
  dat_content: |
    // full-resolution transport, one pass. r = silt: rides the water (sharp Catmull-Rom backtrace), clouds
    // the shallow fringe where runoff grains arrive, lifts off the bed in eddy cores, settles out of still
    // water. g = colour explosions released where the two suns touch. a = grain trails: engraved in the
    // ground, so they ride the collapse, not the water. b unused.
    // in0: previous pigment, in1: flow (xy uv/frame, z wet, w speed uv/s), in2: terrain, in3: rendered grains,
    // in4: solver state (z = vorticity, > 1e5 on land), in5: glsl_orbit
    uniform vec4 uPig;    // x silt pickup, y trail deposit
    uniform vec4 uTide;   // x mean level, y range, z cycles
    uniform vec4 uWorld;  // y twist (radians per octave), z collapse (octaves per second)
    uniform vec4 uBurst;  // x colour-explosion strength
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    const vec2 OUTLET_UV = vec2(0.34, 0.31);

    float catmullRomR(vec2 uv, vec2 size) {
        vec2 sp = uv * size;
        vec2 p1 = floor(sp - 0.5) + 0.5;
        vec2 f = sp - p1;
        vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
        vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
        vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
        vec2 w3 = f * f * (-0.5 + 0.5 * f);
        vec2 w12 = w1 + w2;
        vec2 p0 = (p1 - 1.0) / size, p3 = (p1 + 2.0) / size, p12 = (p1 + w2 / w12) / size;
        return texture(sTD2DInputs[0], vec2(p0.x, p0.y)).r * w0.x * w0.y
             + texture(sTD2DInputs[0], vec2(p12.x, p0.y)).r * w12.x * w0.y
             + texture(sTD2DInputs[0], vec2(p3.x, p0.y)).r * w3.x * w0.y
             + texture(sTD2DInputs[0], vec2(p0.x, p12.y)).r * w0.x * w12.y
             + texture(sTD2DInputs[0], vec2(p12.x, p12.y)).r * w12.x * w12.y
             + texture(sTD2DInputs[0], vec2(p3.x, p12.y)).r * w3.x * w12.y
             + texture(sTD2DInputs[0], vec2(p0.x, p3.y)).r * w0.x * w3.y
             + texture(sTD2DInputs[0], vec2(p12.x, p3.y)).r * w12.x * w3.y
             + texture(sTD2DInputs[0], vec2(p3.x, p3.y)).r * w3.x * w3.y;
    }

    void main() {
        vec2 uv = vUV.st;
        vec2 asp = vec2(uAspect.x, 1.0);
        vec2 size = uTD2DInfos[0].res.zw;
        vec4 F = texture(sTD2DInputs[1], uv);
        float lv = uTide.x + uTide.y * sin(6.2831853 * uTide.z);
        float depth = lv - texture(sTD2DInputs[2], uv).r;
        float wet = F.z;
        float speed = F.w;
        float grains = texture(sTD2DInputs[3], uv).a;
        float vz = texture(sTD2DInputs[4], uv).z;
        float vort = vz > 1e3 ? 0.0 : abs(vz);

        float fringe = wet * (1.0 - smoothstep(0.0, 0.03, depth));
        float silt = max(catmullRomR(uv - F.xy, size), 0.0);
        silt += uPig.x * (1.5 * grains * fringe + 0.6 * wet * smoothstep(6.0, 18.0, vort));
        silt *= 0.99 - 0.006 * (1.0 - smoothstep(0.02, 0.1, speed));
        silt *= mix(0.9, 1.0, wet);

        vec2 dd = (uv - OUTLET_UV) * asp;
        vec2 world = -uWorld.z * (0.6931472 * dd + uWorld.y * vec2(-dd.y, dd.x)) / 60.0 / asp;   // world velocity, as uv per frame
        float trail = texture(sTD2DInputs[0], uv - world).a * 0.9985 + uPig.y * grains;

        // colour explosions: each impact of the two suns releases a burst between them (glsl_orbit envelope);
        // it grows outward by a decaying dilation (a slow-motion shock front, ~1.4 px a frame) and rides the flow
        vec4 pos = texelFetch(sTD2DInputs[5], ivec2(0, 0), 0);
        vec4 rad = texelFetch(sTD2DInputs[5], ivec2(2, 0), 0);
        vec2 dc = uv * asp - mix(pos.xy, pos.zw, rad.x / (rad.x + rad.y));
        float inject = uBurst.x * rad.w * exp(-dot(dc, dc) / (0.025 * 0.025)) * 0.12;
        vec2 back = uv - F.xy;
        float front = 0.0;
        for (int k = 0; k < 8; k++) {
            float a = float(k) * 0.7853982;
            front = max(front, texture(sTD2DInputs[0], back + vec2(cos(a), sin(a)) * 1.4 / size).g);
        }
        float burst = max(texture(sTD2DInputs[0], back).g * 0.993, front * 0.982) + inject;

        float drain = smoothstep(0.004, 0.05, length(dd));
        fragColor = TDOutputSwizzle(vec4(min(silt, 3.0), min(burst, 2.0), 0.0, min(trail, 1.0)) * drain);
    }
  dat_content_format: text
- name: glsl_pressure_info
  type: infoDAT
  parameters:
    op: glsl_pressure
  position: [1275, -920]
  dock: glsl_pressure
  dat_read_only: true
- name: glsl_project_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [1525, -920]
  dock: glsl_project
  dat_content: |
    // subtract the pressure gradient so the water stays incompressible, then publish the flow field:
    // the incompressible current plus the downhill drift over the carved terrain (which converges into
    // the valleys -- that convergence is what gathers the grains into a drainage tree).
    // in0: pressure solve, in1: terrain, in2: previous pigment (a = grain trails)
    // out0: solver state for the feedback; out1: flow = xy velocity in uv per frame (what samplers need),
    // z wet, w speed (world units per second; height 1, width = aspect)
    uniform vec4 uTide;   // x mean level, y range, z cycles, w carve depth
    uniform vec4 uRun;    // x runoff speed (uv/s per unit slope), y runoff fraction on dry land
    uniform vec4 uWorld;  // y twist (radians per octave), z collapse (octaves per second)
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x

    const vec2 OUTLET_UV = vec2(0.34, 0.31);
    layout(location = 0) out vec4 fragState;
    layout(location = 1) out vec4 fragFlow;

    float lv;
    float wet(vec2 uv) { return step(texture(sTD2DInputs[1], uv).r, lv); }
    float H(vec2 uv) { return texture(sTD2DInputs[1], uv).r - uTide.w * texture(sTD2DInputs[2], uv).a; }

    void main() {
        vec2 uv = vUV.st;
        vec2 tx = uTD2DInfos[0].res.xy;
        vec2 dx = vec2(tx.x, 0.0), dy = vec2(0.0, tx.y);
        vec2 asp = vec2(uAspect.x, 1.0);
        vec2 tw = tx * asp;
        lv = uTide.x + uTide.y * sin(6.2831853 * uTide.z);
        vec4 c = texture(sTD2DInputs[0], uv);
        float pL = mix(c.w, texture(sTD2DInputs[0], uv - dx).w, wet(uv - dx));
        float pR = mix(c.w, texture(sTD2DInputs[0], uv + dx).w, wet(uv + dx));
        float pB = mix(c.w, texture(sTD2DInputs[0], uv - dy).w, wet(uv - dy));
        float pT = mix(c.w, texture(sTD2DInputs[0], uv + dy).w, wet(uv + dy));
        float w = wet(uv);
        vec2 u = (c.xy - vec2((pR - pL) / (2.0 * tw.x), (pT - pB) / (2.0 * tw.y))) * w;
        fragState = vec4(u, c.z, c.w);

        // two-scale slope: the coarse term steps over the small pits the fine noise leaves
        vec2 e = 1.5 * tx, E = 8.0 * tx;
        vec2 gf = vec2(H(uv + vec2(e.x, 0.0)) - H(uv - vec2(e.x, 0.0)),
                       H(uv + vec2(0.0, e.y)) - H(uv - vec2(0.0, e.y))) / (2.0 * e * asp);
        vec2 gc = vec2(H(uv + vec2(E.x, 0.0)) - H(uv - vec2(E.x, 0.0)),
                       H(uv + vec2(0.0, E.y)) - H(uv - vec2(0.0, E.y))) / (2.0 * E * asp);
        vec2 gh = 0.35 * gf + 0.65 * gc;
        float soft = smoothstep(0.0, 0.006, lv - texture(sTD2DInputs[1], uv).r);
        vec2 down = -gh * uRun.x * mix(uRun.y, 1.0, soft);
        // the ground itself caves in along the log spiral; everything riding on it moves with it
        vec2 dd = (uv - OUTLET_UV) * asp;
        vec2 world = -uWorld.z * (0.6931472 * dd + uWorld.y * vec2(-dd.y, dd.x));
        vec2 v = u + down + world;
        fragFlow = vec4(v / asp / 60.0, soft, length(v));
    }
  dat_content_format: text
- name: glsl_streaks_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [3525, -4120]
  dock: glsl_streaks
  dat_content: |
    // the streak buffer: this frame's sparks are stamped in at full white, and the trails live in the world.
    // Over water they ride the currents and bleed outward a little, and the water swallows red first, so a
    // submerged trail dims a little faster; on land they burn in and stay put. Each channel fades at its own
    // rate -- blue first, then green, red last -- so a streak cools white -> gold -> orange -> red; the
    // compose maps that falloff onto the golden inks and lets its blurred light spill on the world.
    // in0: previous streaks (feedback), in1: rendered sparks, in2: flow (xy uv/frame, z wet)
    uniform vec4 uStreak;   // x red, y green, z blue decay per frame (red slowest)
    layout(location = 0) out vec4 fragColor;

    void main() {
        vec2 uv = vUV.st;
        vec2 px = uTD2DInfos[0].res.xy;
        vec4 F = texture(sTD2DInputs[2], uv);
        float wet = F.z;
        vec2 back = uv - F.xy * wet * 0.35;               // the water carries them, gently
        vec3 c = texture(sTD2DInputs[0], back).rgb;
        vec3 nb = 0.25 * (texture(sTD2DInputs[0], back + vec2(px.x, 0.0)).rgb + texture(sTD2DInputs[0], back - vec2(px.x, 0.0)).rgb
                        + texture(sTD2DInputs[0], back + vec2(0.0, px.y)).rgb + texture(sTD2DInputs[0], back - vec2(0.0, px.y)).rgb);
        c = mix(c, nb, 0.06 * wet);                       // a trace of bleed through the water
        vec3 decay = mix(uStreak.xyz, uStreak.xyz * vec3(0.996, 0.997, 0.997), wet);   // the water dims them a little
        c *= min(decay, vec3(0.9995));
        float s = min(texture(sTD2DInputs[1], uv).a * 1.5, 1.0);
        fragColor = TDOutputSwizzle(vec4(max(c, vec3(s)), 1.0));
    }
  dat_content_format: text
- name: glsl_terrain_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [-75, -120]
  dock: glsl_terrain
  dat_content: |
    // the world, re-evaluated every frame: a fractal heightfield that endlessly caves in toward the drain
    // at OUTLET along a logarithmic spiral. Three zoom layers sample the same evolving, domain-warped fbm one
    // octave apart; as the zoom phase advances each layer grows into the next (fade weights sum to 1.5 at
    // every phase), so structure is born large at the edges, shrinks into the drain and dissolves, and the
    // detail never blurs. Every octave is band-limited against the pixel footprint.
    // out: r = height, g = fault creases, b = fine grain, a = macro variation
    uniform vec4 uWorld;   // x zoom phase (octaves), y twist (radians per octave), z warp amount, w morph time
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    const vec2 OUTLET_UV = vec2(0.34, 0.31);
    const mat2 OCT = mat2(1.6, 1.2, -1.2, 1.6);
    const float PI = 3.14159265;

    float fbm(vec2 p, int oct, float fp) {
        float a = 0.5, s = 0.0;
        for (int i = 0; i < 6; i++) {
            if (i >= oct) break;
            s += a * TDSimplexNoise(p) * (1.0 - smoothstep(0.2, 0.45, fp));
            p = OCT * p + 3.17;
            a *= 0.5;
            fp *= 2.0;
        }
        return s;
    }
    float fbm3(vec3 p, int oct, float fp) {
        float a = 0.5, s = 0.0;
        for (int i = 0; i < 4; i++) {
            if (i >= oct) break;
            s += a * TDSimplexNoise(p) * (1.0 - smoothstep(0.2, 0.45, fp));
            p = vec3(OCT * p.xy + 3.17, p.z * 1.6 + 1.3);
            a *= 0.5;
            fp *= 2.0;
        }
        return s;
    }

    void main() {
        vec2 uv = vUV.st;
        float px = uTDOutputInfo.res.y;                       // one pixel in world units
        vec2 d = (uv - OUTLET_UV) * vec2(uAspect.x, 1.0);     // world units: the world stays isotropic at any aspect
        float ph = fract(uWorld.x);
        float h = 0.0, crease = 0.0, grain = 0.0, macro = 0.0;
        for (int j = 0; j < 3; j++) {
            float lg = ph + float(j);                         // 0..3 across the three layers
            float s = exp2(lg - 1.0) * 2.2;                   // world units per screen unit
            float a = uWorld.y * (lg - 1.0);                  // log-spiral: rotation follows scale
            vec2 w = mat2(cos(a), sin(a), -sin(a), cos(a)) * d * s;
            float fp = px * s;                                // one pixel in world units
            float fade = sin(PI * lg / 3.0);
            fade *= fade;
            float amp = exp2(-0.6 * lg);                      // finer layers carry less relief
            vec2 warp = vec2(fbm3(vec3(w * 1.1 + 1.7, uWorld.w), 2, fp * 1.1),
                             fbm3(vec3(w * 1.1 + 9.2, uWorld.w + 4.0), 2, fp * 1.1));
            vec2 q = w + uWorld.z * 0.55 * warp;
            float n = fbm(q * 1.3, 4, fp * 1.3);
            float cr = 1.0 - smoothstep(0.0, 0.07, abs(fbm(q * 2.4 + 4.0, 3, fp * 2.4)));
            cr *= 1.0 - smoothstep(0.15, 0.4, fp * 2.4 * 6.0);   // creases fade before they alias
            h += fade * amp * (n - 0.10 * cr);
            crease = max(crease, cr * fade);
            grain += fade * fbm(w * 55.0, 2, fp * 55.0);
            macro += fade * fbm(w * 0.9 + 3.3, 2, fp * 0.9);
        }
        h *= 1.1;
        grain = 0.5 + 0.3 * grain;
        macro *= 0.667;
        // the drain is fixed on screen: everything slopes into it and sinks there
        float r = length(d);
        h += 0.75 * pow(r, 0.85) - 0.25 * exp(-r * r / (0.08 * 0.08));
        fragColor = TDOutputSwizzle(vec4(h, crease, grain, macro));
    }
  dat_content_format: text
- name: glsl_flow_step_info
  type: infoDAT
  parameters:
    op: glsl_flow_step
  position: [875, -920]
  dock: glsl_flow_step
  dat_read_only: true
- name: glsl_pressure_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [1125, -920]
  dock: glsl_pressure
  dat_content: |
    // Jacobi pressure iterations (one per pass, npasses per frame); land cells are walls (Neumann).
    // wet/dry comes from the z sentinel the flow step writes (z > 1e5 = land), so a pass reads only
    // the five state samples it needs -- no terrain fetches.
    // in0: flow step, then the previous pass (xy velocity, z vorticity or land sentinel, w pressure)
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    float wetOf(vec4 s) { return step(s.z, 1e5); }

    void main() {
        vec2 uv = vUV.st;
        vec2 tx = uTD2DInfos[0].res.xy;
        vec2 dx = vec2(tx.x, 0.0), dy = vec2(0.0, tx.y);
        vec2 tw = tx * vec2(uAspect.x, 1.0);                // one texel in world units
        vec4 c = texture(sTD2DInputs[0], uv);
        if (c.z > 1e5) {
            fragColor = vec4(c.xyz, 0.0);
            return;
        }
        vec4 L = texture(sTD2DInputs[0], uv - dx), R = texture(sTD2DInputs[0], uv + dx);
        vec4 B = texture(sTD2DInputs[0], uv - dy), T = texture(sTD2DInputs[0], uv + dy);
        float pL = mix(c.w, L.w, wetOf(L)), pR = mix(c.w, R.w, wetOf(R));
        float pB = mix(c.w, B.w, wetOf(B)), pT = mix(c.w, T.w, wetOf(T));
        float div = (R.x - L.x) / (2.0 * tw.x) + (T.y - B.y) / (2.0 * tw.y);
        float p = (pL + pR + pB + pT - div * tw.x * tw.y) * 0.25;
        fragColor = vec4(c.xyz, p);
    }
  dat_content_format: text
- name: glsl_flow_step_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [725, -920]
  dock: glsl_flow_step
  dat_content: |
    // one solver step for the open water, velocity in world units per second (height 1, width = aspect):
    // self-advection, curl-noise stirring, downhill jets where water meets slope, vorticity confinement.
    // land is a wall. out: xy = velocity, z = vorticity (read next frame), w = pressure (warm start)
    // in0: previous state, in1: stream function, in2: terrain, in3: previous pigment (a = grain trails),
    // in4: glsl_orbit (sun positions, velocities, radii)
    uniform vec4 uFlow;   // x swirl, y jets, z damping per frame, w vorticity confinement
    uniform vec4 uTide;   // x mean level, y range, z cycles (seconds / period), w carve depth
    uniform vec4 uStir;   // x how hard the moving suns drag the water (relaxation per frame)
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    const float DT = 1.0 / 60.0;

    float WZ(vec4 s) { return s.z > 1e5 ? 0.0 : abs(s.z); }
    float H(vec2 uv) { return texture(sTD2DInputs[2], uv).r - uTide.w * texture(sTD2DInputs[3], uv).a; }

    void main() {
        vec2 uv = vUV.st;
        vec2 tx = uTD2DInfos[0].res.xy;
        vec2 dx = vec2(tx.x, 0.0), dy = vec2(0.0, tx.y);
        vec2 asp = vec2(uAspect.x, 1.0);
        vec2 tw = tx * asp;                                    // one texel in world units
        float lv = uTide.x + uTide.y * sin(6.2831853 * uTide.z);

        vec4 s  = texture(sTD2DInputs[0], uv);
        vec4 sL = texture(sTD2DInputs[0], uv - dx), sR = texture(sTD2DInputs[0], uv + dx);
        vec4 sB = texture(sTD2DInputs[0], uv - dy), sT = texture(sTD2DInputs[0], uv + dy);

        // semi-Lagrangian self-advection
        vec2 u = texture(sTD2DInputs[0], uv - s.xy * DT / asp).xy * uFlow.z;

        // curl-noise stirring (divergence-free by construction)
        float pL = texture(sTD2DInputs[1], uv - dx).r, pR = texture(sTD2DInputs[1], uv + dx).r;
        float pB = texture(sTD2DInputs[1], uv - dy).r, pT = texture(sTD2DInputs[1], uv + dy).r;
        u += vec2((pT - pB) / (2.0 * tw.y), (pL - pR) / (2.0 * tw.x)) * uFlow.x;

        // channels discharging downhill into the water set off jets
        float wet = step(texture(sTD2DInputs[2], uv).r, lv);
        vec2 gh = vec2(H(uv + dx) - H(uv - dx), H(uv + dy) - H(uv - dy)) / (2.0 * tw);
        u -= gh * uFlow.y;

        // vorticity confinement from last frame's curl (z > 1e5 marks land)
        vec2 gw = vec2(WZ(sR) - WZ(sL), WZ(sT) - WZ(sB));
        float gl = length(gw);
        if (gl > 1e-6) {
            vec2 N = gw / gl;
            u += uFlow.w * tw.y * vec2(N.y, -N.x) * (s.z > 1e5 ? 0.0 : s.z);
        }

        // the suns drag the water they move through, leaving swirling wakes
        vec4 sunPos = texelFetch(sTD2DInputs[4], ivec2(0, 0), 0);
        vec4 sunVel = texelFetch(sTD2DInputs[4], ivec2(1, 0), 0);
        vec4 sunRad = texelFetch(sTD2DInputs[4], ivec2(2, 0), 0);
        float mL = 1.0 - smoothstep(sunRad.x * 0.8, sunRad.x * 1.8, length(uv * asp - sunPos.xy));
        float mS = 1.0 - smoothstep(sunRad.y * 0.8, sunRad.y * 2.2, length(uv * asp - sunPos.zw));
        u += uStir.x * (mL * (sunVel.xy - u) + mS * (sunVel.zw - u));

        float omega = (sR.y - sL.y) / (2.0 * tw.x) - (sT.x - sB.x) / (2.0 * tw.y);
        float sp = length(u);
        if (sp > 0.2) u *= 0.2 / sp;            // CFL guard
        u *= wet;
        // land carries a sentinel in z so the pressure passes read wet/dry from samples they already take
        fragColor = vec4(u, wet > 0.5 ? omega : 1e6, s.w);
    }
  dat_content_format: text
