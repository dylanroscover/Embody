- name: glsl_drops_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [2325, -3720]
  dock: glsl_drops
  dat_content: |
    // zero-g water: N drops in a power-law spread of sizes, from globs two thirds of the large sun's radius down to
    // fine droplets. Every drop falls toward the large sun and settles against its limb; drag keeps the fall
    // overdamped, so drops creep home instead of orbiting. Now and then a drop at the sun is flung off (its own
    // timer, or a collision between the suns throwing the water near the contact), drifts out on the currents and
    // slowly finds its way back. The small sun ploughs through them; drops shoulder each other apart.
    // row 0: xy position (world units: height 1, width = aspect), z radius, w wobble stretch -- all the field needs to cull, in one fetch
    // row 1: xy velocity (world units per second), z wobble axis (radians), w fling epoch + 1 (0 = not seeded yet)
    // row 2: x splash (summed |dv| from hits this frame), yz the direction the hits push the water, w x position
    // (row 2 is read back by topto_drops for the water sounds)
    // in0: previous state, in1: glsl_orbit (texel 0 positions, texel 2 radii/contact/env), in2: flow (xy uv/frame)
    uniform vec4 uDrops;   // x seconds, y size scale, z pull, w fling rate
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    #define N 80
    const float RMAX = 0.17, RMIN = 0.0016;

    uint ih(uint x) { x ^= x >> 16; x *= 0x7feb352dU; x ^= x >> 15; x *= 0x846ca68bU; x ^= x >> 16; return x; }
    float hash(int i, uint salt) { return float(ih(uint(i) * 747796405U + salt * 2891336453U) & 0xffffffU) / 16777215.0; }
    // a few big globs, many fine droplets
    float radiusOf(int i) { return RMAX * pow(RMIN / RMAX, pow(float(i) / float(N - 1), 0.6)) * uDrops.y; }

    void main() {
        int i = int(gl_FragCoord.x), row = int(gl_FragCoord.y);
        float t = uDrops.x, dt = 1.0 / 60.0;
        vec2 asp = vec2(uAspect.x, 1.0);
        float r = radiusOf(i);
        float big = smoothstep(0.005, 0.12, r);
        // each drop's own fling clock: small drops come off more often than the big globs
        float period = mix(10.0, 40.0, hash(i, 7U)) * mix(0.7, 2.0, big) / max(uDrops.w, 1e-3);
        float epoch = floor(t / period + hash(i, 8U));
        // area-preserving wobble along a slowly turning axis; small drops ring fast, big ones slosh slowly
        float om = clamp(1.6 * sqrt(0.03 / r), 0.5, 8.0);
        float wob = mix(0.05, 0.13, big) * sin(om * t + 6.28 * hash(i, 3U)) * (0.65 + 0.35 * sin(0.31 * om * t + 6.28 * hash(i, 4U)));
        float axis = 6.28 * hash(i, 5U) + t * 0.15 * (hash(i, 6U) - 0.5);
        vec4 S0 = texelFetch(sTD2DInputs[0], ivec2(i, 0), 0);
        vec4 S1 = texelFetch(sTD2DInputs[0], ivec2(i, 1), 0);
        float last = S1.w;
        vec4 O0 = texelFetch(sTD2DInputs[1], ivec2(0, 0), 0);
        vec4 O2 = texelFetch(sTD2DInputs[1], ivec2(2, 0), 0);
        vec2 p1 = O0.xy, p2 = O0.zw;
        float r1 = O2.x, r2 = O2.y, env = O2.w;
        vec2 p = S0.xy, v = S1.xy;
        if (last < 0.5) {                                // first frame: scatter them around the large sun
            float a = 6.2831853 * hash(i, 1U);
            p = p1 + (r1 + r * 0.6 + 0.03 + 0.3 * hash(i, 2U)) * vec2(cos(a), sin(a));
            v = vec2(0.0);
        }
        vec2 dp = p - p1;
        float d = length(dp) + 1e-5;
        vec2 nr = dp / d, tg = vec2(-nr.y, nr.x);
        float rest = r1 + r * 0.55;                      // it settles a little into the limb, wetting it
        vec2 acc = -nr * 0.07 * uDrops.z;                // the pull home: constant, so far drops still return
        float splash = 0.0;
        vec2 sdir = vec2(0.0);
        if (d < rest) {                                  // the limb holds them; inward speed is soaked up
            acc += nr * (rest - d) * 60.0;
            v -= nr * min(dot(v, nr), 0.0) * 0.25;
        }
        // at the sun each drop creeps along the limb its own way; everywhere a slow drift
        float near = 1.0 - smoothstep(0.0, 0.06, d - rest);
        acc += tg * 0.04 * TDSimplexNoise(vec2(float(i) * 1.37, t * 0.07)) * near;
        acc += 0.025 * vec2(TDSimplexNoise(vec3(p * 3.0, t * 0.05)), TDSimplexNoise(vec3(p * 3.0 + 17.0, t * 0.05)));
        if (last > 0.5 && epoch + 1.0 != last && near > 0.5) {
            float sp = mix(0.08, 0.22, hash(i, uint(epoch) + 9U)) * mix(1.3, 0.6, big);
            vec2 fd = normalize(nr + tg * (hash(i, uint(epoch) + 11U) - 0.5) * 1.2);
            v += sp * fd;
            splash += sp; sdir += fd * sp;
        }
        // a collision between the suns throws the water near the contact
        vec2 dc = p - (p1 + normalize(p2 - p1 + 1e-5) * r1);
        float kick = env * env * exp(-dot(dc, dc) / 0.03) * mix(1.3, 0.5, big);
        acc += normalize(dc + 1e-5) * kick;
        splash += kick * dt * 4.0; sdir += normalize(dc + 1e-5) * kick * dt * 4.0;
        // the small sun ploughs through
        vec2 d2v = p - p2;
        float d2 = length(d2v) + 1e-5, rest2 = r2 + r * 0.8;
        if (d2 < rest2) {
            acc += d2v / d2 * (rest2 - d2) * 80.0;
            float pl = (rest2 - d2) / rest2 * length(texelFetch(sTD2DInputs[1], ivec2(1, 0), 0).zw - v) * 0.3;
            splash += pl; sdir += d2v / d2 * pl;
        }
        // drops shoulder each other apart, the heavier one moving less
        for (int j = 0; j < N; j++) {
            if (j == i) continue;
            vec2 q = p - texelFetch(sTD2DInputs[0], ivec2(j, 0), 0).xy;
            float rj = radiusOf(j);
            float dd = length(q) + 1e-5, rr = (r + rj) * 0.85;
            if (dd < rr) {
                float mw = rj * rj / (r * r + rj * rj);
                acc += q / dd * (rr - dd) * 25.0 * mw;
                float slam = max(dot(texelFetch(sTD2DInputs[0], ivec2(j, 1), 0).xy - v, q / dd), 0.0) * mw * 0.4;
                splash += slam; sdir += q / dd * slam;
            }
        }
        acc += (texture(sTD2DInputs[2], p / asp).xy * 60.0 * asp - v) * 0.25;   // the currents carry them a little
        acc += (clamp(p, vec2(-0.04), asp + 0.04) - p) * 6.0;                  // soft frame walls
        v = (v + acc * dt) * exp(-1.3 * dt);
        float spd = length(v);
        if (spd > 0.6) v *= 0.6 / spd;
        p += v * dt;
        if (row == 0) fragColor = vec4(p, r, wob);
        else if (row == 1) fragColor = vec4(v, axis, epoch + 1.0);
        else fragColor = vec4(splash, sdir / max(length(sdir), 1e-5), p.x);
    }
  dat_content_format: text
