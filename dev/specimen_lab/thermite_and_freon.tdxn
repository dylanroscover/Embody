- name: glsl_heat_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [4725, -2520]
  dock: glsl_heat
  dat_content: |
    // heat: how molten each spot is -- the speck layer plus the substrate it has eaten.
    // blur_heat spreads it; the compose scorches with it, the finish glows and melts with it.
    // in0: specks (r V, g eaten; see uWin), in1: pigment (g bursts), in2: light streaks
    uniform vec4 uWin;    // the speck field's window: xy frame-uv origin, z size (matches glsl_life)
    layout(location = 0) out vec4 fragColor;

    void main() {
        vec2 uv = vUV.st;
        vec2 lw = (uv - uWin.xy) / uWin.z;
        float inWin = step(0.0, lw.x) * step(lw.x, 1.0) * step(0.0, lw.y) * step(lw.y, 1.0);
        vec2 a = texture(sTD2DInputs[0], lw).rg * inWin;
        float h = smoothstep(0.05, 0.3, a.r) + 0.15 * a.g;
        h += 0.6 * texture(sTD2DInputs[1], uv).g;          // the colour explosions burn too
        vec3 stk = texture(sTD2DInputs[2], uv).rgb;
        h += 0.3 * max(stk.r, max(stk.g, stk.b));         // and the light streaks
        fragColor = vec4(h, h, h, 1.0);
    }
  dat_content_format: text
- name: glsl_life_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [3925, -2120]
  dock: glsl_life
  dat_content: |
    // the sun's flares: tiny filaments, sparks and granulation at full output density (uWin can window the field
    // around the sun; 0,0,1 covers the whole frame).
    // The core (canopy a < 1) is held molten and the Gray-Scott feed falls off with distance from it, so the
    // only pattern that can grow is fingers erupting from the rim: flares, which the flow then drags into arcs
    // and loops. Inside the core it boils as granulation.
    // pass 0 advects with the flow (sharp Catmull-Rom backtrace), holds the core and sparks the rim;
    // passes 1..N react and diffuse.
    // r = V, g = substrate depletion S (U = 1 - S, so the black seed is clean substrate)
    // in0: previous state, then the previous pass; in1: flow (xy uv/frame); in2: canopy (r limb activity,
    // g / a distance from the small / large sun in its own radii, b log2 pattern scale)
    uniform vec4 uLife;   // x rim sparks, y spark frequency, z scale-map amplitude, w flare reach (core radii)
    uniform vec4 uRD;     // x feed bias, y kill bias, z stencil stretch (texels)
    uniform vec4 uTime;   // x seconds
    uniform vec4 uWin;    // xy frame-uv origin of this field, z its size in frame uv (0,0,1 = whole frame)
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    vec2 catmullRom(vec2 uv, vec2 size) {
        vec2 sp = uv * size;
        vec2 p1 = floor(sp - 0.5) + 0.5;
        vec2 f = sp - p1;
        vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
        vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
        vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
        vec2 w3 = f * f * (-0.5 + 0.5 * f);
        vec2 w12 = w1 + w2;
        vec2 p0 = (p1 - 1.0) / size, p3 = (p1 + 2.0) / size, p12 = (p1 + w2 / w12) / size;
        return (texture(sTD2DInputs[0], vec2(p0.x, p0.y)) * w0.x * w0.y
              + texture(sTD2DInputs[0], vec2(p12.x, p0.y)) * w12.x * w0.y
              + texture(sTD2DInputs[0], vec2(p3.x, p0.y)) * w3.x * w0.y
              + texture(sTD2DInputs[0], vec2(p0.x, p12.y)) * w0.x * w12.y
              + texture(sTD2DInputs[0], vec2(p12.x, p12.y)) * w12.x * w12.y
              + texture(sTD2DInputs[0], vec2(p3.x, p12.y)) * w3.x * w12.y
              + texture(sTD2DInputs[0], vec2(p0.x, p3.y)) * w0.x * w3.y
              + texture(sTD2DInputs[0], vec2(p12.x, p3.y)) * w12.x * w3.y
              + texture(sTD2DInputs[0], vec2(p3.x, p3.y)) * w3.x * w3.y).rg;
    }

    void main() {
        vec2 uv = vUV.st;                                  // this field's own coordinates
        vec2 g = uWin.xy + uv * uWin.z;                    // the same point in frame uv
        vec2 gw = g * vec2(uAspect.x, 1.0);                // and in world units, for isotropic noise
        vec2 size = uTD2DInfos[0].res.zw;
        vec2 tx = uTD2DInfos[0].res.xy;
        vec4 cn = texture(sTD2DInputs[2], g);
        float rho = min(cn.a, cn.g);                       // the nearer sun, in its own radii
        float reach = smoothstep(1.0, uLife.w, rho);       // 0 at the rim, 1 at the end of the flare zone

        if (uTDPass == 0) {
            vec2 adv = clamp(catmullRom(uv - texture(sTD2DInputs[1], g).xy / uWin.z, size), 0.0, 1.0);
            // the core is re-lit through boiling cells, not a flat fill, so the reaction-diffusion has
            // structure to work on and the surface reads as granulation
            float cells = smoothstep(0.1, 0.45, TDSimplexNoise(vec3(gw * uLife.y * 0.9, uTime.x * 0.8)));
            float core = (1.0 - smoothstep(0.75, 1.0, rho)) * cells;
            float rim = smoothstep(0.85, 1.05, rho) * (1.0 - smoothstep(1.05, 1.9, rho)) * cn.r;   // active regions only
            float spark = smoothstep(0.86 - 0.03 * uLife.x, 0.9 - 0.03 * uLife.x,
                                     TDSimplexNoise(vec3(gw * uLife.y, uTime.x * 1.5))) * rim;
            float V = max(adv.r, 0.38 * max(core, spark));
            float S = max(adv.g, 0.55 * max(core, spark));
            // nothing survives past the reach, nor at the edge of a windowed field
            vec2 wd = min(uv, 1.0 - uv);
            float fade = (1.0 - smoothstep(uLife.w, uLife.w + 0.6, rho)) * smoothstep(0.0, 0.04, min(wd.x, wd.y));
            fragColor = vec4(V * fade, S * fade, 0.0, 1.0);
            return;
        }

        // Gray-Scott step (Du = 1, Dv = 0.5, dt = 1); the stencil stretch varies across the field (canopy b),
        // clamped to 1..4 texels: below one the stencil degenerates, above four it decouples into a grid
        float sc = clamp(uRD.z * exp2(uLife.z * cn.b), 1.0, 4.0);
        vec2 ox = vec2(tx.x * sc, 0.0), oy = vec2(0.0, tx.y * sc);
        vec2 c = texture(sTD2DInputs[0], uv).rg;
        vec2 edge = texture(sTD2DInputs[0], uv + ox).rg + texture(sTD2DInputs[0], uv - ox).rg
                  + texture(sTD2DInputs[0], uv + oy).rg + texture(sTD2DInputs[0], uv - oy).rg;
        vec2 corn = texture(sTD2DInputs[0], uv + ox + oy).rg + texture(sTD2DInputs[0], uv + ox - oy).rg
                  + texture(sTD2DInputs[0], uv - ox + oy).rg + texture(sTD2DInputs[0], uv - ox - oy).rg;
        vec2 lap = 0.2 * edge + 0.05 * corn - c;
        float V = c.r, U = 1.0 - c.g;
        // coral feed at the rim, starving toward the end of the reach: growth can only finger outward; in the
        // quiet sectors of the limb it starves outright, so the corona breaks into separate eruptions
        float feed = mix(0.026, mix(0.060, 0.026, reach), cn.r) + uRD.x;
        float kill = 0.0615 + 0.004 * reach + uRD.y;
        float uvv = U * V * V;
        U += -lap.y - uvv + feed * (1.0 - U);
        V += 0.5 * lap.x + uvv - (feed + kill) * V;
        fragColor = vec4(clamp(V, 0.0, 1.0), clamp(1.0 - U, 0.0, 1.0), 0.0, 1.0);
    }
  dat_content_format: text
