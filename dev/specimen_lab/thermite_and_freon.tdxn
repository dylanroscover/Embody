- name: geo_sediment
  type: geometryCOMP
  position: [2400, -2400]
  children:
  - name: glsl_seed
    type: glslPOP
    parameters:
      computedat: glsl_seed_compute
      outputattrs: P Age Color PointScale
    sequences:
      attr:
      - customname: Age
      - name: color
      - name: pointscale
      vec:
      - {}
      - name: uAspect
        type: vec4
        valuex: =parent.Specimen.par.Aspect
    position: [400, 0]
    inputs:
    - grid_seed
  - name: grid_seed
    type: gridPOP
    parameters:
      cols: 512
      rows: 512
  - name: glsl_grains
    type: glslPOP
    parameters:
      computedat: glsl_grains_compute
      outputattrs: P N Age Color PointScale
    sequences:
      vec:
      - name: uGrain
        type: vec4
        valuex: 1
        valuey: =parent.Specimen.par.Trails * 0.3
        valuez: =absTime.seconds
        valuew: =absTime.frame
      - name: uAspect
        type: vec4
        valuex: =parent.Specimen.par.Aspect
      sampler:
      - name: sFlow
        top: ../rselect_flow
    position: [1200, 0]
    inputs:
    - feedback_grains
  - name: null_grains
    type: nullPOP
    position: [1600, 0]
    inputs:
    - glsl_grains
  - name: glsl_seed_info
    type: infoDAT
    parameters:
      op: glsl_seed
    position: [475, -120]
    dock: glsl_seed
    dat_read_only: true
  - name: feedback_grains
    type: feedbackPOP
    parameters:
      targetpop: null_grains
    position: [800, 0]
    inputs:
    - glsl_seed
  - name: glsl_grains_info
    type: infoDAT
    parameters:
      op: glsl_grains
    position: [1275, -120]
    dock: glsl_grains
    dat_read_only: true
  - name: glsl_seed_compute
    type: textDAT
    position: [325, -120]
    dock: glsl_seed
    dat_content: |
      // scatter the grains over the frame with de-synced ages (static: cooks once)
      // creates Age, Color, PointScale for the feedback loop downstream
      float hash1(uint n) {
          n = (n << 13U) ^ n;
          n = n * (n * n * 15731U + 789221U) + 1376312589U;
          return float(n & 0x7fffffffU) / float(0x7fffffff);
      }

      void main() {
          const uint id = TDIndex();
          if (id >= TDNumElements())
              return;
          P[id] = vec3((hash1(id * 3U) - 0.5) * uAspect.x, hash1(id * 3U + 1U) - 0.5, 0.0);   // world units, centred
          Age[id] = hash1(id * 3U + 2U) * 20.0;
          Color[id] = vec4(0.0);
          PointScale[id] = 1.0;
      }
    dat_content_format: text
  - name: glsl_grains_compute
    type: textDAT
    position: [1125, -120]
    dock: glsl_grains
    dat_content: |
      // grains ride the flow field with a little inertia: downhill on land, carried by the currents in the
      // water. They converge into the valleys, and their trails are the drainage tree.
      // sFlow: xy = velocity (uv per frame), z = wet, w = speed. uGrain: x speed scale, y brightness, z seconds, w frame
      // P is world units (height 1, width = uAspect.x) centred on the frame for the ortho camera
      float hash1(uint n) {
          n = (n << 13U) ^ n;
          n = n * (n * n * 15731U + 789221U) + 1376312589U;
          return float(n & 0x7fffffffU) / float(0x7fffffff);
      }

      void main() {
          const uint id = TDIndex();
          if (id >= TDNumElements())
              return;
          uint fr = uint(uGrain.w);
          vec3 p = TDIn_P();
          vec3 vel = TDIn_N();          // N carries the grain velocity (world units per frame) between frames
          vec2 asp = vec2(uAspect.x, 1.0), org = vec2(0.5 * uAspect.x, 0.5);
          float age = TDIn_Age() + 1.0 / 60.0;
          float life = 6.0 + 14.0 * hash1(id * 7U + 3U);

          vec4 F = texture(sFlow, (p.xy + org) / asp);
          vec2 jitter = vec2(hash1(id * 13U + fr * 7919U), hash1(id * 17U + fr * 104729U)) - 0.5;
          // inertia lets a grain roll through the small dips instead of pooling in them
          vel.xy = mix(vel.xy, F.xy * asp * uGrain.x, 0.12) + jitter * 0.00012;
          p.xy += vel.xy;

          vec2 uv = (p.xy + org) / asp;
          bool drained = length((uv - vec2(0.34, 0.31)) * asp) < 0.012;
          if (age > life || drained || uv.x < 0.0 || uv.y < 0.0 || uv.x > 1.0 || uv.y > 1.0) {
              p.xy = vec2(hash1(id * 5U + fr * 31U) * asp.x, hash1(id * 11U + fr * 57U)) - org;
              vel = vec3(0.0);
              age = 0.0;
          }
          float fade = smoothstep(0.0, 1.0, age) * (1.0 - smoothstep(life - 1.5, life, age));
          float a = fade * uGrain.y;
          P[id] = p;
          N[id] = vec3(vel.xy, 0.0);
          Age[id] = age;
          Color[id] = vec4(a, a, a, a);
          PointScale[id] = 1.0;
      }
    dat_content_format: text
