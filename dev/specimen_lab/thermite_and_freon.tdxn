- name: sound_events
  type: executeDAT
  parameters:
    fromop: =parent()
    framestart: true
  position: [2400, -4800]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_content: |
    """Sound for the thermite_and_freon specimen.

    Reads the suns' state from glsl_orbit through topto_orbit (one frame late, no GPU stall) and plays the
    ElevenLabs library listed in table_sfx_beds / table_sfx_events. The three loops play continuously, with
    levels that follow the dance through const_bed_levels (audio_beds' volume input). Collisions, sparks and
    moon passes fire one-shots on audio_events, panned to where they happen, and the zero-g water answers
    hits with soft sloshes and spray (topto_drops reads the drops' splash row). The loops are (re)started
    whenever audio_beds reports silence, so a reload or a toggle never doubles them.
    """
    import math
    import random

    # event table rows: impacts 0-3, sparks 4-7, moon passes 8-10, water pushes 11-14, water spray 15-17
    _IMPACT, _SPARKS, _MOON, _PUSH, _SPRAY = (0, 4), (4, 8), (8, 11), (11, 15), (15, 18)
    _state = {'impacts': None, 'last_hit': -1.0, 'moons': {}, 'last_push': -1.0, 'last_spray': -1.0}
    # offline render: while `capture` is a list the sound is logged there instead of played (the device stays
    # silent), so a non-realtime render can mix a frame-exact soundtrack from the same files:
    # ('beds', seconds, level0, level1, level2) every frame, ('event', seconds, row, volume, pan, delay) per one-shot
    capture = None


    def _play(player, row: int, **kw) -> None:
        if capture is not None:
            capture.append(('event', absTime.seconds, row, kw.get('volume', 1.0), kw.get('pan', 0.5), kw.get('delaySeconds', 0.0)))
        else:
            player.play(row, **kw)


    def onFrameStart(frame: int) -> None:
        comp = parent.Specimen
        aspect = float(comp.par.Aspect.eval())    # positions are world units: x runs 0..aspect
        o = op('topto_orbit')
        if o.numSamples < 6:
            return
        on = bool(comp.par.Sound.eval())
        master = float(comp.par.Volume.eval()) if on else 0.0
        r, g, b, a = o['r'], o['g'], o['b'], o['a']
        big, small = (r[0], g[0]), (b[0], a[0])
        r1, r2, env = r[2], g[2], a[2]
        impacts = b[3]
        dist = math.hypot(big[0] - small[0], big[1] - small[1])
        close = 1.0 - min(max((dist - (r1 + r2)) / 0.25, 0.0), 1.0)

        # loops: the drone swells with each explosion, the crackle with heat and closeness, the hum only as the
        # suns draw together
        beds = float(comp.par.Beds.eval()) * master
        lv = op('const_bed_levels').par
        levels = (beds * (0.55 + 0.25 * env), beds * (0.2 + 0.6 * env + 0.2 * close), beds * (0.05 + 0.6 * close * close))
        if capture is not None:
            capture.append(('beds', absTime.seconds) + levels)
            levels = (0.0, 0.0, 0.0)
        lv.const0value, lv.const1value, lv.const2value = levels
        audio_beds = op('audio_beds')
        # the players run outside TouchDesigner (they keep going when this COMP stops cooking), so Sound off stops them
        if not on and (audio_beds['state'][0] > 0.5 or op('audio_events')['state'][0] > 0.5):
            audio_beds.stop()
            op('audio_events').stop()
        if on and audio_beds['state'][0] < 0.5:
            for i in range(3):
                audio_beds.play(i, loop=True, fadeSeconds=2.0)

        events = op('audio_events')
        ev = float(comp.par.Events.eval()) * master
        now = absTime.seconds
        if _state['impacts'] is None:
            _state['impacts'] = impacts
        if impacts > _state['impacts'] and on and now - _state['last_hit'] > 0.25:
            _state['last_hit'] = now
            cx = big[0] + (small[0] - big[0]) * r1 / (r1 + r2)
            pan = min(max(cx / aspect, 0.0), 1.0)
            _play(events, random.randrange(*_IMPACT), volume=ev * (0.45 + 0.55 * env), pan=pan)
            _play(events, random.randrange(*_SPARKS), volume=ev * 0.55, pan=pan, delaySeconds=random.uniform(0.05, 0.2))
        _state['impacts'] = impacts

        # moon passes: a soft whoosh as each moon swings through its closest point to the large sun
        moons = ((r[4], g[4]), (b[4], a[4]), (r[5], g[5]))
        for k, (mx, my) in enumerate(moons):
            d = math.hypot(mx - big[0], my - big[1])
            prev = _state['moons'].get(k)
            if prev is not None:
                d0, falling, last = prev
                rising = d > d0
                if falling and rising and on and d < r1 * 2.3 and now - last > 3.0:
                    _play(events, random.randrange(*_MOON), volume=ev * 0.35, pan=min(max(mx / aspect, 0.0), 1.0))
                    last = now
                _state['moons'][k] = (d, d < d0, last)
            else:
                _state['moons'][k] = (d, False, -10.0)

        # water: a soft slosh when a drop is shoved hard, a faint spray patter on the big hits -- kept well under
        # the fire. r = how hard each drop was hit this frame, a = its x
        w = op('topto_drops')
        if on and w.numSamples >= 80:
            hits, xs = w['r'].vals, w['a'].vals
            k = max(range(len(hits)), key=hits.__getitem__)
            wl = ev * float(comp.par.Watersfx.eval())
            pan = min(max(xs[k] / aspect, 0.0), 1.0)
            # the drops jostle all the time; only the hardest ~2% of hits (flings, collisions, the small sun
            # ploughing in) are worth a sound
            if hits[k] > 0.3 and now - _state['last_push'] > 1.5:
                _state['last_push'] = now
                _play(events, random.randrange(*_PUSH), volume=wl * min(0.4 + 1.5 * (hits[k] - 0.3), 1.0) * 0.45, pan=pan)
            if sum(hits) > 1.0 and now - _state['last_spray'] > 3.0:
                _state['last_spray'] = now
                _play(events, random.randrange(*_SPRAY), volume=wl * 0.3, pan=pan, delaySeconds=random.uniform(0.05, 0.15))
        return
  dat_content_format: text
