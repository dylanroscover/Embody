- name: glsl_orbit_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [325, -520]
  dock: glsl_orbit
  dat_content: |
    // the two suns as magnets: a two-body simulation integrated here every frame (state fed back through
    // feedback_orbit), read by the canopy, flow step, pigment and sparks. Forces: a softened inverse-square
    // pull, a stiff spring where the limbs overlap (they collide and bounce), a steer toward a circling speed
    // that slowly breathes (so the pair keeps falling in and springing apart), a soft tether, soft frame walls.
    // The large sun is heavy and anchored near the centre; the small one is light and free.
    // Every impact fires an explosion: strength from the closing speed, sparks splashing out sideways from
    // the contact, spread and decay randomized per impact. Constants were tuned offline (about 70 irregular
    // impacts in three minutes at speed 3.5).
    // texel 0: large sun xy, small sun xy (world units: height 1, width = aspect)
    // texel 1: their velocities (world units per real second)
    // texel 2: x large radius, y small radius, z in contact (0/1), w explosion envelope
    // texel 3: x explosion direction (radians), y spread (0 jet .. 1 all round), z impact count
    // texel 4: moon 1 xy, moon 2 xy; texel 5: moon 3 xy (three tiny suns orbiting the large one)
    // in0: previous state (feedback_orbit; all zero on the first frame)
    uniform vec4 uOrbit;    // x orbit time (seconds * speed), y speed, z separation scale, w large radius
    uniform vec4 uOrbit2;   // x small radius relative to the large one
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;

    const float G = 0.002, SWIRL = 0.6, VT = 0.2, BREATH = 0.6, K = 160.0, DAMPC = 3.0, DRAG = 0.999,
                ANCHOR = 0.3, TETHER = 2.0, M1 = 6.0, M2 = 0.25;

    float hash(float n, uint salt) {
        uint x = uint(int(n)) * 4U + salt;
        x = (x << 13U) ^ x;
        x = x * (x * x * 15731U + 789221U) + 1376312589U;
        return float(x & 0x7fffffffU) / float(0x7fffffff);
    }

    void main() {
        int i = int(gl_FragCoord.x);
        vec4 P = texelFetch(sTD2DInputs[0], ivec2(0, 0), 0);
        vec4 Vr = texelFetch(sTD2DInputs[0], ivec2(1, 0), 0);
        vec4 R = texelFetch(sTD2DInputs[0], ivec2(2, 0), 0);
        vec4 E = texelFetch(sTD2DInputs[0], ivec2(3, 0), 0);
        float t = uOrbit.x, speed = max(uOrbit.y, 1e-3), dt = speed / 60.0;
        float r1 = uOrbit.w, r2 = uOrbit.w * uOrbit2.x;
        vec2 p1 = P.xy, p2 = P.zw;
        vec2 v1 = Vr.xy / speed, v2 = Vr.zw / speed;           // stored per real second, integrated per orbit second
        float contact = R.z, env = R.w;
        if (R.x <= 0.0) {                                       // first frame: place them and give them a spin
            p1 = vec2(0.5 * uAspect.x - 0.08, 0.46); p2 = vec2(0.5 * uAspect.x + 0.17, 0.50);
            v1 = vec2(0.0, -0.02); v2 = vec2(0.0, 0.10);
            contact = 0.0; env = 0.0; E = vec4(0.0, 1.0, 0.0, 0.0);
        }

        vec2 d = p2 - p1;
        float dist = length(d) + 1e-6;
        vec2 n = d / dist, tg = vec2(-n.y, n.x);
        vec2 rv = v2 - v1;
        float vn = dot(rv, n), vt = dot(rv, tg);
        float vtt = VT * (1.0 + BREATH * sin(t * 0.37) * sin(t * 0.13 + 1.0));
        // the tether rests a fixed gap beyond contact, so the dance keeps its room at any sun size
        vec2 F = (G / (dist * dist + 0.004) + TETHER * max(0.0, dist - (r1 + r2) * 0.97 - 0.14 * uOrbit.z)) * n;   // on the large sun
        F -= 0.5 * SWIRL * (vtt - vt) * tg;
        float ov = (r1 + r2) * 0.97 - dist;
        bool impact = false;
        if (ov > 0.0) {
            F -= (K * ov - DAMPC * min(vn, 0.0)) * n;
            impact = contact < 0.5;
            contact = 1.0;
        } else if (ov < -0.01) {
            contact = 0.0;
        }
        // the heavy large sun is held near the centre by its own slow anchor and only drifts gently;
        // the light small sun is free -- it orbits, falls in, bounces and springs away
        vec2 tgt = vec2(0.5 * uAspect.x, 0.5) + 0.07 * vec2(sin(t * 0.038 + 0.4), sin(t * 0.029 + 1.7));
        vec2 A1 = ANCHOR * (tgt - p1) - 2.0 * sqrt(ANCHOR) * v1;
        vec2 w2 = 3.0 * (clamp(p2, vec2(0.08), vec2(uAspect.x - 0.08, 0.92)) - p2);         // soft frame walls for the small sun
        v1 = (v1 + (F / M1 + A1) * dt) * DRAG;
        v2 = (v2 + (-F / M2 + w2) * dt) * DRAG;
        p1 += v1 * dt;
        p2 += v2 * dt;

        // explosions: each impact sets a new envelope; between impacts it decays at a per-impact rate
        float id = E.z;
        env *= exp(-(0.8 + 1.6 * hash(id, 3U)) / 60.0);
        if (impact) {
            id += 1.0;
            env = max(env, clamp(-vn * 6.0, 0.35, 1.0));
            float side = hash(id, 0U) > 0.5 ? 1.5707963 : -1.5707963;
            E.xy = vec2(atan(n.y, n.x) + side + (hash(id, 1U) - 0.5) * 0.8, mix(0.15, 1.0, hash(id, 2U) * hash(id, 2U)));
        }

        // three tiny moons on tilted, eccentric orbits around the large sun (kinematic, from orbit time)
        vec2 moon[3];
        for (int k = 0; k < 3; k++) {
            float fk = float(k);
            // noise in speed and reach, so no moon ever repeats a clean cycle
            float th = t * (fk == 1.0 ? -0.085 : (fk == 0.0 ? 0.12 : 0.06)) + fk * 2.1
                     + 0.45 * TDSimplexNoise(vec2(t * 0.04, fk * 7.0));
            float a = r1 * (1.7 + 0.25 * fk) * (1.0 + 0.12 * TDSimplexNoise(vec2(t * 0.03, fk * 3.0 + 1.0)));
            vec2 e = vec2(a * cos(th), a * (0.62 + 0.12 * fk) * sin(th));
            float tilt = 0.7 + 1.3 * fk;
            moon[k] = p1 + mat2(cos(tilt), sin(tilt), -sin(tilt), cos(tilt)) * e;
        }

        vec4 outv;
        if (i == 0) outv = vec4(p1, p2);
        else if (i == 1) outv = vec4(v1, v2) * speed;
        else if (i == 2) outv = vec4(r1, r2, contact, env);
        else if (i == 3) outv = vec4(E.xy, id, 0.0);
        else if (i == 4) outv = vec4(moon[0], moon[1]);
        else outv = vec4(moon[2], 0.0, 0.0);
        fragColor = outv;
    }
  dat_content_format: text
- name: glsl_spray_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [2725, -3320]
  dock: glsl_spray
  dat_content: |
    // spray: droplets thrown off the water wherever it is hit -- the small sun ploughing through a drop, the suns
    // colliding beside it, a drop flung off the limb, two drops slamming together. They live on a grid, one droplet
    // per cell (a droplet's kernel is capped at half a cell, so a pixel only reads the 2x2 cells around it): each
    // cell gathers whichever neighbour's droplet lands in it, the largest winning a collision. Droplets fall back
    // toward the large sun, shrink as they evaporate, sizzle out on its limb and are swallowed by a big drop.
    // rows 0..G-1: xy position (world units: height 1, width = aspect), z radius (0 = empty), w seed.
    // rows G..2G-1: xy velocity (world units per second). G cells per world unit; the width is the texture's.
    // in0: previous spray, in1: glsl_drops (row 0 xy position z radius; row 1 xy velocity; row 2 x splash, yz dir),
    // in2: glsl_orbit (texel 0 positions, texel 2 radii)
    uniform vec4 uSpray;   // x seconds, y pull, z amount, w size
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;
    #define G 96
    #define N 80

    uint ih(uint x) { x ^= x >> 16; x *= 0x7feb352dU; x ^= x >> 15; x *= 0x846ca68bU; x ^= x >> 16; return x; }
    float hash(uint a, uint b) { return float(ih(a * 747796405U + b * 2891336453U + 12345U) & 0xffffffU) / 16777215.0; }

    void main() {
        ivec2 px = ivec2(gl_FragCoord.xy);
        bool velRow = px.y >= G;
        ivec2 cell = ivec2(px.x, velRow ? px.y - G : px.y);
        ivec2 gmax = ivec2(int(uTDOutputInfo.res.z), G);
        float t = uSpray.x, dt = 1.0 / 60.0;
        uint fr = uint(t * 60.0);
        vec4 O0 = texelFetch(sTD2DInputs[2], ivec2(0, 0), 0);
        vec4 O2 = texelFetch(sTD2DInputs[2], ivec2(2, 0), 0);
        vec2 p1 = O0.xy, p2 = O0.zw;
        float r1 = O2.x, r2 = O2.y;

        // gather: step every droplet in the 3x3 neighbourhood; keep the largest that lands in this cell
        vec4 best = vec4(0.0);
        vec2 bestV = vec2(0.0);
        for (int k = 0; k < 9; k++) {
            ivec2 c = cell + ivec2(k % 3 - 1, k / 3 - 1);
            if (any(lessThan(c, ivec2(0))) || any(greaterThanEqual(c, gmax))) continue;
            vec4 A = texelFetch(sTD2DInputs[0], c, 0);
            if (A.z <= 0.0) continue;
            vec2 v = texelFetch(sTD2DInputs[0], c + ivec2(0, G), 0).xy;
            vec2 p = A.xy;
            vec2 dp = p - p1;
            float d = length(dp) + 1e-5;
            vec2 acc = -dp / d * 0.07 * uSpray.y;                              // falls home like the big drops
            acc += 0.03 * vec2(TDSimplexNoise(vec3(p * 9.0, t * 0.2)), TDSimplexNoise(vec3(p * 9.0 + 31.0, t * 0.2)));
            vec2 d2v = p - p2;
            float d2 = length(d2v) + 1e-5;
            if (d2 < r2 + A.z) acc += d2v / d2 * (r2 + A.z - d2) * 120.0;      // the small sun bats it away
            v = (v + acc * dt) * exp(-0.8 * dt);
            float sp = length(v);
            if (sp > 0.55) v *= 0.55 / sp;                                     // under a cell per frame
            p += v * dt;
            float rad = A.z * exp(-dt / 8.0);                                  // evaporating
            if (rad < 0.0005 * uSpray.w || d < r1 * 0.98) continue;            // gone, or sizzled on the limb
            if (any(notEqual(ivec2(floor(p * float(G))), cell))) continue;     // it lands in another cell
            if (rad > best.z) { best = vec4(p, rad, A.w); bestV = v; }
        }
        if (best.z > 0.0) {                                                    // swallowed by a big drop
            for (int i = 0; i < N; i++) {
                vec4 D = texelFetch(sTD2DInputs[1], ivec2(i, 0), 0);
                if (length(best.xy - D.xy) < D.z * 0.7) { best = vec4(0.0); break; }
            }
        } else {
            // spawn: an empty cell that a struck drop's surface passes through throws a droplet off it
            vec2 cc = (vec2(cell) + 0.5) / float(G);
            uint cid = uint(cell.y * gmax.x + cell.x);
            for (int i = 0; i < N; i++) {
                vec4 Sp = texelFetch(sTD2DInputs[1], ivec2(i, 2), 0);
                if (Sp.x < 0.002) continue;
                vec4 D = texelFetch(sTD2DInputs[1], ivec2(i, 0), 0);
                vec2 nq = normalize(cc - D.xy + 1e-6);
                vec2 at = D.xy + nq * D.z;
                if (any(notEqual(ivec2(floor(at * float(G))), cell))) continue;   // its surface misses this cell
                float side = 0.25 + 0.75 * max(dot(nq, Sp.yz), 0.0);              // mostly off the struck side
                float chance = clamp(Sp.x * 20.0 * uSpray.z, 0.0, 0.9) * side;
                if (hash(cid, fr * 131U + uint(i)) >= chance) continue;
                float h = hash(cid, fr * 7U + 101U);
                vec2 vd = texelFetch(sTD2DInputs[1], ivec2(i, 1), 0).xy;
                best = vec4(at, min(mix(0.001, 0.004, h * h) * uSpray.w, 0.5 * 0.608 / float(G)), hash(cid, fr + 7U));
                bestV = vd + nq * mix(0.12, 0.45, hash(cid, fr * 5U + 3U)) + Sp.yz * 0.12;
                break;
            }
        }
        fragColor = velRow ? vec4(bestV, 0.0, 0.0) : best;
    }
  dat_content_format: text
- name: glsl_stream_info
  type: infoDAT
