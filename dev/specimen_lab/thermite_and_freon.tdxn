- name: glsl_water_pixel
  type: textDAT
  parameters:
    extension: frag
  position: [2725, -3720]
  dock: glsl_water
  dat_content: |
    // the zero-g water as one merged field: each drop is a compact metaball (1 - d^2/R^2)^3 stretched along its
    // wobble axis, so drops that drift close bridge and merge like surface tension. A lone drop's surface sits at
    // its radius at the iso level 0.25 (R = radius / 0.608).
    // r = field, gb = gradient in units of each drop's own kernel radius (scale-free normals),
    // a = blended kernel radius (sizes the lens in the compose)
    // in0: glsl_drops (row 0 xy position, z radius, w stretch; row 1 z axis)
    uniform vec4 uAspect;   // x = frame width / height; world units have height 1 and width x
    layout(location = 0) out vec4 fragColor;
    #define N 80

    void main() {
        vec2 p = vUV.st * vec2(uAspect.x, 1.0);              // world units, like the drops
        float F = 0.0, rad = 0.0;
        vec2 G = vec2(0.0);
        for (int i = 0; i < N; i++) {
            vec4 A = texelFetch(sTD2DInputs[0], ivec2(i, 0), 0);
            float R = A.z / 0.608;
            vec2 q = p - A.xy;
            if (dot(q, q) > R * R * 1.4) continue;      // outside even the stretched kernel: one fetch, done
            float ang = texelFetch(sTD2DInputs[0], ivec2(i, 1), 0).z;
            vec2 ax = vec2(cos(ang), sin(ang)), ay = vec2(-ax.y, ax.x);
            vec2 S = vec2(1.0 / (1.0 + A.w), 1.0 + A.w);
            vec2 l = vec2(dot(q, ax), dot(q, ay)) * S;
            float x2 = dot(l, l) / (R * R);
            if (x2 >= 1.0) continue;
            float w = 1.0 - x2, k = w * w * w;
            vec2 g = -6.0 * w * w * l * S / R;
            F += k;
            G += g.x * ax + g.y * ay;
            rad += k * R;
        }
        fragColor = vec4(F, G, rad / max(F, 1e-4));
    }
  dat_content_format: text
