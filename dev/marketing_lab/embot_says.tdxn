format: tdxn
version: '2.1'
build: 1
generator: Embody/6.2.68
td_build: 099.2025.33230
network_path: /marketing_lab/embot_says
options:
  include_dat_content: false
  include_storage: true
type: baseCOMP
custom_pars:
  Embot:
  - name: Preset
    style: Menu
    default: wired
    menuSource: tdu.TableMenu(me.op('presets'), labelCol='label')
    help: What Embot says. Add a row to the presets table inside to add one.
  - name: Text
    style: Str
    help: The speech bubble. Typed text wins over the preset; leave empty to use the preset.
  - name: Progress
    style: Float
    default: 1
    clampMin: true
    clampMax: true
    help: 0 = empty frame, 1 = Embot standing with the bubble fully typed. He hops in, waves, and his line types on. Animate 0 to 1 to play it.
parameters:
  parentshortcut: Mograph
flags:
- viewer
color: [0.3, 0.5, 0.9]
tags:
- tdxn
operators:
- name: out1
  type: outTOP
  parameters:
    label: =me.name
  flags:
  - display
  position: [1400, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - glsl_embot
- name: presets
  type: tableDAT
  position: [200, -400]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_content:
  - - name
    - label
    - text
  - - wired
    - I wired that
    - I wired that for you.
  - - 'null'
    - Forgot the Null
    - You forgot the Null. I added it.
  - - banana
    - Always a banana
    - Why is it always a banana?
  - - cooks
    - It cooks
    - It cooks. I checked.
  - - hands
    - No hands
    - Look. No hands.
  - - sixty
    - 60 fps
    - Still 60 fps.
  - - hello
    - Hello
    - Hi. I'm Embot.
  - - convoy
    - Convoy
    - I can do that on the other machine too.
  dat_content_format: table
- name: text_main
  type: textTOP
  parameters:
    text: =op('../kit_core/layout').module.preset(parent.Mograph, 'text', 'Text')
    font: Cascadia Mono
    dispmethod: scalable
    fontsizex: 44
    fontsizexunit: pixels
    alignx: left
    aligny: bottom
    outputresolution: custom
    resolutionw: 1920
    resolutionh: 1080
  position: [600, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: glsl_embot
  type: glslTOP
  parameters:
    pixeldat: glsl_embot_pixel
    computedat: glsl_embot_compute
    premultrgbbyalpha: false
    outputresolution: custom
    resolutionw: 1920
    resolutionh: 1080
    format: rgba8fixed
  sequences:
    vec:
    - name: uAnim
      valuex: =parent.Mograph.par.Progress
    - name: uMain
      valuex: =op('text_main').evalTextSize(op('text_main').par.text.eval())[0]
      valuey: =op('text_main').evalTextSize('M')[0]
      valuez: =len(op('text_main').par.text.eval())
  position: [1000, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - text_main
- name: glsl_embot_info
  type: infoDAT
  parameters:
    op: glsl_embot
  flags:
  - viewer
  position: [1075, -120]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dock: glsl_embot
  dat_read_only: true
- name: glsl_embot_pixel
  type: textDAT
  parameters:
    language: glsl
    extension: frag
  flags:
  - viewer
  position: [925, -120]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dock: glsl_embot
  dat_content: "// embot_says: Embot hops in, lands, waves and says his line. His proportions are the ones\n// Envoy draws him with (envoy_viz._VIZ_BOT_PARTS), at U px per network unit.\n// Input 0 is the line (text_main, set at the frame's bottom left).\n#include <../kit_core/glsl_common>\nuniform vec4 uAnim;                 // x: Progress\nuniform vec4 uMain;                 // the line: x width px, y advance px, z characters\n\nconst float U = 4.4;\nconst vec2 HOME = vec2(300.0, 330.0);   // where the middle of his body rests\nconst float FEET = -41.0;               // the soles of his feet, in units below that\nconst float SIZE = 44.0;                // twin of text_main's font size\n\nlayout(location = 0) out vec4 fragColor;\n\n// one of his blocks: centre and size in units\nfloat part(vec2 q, vec2 c, vec2 size) {\n\treturn sdRoundBox(q - c, 0.5 * size, 2.0);\n}\n\nvoid main() {\n\tvec2 p = vUV.st * FRAME;\n\tfloat P = uAnim.x;\n\tvec4 o = vec4(0.0);\n\tif (P > 0.0) {\n\t\t// hop in from the left, squash on landing\n\t\tfloat hop = ramp(P, 0.0, 0.22);\n\t\tvec2 at = vec2(mix(-260.0, HOME.x, easeOutCubic(hop)), HOME.y + 1040.0 * hop * (1.0 - hop));\n\t\tfloat squash = sin(PI * ramp(P, 0.22, 0.32));\n\t\tvec2 q = (p - at) / U;\n\t\tq = vec2(q.x / (1.0 + 0.08 * squash), (q.y - FEET) / (1.0 - 0.12 * squash) + FEET);\n\n\t\tfloat wave = sin(PI * ramp(P, 0.34, 0.74));     // his right arm goes up and waggles\n\t\tfloat d = min(part(q, vec2(0.0), vec2(30.0, 34.0)), part(q, vec2(-22.0, 3.0), vec2(9.0, 26.0)));\n\t\td = min(d, part(q, vec2(22.0 + 3.0 * sin(110.0 * P) * wave, 3.0 + 16.0 * wave), vec2(9.0, 26.0)));\n\t\td = min(d, min(part(q, vec2(-8.0, -29.0), vec2(11.0, 24.0)), part(q, vec2(8.0, -29.0), vec2(11.0, 24.0))));\n\t\td = min(d, part(q, vec2(0.0, 31.0), vec2(34.0, 26.0)));\n\t\to = over(o, GREEN, fill(d * U));\n\t\tfloat lid = 1.0 - 0.85 * sin(PI * ramp(P, 0.62, 0.68));     // one blink\n\t\to = over(o, DARK, fill(min(part(q, vec2(-8.0, 35.0), vec2(12.0, 13.0 * lid)), part(q, vec2(8.0, 35.0), vec2(12.0, 13.0 * lid))) * U));\n\n\t\t// the bubble grows out of a corner beside his head, tail first\n\t\tfloat say = easeOutBack(ramp(P, 0.32, 0.46));\n\t\tif (say > 0.0) {\n\t\t\tvec2 halfSize = vec2(0.5 * uMain.x + 40.0, 50.0);\n\t\t\tvec2 g = (p - HOME - vec2(150.0, 150.0)) / say;\n\t\t\tfloat dB = min(sdRoundBox(g - halfSize, halfSize, 22.0), sdRoundBox(rot(PI / 4.0) * (g - vec2(26.0, 4.0)), vec2(16.0), 3.0)) * say;\n\t\t\to = over(o, mix(GREEN, DARK, fill(dB + 4.0)), fill(dB));\n\t\t\tvec2 origin = vec2(40.0, 50.0 - 0.5 * 0.69 * SIZE);\n\t\t\tfloat typed = floor(ramp(P, 0.46, 0.9) * uMain.z + 0.001);\n\t\t\to = over(o, INK, textAt(sTD2DInputs[0], g, origin, 0.23 * SIZE, 1.0) * step(g.x, origin.x + typed * uMain.y));\n\t\t}\n\t}\n\tfragColor = TDOutputSwizzle(o);\n}\n"
  dat_content_format: text
annotations:
- name: annotate1
  mode: annotate
  title: Embot speaks
  text: Embot hops in, lands, waves and says his line. He is drawn in the shader from the same block proportions Envoy uses for him in the network editor.
  position: [130, -470]
  size: [1470, 730]
  color: [0.13, 0.28, 0.32]
  opacity: 0.25
