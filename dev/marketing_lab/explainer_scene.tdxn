  dat_content_format: table
- name: scenes
  type: tableDAT
  position: [200, -400]
  dat_content:
  - - name
    - label
    - title
    - caption
  - - diff
    - A diff you can read
    - A diff you can read
    - Change one parameter. One line changes.
  - - tdxn
    - 'TDXN: the network as text'
    - TDXN
    - Your network, written as YAML. A few lines for each operator.
  - - embot
    - Embot
    - Embot
    - He stands on whatever the agent is working on.
  - - layout
    - Keeps it tidy
    - It keeps the network tidy
    - Operators leave the pile at (0, 0) for the grid, wired left to right.
  - - restore
    - Rebuilds on open
    - It rebuilds itself on open
    - At frames 30, 45 and 60 of opening, everything externalized comes back from disk.
  dat_content_format: table
- name: glsl_scene
  type: glslTOP
  parameters:
    pixeldat: glsl_scene_pixel
    computedat: glsl_scene_compute
    premultrgbbyalpha: false
    outputresolution: custom
    resolutionw: 1920
    resolutionh: 1080
    format: rgba8fixed
  sequences:
    vec:
    - name: uAnim
      valuex: =parent.Mograph.par.Progress
      valuey: =parent.Mograph.par.Backdrop
      valuez: =parent.Mograph.par.Scene.menuIndex
    - name: uText
      valuex: =op('text_title').evalTextSize(op('text_title').par.text.eval())[0]
      valuey: =op('text_caption').evalTextSize(op('text_caption').par.text.eval())[0]
    array:
    - name: uCells
      type: vec4
      chop: datto_cells
      arraytype: texturebuffer
  position: [1000, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  inputs:
  - text_glyphs
  - text_title
  - text_caption
- name: text_title
  type: textTOP
  parameters:
    text: =op('scenes')[parent.Mograph.par.Scene.eval(), 'title']
    font: Inter
    typeface: SemiBold
    fontsizex: 64
  position: [600, -200]
- name: datto_cells
  type: dattoCHOP
  parameters:
    dat: script_layout
    rowindexend: =me.inputTable.numRows - 1
    rowexpr: =re.match('.*',me.inputCell.val) != None
    extractcols: byname
    colnamestart: a
    colnameend: d
    colindexend: =me.inputTable.numCols - 1
    colexpr: =re.match('.*',me.inputCell.val) != None
    output: chanpercol
    firstrow: names
    firstcolumn: values
    autoexportroot: =parent()
  position: [600, -600]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
- name: text_glyphs
  type: textTOP
  parameters:
    specdat: script_layout
    font: Cascadia Mono
    fontsizex: 32
  position: [600, 0]
- name: text_caption
  type: textTOP
  parameters:
    text: =op('scenes')[parent.Mograph.par.Scene.eval(), 'caption']
    font: Inter
    typeface: Medium
    fontsizex: 40
  position: [600, -400]
- name: script_layout
  type: scriptDAT
  parameters:
    callbacks: script_layout_callbacks
  position: [200, 0]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dat_read_only: true
- name: glsl_scene_info
  type: infoDAT
  parameters:
    op: glsl_scene
  flags:
  - viewer
  position: [1075, -120]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dock: glsl_scene
  dat_read_only: true
- name: glsl_scene_pixel
  type: textDAT
  parameters:
    language: glsl
    extension: frag
  position: [925, -120]
  dock: glsl_scene
  dat_content: "// explainer_scene: five explanations that need their own staging, one per branch below. All\n// their free text (labels, lines of code) comes from the texts table through kit_core/layout\n// items(), each with the Progress window it shows in; positions here and there are twins.\n// Input 0 is that text (text_glyphs), input 1 the title, input 2 the caption.\n// Scenes are numbered by their row in the scenes table: 0 diff, 1 tdxn, 2 embot, 3 layout, 4 restore.\n#include <../kit_core/glsl_common>\n#include <../kit_core/glsl_type>\nuniform vec4 uAnim;                 // x: Progress, y: 1 = dark backdrop, z: scene\nuniform vec4 uText;                 // x: title width px, y: caption width px\n\nconst float TITLE = 64.0, CAPTION = 40.0;       // twins of the Text TOPs' font sizes\nconst vec3 CARD = vec3(0.063, 0.08, 0.08);      // a card of code, darker than the backdrop\n\nlayout(location = 0) out vec4 fragColor;\n\n// a wire from a to b, drawn up to fraction k\nvec4 overWire(vec4 o, vec2 p, vec2 a, vec2 b, float k) {\n\treturn k <= 0.0 ? o : over(o, QUIET, fill(sdSegment(p, a, mix(a, b, k)) - 2.5));\n}\n\n// a card of code between lo and hi, unrolling from its top edge\nvec4 overCard(vec4 o, vec2 p, vec2 lo, vec2 hi, float unroll) {\n\tif (unroll <= 0.0 || p.y < mix(hi.y, lo.y, unroll)) return o;\n\treturn over(o, CARD, fill(sdRoundBox(p - 0.5 * (lo + hi), 0.5 * (hi - lo), 16.0)));\n}\n\n// Before and after: the same operator either side of one parameter change, and under them the\n// file, where the old line turns red and the new one arrives green.\nvec4 sceneDiff(vec4 o, vec2 p, float P) {\n\tconst vec2 BEFORE = vec2(480.0, 690.0), AFTER = vec2(1440.0, 690.0), CHIP = vec2(0.0, -120.0);\n\tfloat a = easeOutBack(ramp(P, 0.1, 0.2));\n\tif (a > 0.0) {\n\t\to = overTile(o, (p - BEFORE) / a, 84.0, FAMILY[0]);\n\t\to = over(o, 1.7 * DARK, fill(sdRoundBox(p - BEFORE - CHIP, vec2(124.0, 30.0) * a, 12.0)));\n\t}\n\to = overCard(o, p, vec2(560.0, 251.0), vec2(1360.0, 493.0), easeOutCubic(ramp(P, 0.16, 0.26)));\n\n\tfloat k = easeInOutCubic(ramp(P, 0.3, 0.44));\n\tif (k > 0.0) {\n\t\tvec2 from = BEFORE + vec2(150.0, 0.0), tip = mix(from, AFTER - vec2(150.0, 0.0), k);\n\t\to = over(o, QUIET, fill(min(sdSegment(p, from, tip), min(sdSegment(p, tip, tip + vec2(-16.0, 10.0)), sdSegment(p, tip, tip + vec2(-16.0, -10.0)))) - 2.5));\n\t}\n\tfloat b = easeOutBack(ramp(P, 0.44, 0.54));\n\tif (b > 0.0) {\n\t\to = overTile(o, (p - AFTER) / b, 84.0, FAMILY[0]);\n\t\tfloat d = sdRoundBox(p - AFTER - CHIP, vec2(124.0, 30.0) * b, 12.0);\n\t\to = over(o, mix(GREEN, 1.7 * DARK, fill(d + 3.0)), fill(d));\n\t}\n\treturn o;\n}\n\n// The network on the left, its file on the right. Each operator arrives, then its block of\n// lines does, and the two carry the same number.\nvec4 sceneTdxn(vec4 o, vec2 p, float P) {\n\to = overCard(o, p, vec2(968.0, 237.0), vec2(1752.0, 743.0), easeOutCubic(ramp(P, 0.06, 0.18)));\n\tfor (int i = 0; i < 3; i++) {\n\t\tfloat t = 0.14 + 0.22 * float(i);\n\t\tvec2 c = vec2(250.0 + 250.0 * float(i), 560.0);\n\t\tif (i > 0) o = overWire(o, p, c - vec2(164.0, 0.0), c - vec2(86.0, 0.0), easeInOutCubic(ramp(P, t - 0.08, t)));\n\t\tfloat a = easeOutBack(ramp(P, t, t + 0.1));\n\t\tif (a > 0.0) o = overTile(o, (p - c) / a, 78.0, FAMILY[0]);\n\t\tfloat n = easeOutBack(ramp(P, t + 0.1, t + 0.18));\n\t\tif (n > 0.0) {\n\t\t\tfloat top = i == 0 ? 648.0 : i == 1 ? 564.0 : 396.0;        // baseline of the block's first line\n\t\t\tfloat bottom = i == 0 ? 606.0 : i == 1 ? 438.0 : 270.0;     // and of its last\n\t\t\to = over(o, GREEN, fill(length(p - c - vec2(72.0, 54.0)) - 20.0 * n));\n\t\t\to = over(o, GREEN, fill(length(p - vec2(1012.0, top + 11.0)) - 18.0 * n));\n\t\t\to = over(o, GREEN, fill(sdRoundBox(p - vec2(1036.0, 0.5 * (top + bottom) + 10.0), vec2(2.0, 0.5 * (top - bottom) + 20.0), 2.0)));\n\t\t}\n\t}\n\treturn o;\n}\n\n// Embot hops in and works his way along the chain. Each operator is built as he lands on it,\n// and the one he stands on is ringed.\nvec4 sceneEmbot(vec4 o, vec2 p, float P) {\n\tconst float SIZE = 96.0,
    U = 3.2, ARC = 90.0;\n\tconst float LAND = 0.12, STEP = 0.22, HOP = 0.08;   // he reaches tile i at LAND + STEP * i and leaves the one before HOP earlier\n\tconst float GROUND = 430.0 + 0.62 * 96.0;           // the tops of the tiles, where he stands\n\tfloat on = clamp(floor((P - LAND) / STEP), 0.0, 3.0);   // the tile he last landed on\n\tfloat hop = on < 3.0 ? ramp(P, LAND + STEP * (on + 1.0) - HOP, LAND + STEP * (on + 1.0)) : 0.0;\n\tfor (int i = 0; i < 4; i++) {\n\t\tfloat t = LAND + STEP * float(i);\n\t\tvec2 c = vec2(390.0 + 380.0 * float(i), 430.0);\n\t\tif (i > 0) o = overWire(o, p, c - vec2(380.0 - SIZE - 10.0, 0.0), c - vec2(SIZE + 10.0, 0.0), ramp(P, t - HOP, t));\n\t\tfloat a = easeOutBack(ramp(P, t - 0.02, t + 0.06));\n\t\tif (a <= 0.0) continue;\n\t\to = overTile(o, (p - c) / a, SIZE, FAMILY[0]);\n\t\tif (float(i) == on && hop <= 0.0 && P >= t)\n\t\t\to = over(o, GREEN, fill(abs(sdRoundBox(p - c, vec2(SIZE, 0.62 * SIZE) + 10.0, 0.16 * SIZE + 10.0)) - 2.5));\n\t}\n\t// before the first landing he is still on his way in from the left\n\tfloat arrive = ramp(P, 0.0, LAND);\n\tfloat air = P < LAND ? arrive : hop;\n\tfloat squash = sin(PI * ramp(P, LAND + STEP * on, LAND + STEP * on + 0.05));\n\tvec2 body = vec2(P < LAND ? mix(-220.0, 390.0, easeOutCubic(arrive)) : 390.0 + 380.0 * (on + easeInOutCubic(hop)),\n\t\tGROUND + 41.0 * U + 4.0 * ARC * air * (1.0 - air));\n\tvec2 u = (p - body) / U;\n\tu = vec2(u.x / (1.0 + 0.08 * squash), (u.y + 41.0) / (1.0 - 0.12 * squash) - 41.0);\n\tfloat wave = sin(PI * ramp(P, 0.86, 0.99));\n\treturn overEmbot(o, u, U, vec2(3.0 * sin(110.0 * P) * wave, 16.0 * wave), sin(PI * ramp(P, 0.46, 0.5)));\n}\n\n// Every operator starts in a heap on the origin, where a bare create() leaves it, then goes\n// to its place on the grid; a wire is drawn once both of its ends have landed.\nvec4 sceneLayout(vec4 o, vec2 p, float P) {\n\tconst vec2 ORIGIN = vec2(960.0, 600.0);\n\tfloat axes = ramp(P, 0.08, 0.14) * (1.0 - ramp(P, 0.32, 0.38));\n\to = over(o, QUIET, fill(min(sdSegment(p, ORIGIN - vec2(150.0, 0.0), ORIGIN + vec2(150.0, 0.0)), sdSegment(p, ORIGIN - vec2(0.0, 120.0), ORIGIN + vec2(0.0, 120.0))) - 1.5) * axes);\n\tfor (int i = 0; i < 5; i++) {\n\t\tfloat fi = float(i);\n\t\tvec2 slot = vec2(480.0 + 240.0 * fi, 600.0);\n\t\tif (i > 0) o = overWire(o, p, slot - vec2(148.0, 0.0), slot - vec2(92.0, 0.0), ramp(P, 0.5 + 0.07 * fi, 0.56 + 0.07 * fi));\n\t\tfloat a = easeOutBack(ramp(P, 0.1 + 0.03 * fi, 0.2 + 0.03 * fi));\n\t\tif (a <= 0.0) continue;\n\t\tvec2 heap = ORIGIN + (vec2(hash(fi + 3.0), hash(fi + 11.0)) - 0.5) * vec2(110.0, 80.0);\n\t\tvec2 at = mix(heap, slot, easeOutBack(ramp(P, 0.36 + 0.07 * fi, 0.5 + 0.07 * fi)));\n\t\to = overTile(o, (p - at) / a, 84.0, FAMILY[i == 1 ? 1 : i == 3 ? 4 : 0]);\n\t}\n\treturn o;\n}\n\n// A frame ruler with a playhead: agent config at 30, .tox COMPs at 45, .tdxn COMPs at 60,\n// everything back at 75.\nvec4 sceneRestore(vec4 o, vec2 p, float P) {\n\tconst float RULE = 330.0, LEFT = 360.0, PER = 16.0;     // the ruler's height, frame 0, px per frame\n\tfloat show = ramp(P, 0.04, 0.12);\n\tif (show <= 0.0) return o;\n\tfloat head = LEFT + PER * 75.0 * ramp(P, 0.12, 0.8);\n\to = over(o, p.x <= head ? GREEN : QUIET, fill(sdSegment(p, vec2(LEFT, RULE), vec2(LEFT + 75.0 * PER * show, RULE)) - 2.0));\n\tif (p.x > LEFT - 4.0 && p.x < LEFT + 75.0 * PER * show + 4.0)\n\t\to = over(o, QUIET, fill(max(abs(mod(p.x - LEFT + 120.0, 240.0) - 120.0) - 2.0, abs(p.y - RULE + 12.0) - 12.0)));\n\tfor (int i = 0; i < 4; i++) {\n\t\tfloat f = 30.0 + 15.0 * float(i);\n\t\tfloat t = 0.12 + 0.68 * f / 75.0;                   // when the playhead reaches this mark\n\t\tfloat a = easeOutBack(ramp(P, t, t + 0.07));\n\t\tif (a <= 0.0) continue;\n\t\tvec2 c = vec2(LEFT + PER * f, 560.0);\n\t\to = over(o, QUIET, fill(sdSegment(p, vec2(c.x, RULE + 16.0), vec2(c.x, mix(RULE + 16.0, 480.0, a))) - 1.5));\n\t\tvec2 q = (p - c) / a;\n\t\tif (i == 0) {\n\t\t\to = overPage(o, q, 56.0);\n\t\t} else if (i == 3) {\n\t\t\to = over(o, GREEN, fill(length(q) - 42.0));\n\t\t\to = over(o, DARK, fill(min(sdSegment(q,
    vec2(-18.0, 0.0), vec2(-5.0, -14.0)), sdSegment(q, vec2(-5.0, -14.0), vec2(19.0, 15.0))) - 5.0));\n\t\t} else {\n\t\t\to = overTile(o, q - vec2(-16.0, 12.0), 52.0, 0.75 * FAMILY[6]);\n\t\t\to = overTile(o, q - vec2(16.0, -12.0), 52.0, FAMILY[6]);\n\t\t}\n\t}\n\treturn over(o, GREEN, fill(min(sdSegment(p, vec2(head, RULE - 14.0), vec2(head, RULE + 38.0)) - 2.0, length(p - vec2(head, RULE + 44.0)) - 9.0)) * show);\n}\n\nvoid main() {\n\tvec2 p = vUV.st * FRAME;\n\tfloat P = uAnim.x;\n\tvec4 o = vec4(0.0);\n\tif (P > 0.0) {\n\t\tif (uAnim.y > 0.5) {\n\t\t\t// the brand dark, with the network editor's grid of dots (on multiples of 120 px)\n\t\t\to = vec4(DARK, 1.0);\n\t\t\to = over(o, 1.9 * DARK, fill(length(mod(p + 60.0, 120.0) - 60.0) - 2.5));\n\t\t}\n\t\tint scene = int(uAnim.z);\n\t\tif (scene == 0) o = sceneDiff(o, p, P);\n\t\telse if (scene == 1) o = sceneTdxn(o, p, P);\n\t\telse if (scene == 2) o = sceneEmbot(o, p, P);\n\t\telse if (scene == 3) o = sceneLayout(o, p, P);\n\t\telse o = sceneRestore(o, p, P);\n\t\to = overItems(o, p, P);\n\t\to = over(o, INK, lineRise(sTD2DInputs[1], p, vec2(960.0 - 0.5 * uText.x, 930.0), 0.24, TITLE, ramp(P, 0.0, 0.12)));\n\t\to = over(o, QUIET, lineRise(sTD2DInputs[2], p, vec2(960.0 - 0.5 * uText.y, 118.0), 0.24, CAPTION, ramp(P, 0.84, 0.96)));\n\t}\n\tfragColor = TDOutputSwizzle(o);\n}\n"
  dat_content_format: text
- name: script_layout_callbacks
  type: textDAT
  parameters:
    language: python
  position: [200, -120]
  dock: script_layout
  dat_content: "# the chosen scene's rows of the texts table, handed to kit_core/layout items()\ndef onCook(scriptOp):\n\tscene = parent.Mograph.par.Scene.eval()\n\ttexts = op('texts')\n\trows = [[cell.val for cell in texts.row(i)[1:]] for i in range(1, texts.numRows) if texts[i, 'scene'] == scene]\n\top('../kit_core/layout').module.items(scriptOp, op('text_glyphs'), rows)\n"
  dat_content_format: text
annotations:
- name: annotate1
  mode: annotate
  title: Staged explainers
  text: 'The five explanations that need their own staging: a before and after diff, a network beside its YAML, Embot standing on operators, a heap leaving the origin for the grid, and the rebuild-on-open timeline. glsl_scene has one function per scene. The scenes table holds titles and captions; the texts table holds every label and line of code with its position and the Progress window it shows in (kit_core/layout items()). Positions in the two are twins.'
  position: [130, -670]
  size: [1470, 930]
  color: [0.13, 0.28, 0.32]
  opacity: 0.25
