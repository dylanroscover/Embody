format: tdxn
version: '2.1'
build: 1
generator: Embody/6.2.68
td_build: 099.2025.33230
network_path: /marketing_lab/explainer_scene
options:
  include_dat_content: false
  include_storage: true
type_defaults:
  tableDAT:
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textDAT:
    flags:
    - viewer
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
  textTOP:
    parameters:
      alignx: left
      aligny: bottom
      dispmethod: scalable
      fontsizexunit: pixels
      outputresolution: custom
      resolutionh: 1080
      resolutionw: 1920
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
type: baseCOMP
custom_pars:
  Scene:
  - name: Scene
    style: Menu
    default: diff
    menuSource: tdu.TableMenu(me.op('scenes'), labelCol='label')
    help: Which explanation to play. These five have their own staging in glsl_scene; the scenes table inside holds each title and caption, and the texts table every label and line of code with the Progress window it shows in.
  - name: Backdrop
    style: Toggle
    default: true
    help: On = the scene sits on the brand dark with a grid of dots and fills the frame. Off = only the scene, with alpha, to lay over a shot.
  - name: Progress
    style: Float
    default: 1
    clampMin: true
    clampMax: true
    help: 0 = empty frame, 1 = the whole scene with its caption. Animate 0 to 1 to play it.
parameters:
  parentshortcut: Mograph
color: [0.3, 0.5, 0.9]
tags:
- tdxn
operators:
