operators:
- name: layout
  type: textDAT
  parameters:
    language: python
  position: [1000, 0]
  dat_content: "# kit_core/layout: the text layout every type-driven piece shares. A piece's script_layout\n# callback is one call into here. The table it writes has two consumers:\n#   the piece's text_glyphs (spec DAT): text, x, y -- y is the baseline\n#   the piece's shader (datto_cells -> uCells): a, b, c, d -- one vec4 per row\n#     row 1        font size, numLines, numCells, total launch time\n#     line rows    x0, x1, band bottom, band top\n#     cell rows    x0, x1, line (+ a fraction: the cell's tag), launch time (ascending)\n# kit_core/glsl_type is the reader. Lengths named \"in font sizes\" scale with the Text TOP's\n# fontsizex; times are launch units (one glyph launches per unit).\n\n\ndef measurer(glyphs):\n\tcache = {}\n\n\tdef width(s):\n\t\tif s not in cache:\n\t\t\tcache[s] = glyphs.evalTextSize(s)[0]\n\t\treturn cache[s]\n\treturn width\n\n\ndef wrap(words, limit, width, balance):\n\tdef greedy(limit):\n\t\tlines, cur = [], []\n\t\tfor w in words:\n\t\t\tif cur and width(' '.join(cur + [w])) > limit:\n\t\t\t\tlines.append(cur)\n\t\t\t\tcur = [w]\n\t\t\telse:\n\t\t\t\tcur.append(w)\n\t\treturn lines + [cur] if cur else lines\n\n\tlines = greedy(limit)\n\t# balanced: the tightest limit that keeps the line count\n\twhile balance and limit > 200:\n\t\ttighter = greedy(limit - 20)\n\t\tif len(tighter) > len(lines):\n\t\t\tbreak\n\t\tlines, limit = tighter, limit - 20\n\treturn lines\n\n\ndef write(scriptOp, size, lineRows, cellRows, tail):\n\ttotal = cellRows[-1][6] + tail if cellRows else 1\n\tscriptOp.clear()\n\tscriptOp.appendRow(['text', 'x', 'y', 'a', 'b', 'c', 'd'])\n\tscriptOp.appendRow(['', 0, 0, size, len(lineRows), len(cellRows), total])\n\tscriptOp.appendRows(lineRows + cellRows)\n\n\ndef build(scriptOp, glyphs, text, anchor=(960, 540), blockAlign=0.5, lineAlign=0.5, maxWidth=1560,\n\t\tbalance=True, indent=0.0, pitch=1.16, cap=0.727, descent=0.25, accent='', wordGap=2.5,\n\t\tjitter=0.0, tail=7.0, step=1.0, pad=0.1):\n\t\"\"\"Wrap text into lines around anchor and write one cell per glyph.\n\n\tanchor: x is where the block's blockAlign point sits (0 its left edge, 0.5 its middle),\n\ty the middle of its cap heights. lineAlign places each line inside the block.\n\tindent (a gutter left of the text, part of the block), pitch, cap and descent are in font\n\tsizes. accent is a string of words whose cells get tag 0.5. jitter stays below 1 so launch\n\ttimes stay ascending. tail is the launch time left after the last glyph starts. step is the\n\tlaunch time between glyphs (0, with wordGap and jitter 0, lands the whole text at once).\n\tpad widens each line's first and last cell, in font sizes.\n\t\"\"\"\n\tsize = glyphs.par.fontsizex.eval()\n\twidth = measurer(glyphs)\n\tlines = wrap(text.split(), maxWidth, width, balance)\n\taccents = {w.strip('.,!?:;').lower() for w in accent.split()}\n\tblock = max([width(' '.join(l)) for l in lines] or [0])\n\tleft = anchor[0] - blockAlign * (block + indent * size) + indent * size\n\ttop = anchor[1] - cap * size / 2 + (len(lines) - 1) / 2 * pitch * size\n\tlineRows, cellRows = [], []\n\tn = wordCount = 0\n\tfor i, lineWords in enumerate(lines):\n\t\ts = ' '.join(lineWords)\n\t\tx0 = left + (block - width(s)) * lineAlign\n\t\tbase = top - i * pitch * size\n\t\tbottom = base - descent * size\n\t\tlineRows.append([s, x0, base, x0, x0 + width(s), bottom, bottom + pitch * size])\n\t\tpos = 0\n\t\tedge = x0 - pad * size\n\t\tfor word in lineWords:\n\t\t\ttag = 0.5 * (word.strip('.,!?:;').lower() in accents)\n\t\t\tfor j in range(len(word)):\n\t\t\t\tright = x0 + width(s[:pos + j + 1])\n\t\t\t\tlaunch = n * step + wordCount * wordGap + jitter * ((n * 7919) % 13) / 13\n\t\t\t\tcellRows.append(['', 0, 0, edge, right, i + tag, launch])\n\t\t\t\tedge = right\n\t\t\t\tn += 1\n\t\t\tpos += len(word) + 1\n\t\t\twordCount += 1\n\t\tcellRows[-1][4] += pad * size\n\twrite(scriptOp, size, lineRows, cellRows, tail)\n\n\ndef chips(scriptOp, glyphs, labels, anchor=(960, 540), maxWidth=1640, padX=0.7, gap=0.45,\n\t\tpitch=2.3, cap=0.727, stagger=3.0, tail=6.0):\n\t\"\"\"Lay labels out
    as centred rows of chips and write one cell per chip.\n\n\tA cell spans its chip, carries the label for text_glyphs, and its tag is index / 16.\n\tpadX (inside a chip), gap (between chips) and pitch (between rows) are in font sizes.\n\t\"\"\"\n\tsize = glyphs.par.fontsizex.eval()\n\twidth = measurer(glyphs)\n\trows, cur, used = [], [], 0.0\n\tfor label in labels:\n\t\tw = width(label) + 2 * padX * size\n\t\tif cur and used + gap * size + w > maxWidth:\n\t\t\trows.append(cur)\n\t\t\tcur, used = [], 0.0\n\t\tused += (gap * size if cur else 0.0) + w\n\t\tcur.append((label, w))\n\tif cur:\n\t\trows.append(cur)\n\n\ttop = anchor[1] - cap * size / 2 + (len(rows) - 1) / 2 * pitch * size\n\tlineRows, cellRows = [], []\n\tn = 0\n\tfor i, row in enumerate(rows):\n\t\tx = anchor[0] - (sum(w for _, w in row) + gap * size * (len(row) - 1)) / 2\n\t\tbase = top - i * pitch * size\n\t\tbottom = base + cap * size / 2 - pitch * size * 0.39\n\t\tlineRows.append(['', 0, 0, x, x, bottom, bottom + pitch * size * 0.78])\n\t\tfor label, w in row:\n\t\t\tcellRows.append([label, x + padX * size, base, x, x + w, i + n / 16, n * stagger])\n\t\t\tx += w + gap * size\n\t\t\tn += 1\n\t\tlineRows[-1][4] = x - gap * size\n\twrite(scriptOp, size, lineRows, cellRows, tail)\n\n\nICONS = ('tile', 'file', 'blob', 'mark', 'git', 'chat', 'server', 'machine', 'embot', 'ok', 'bad', 'clock',\n\t'eye', 'cloud', 'term', 'banana', 'stack', 'lock')     # the explainer's shader draws them by this index\nFAMILIES = ('top', 'chop', 'sop', 'pop', 'dat', 'mat', 'comp')\nEDGE_STYLES = ('solid', 'dashed', 'both')\n\n\ndef diagram(scriptOp, glyphs, nodes, edges, centre=(960, 560), drop=100):\n\t\"\"\"Parse a small diagram and write it for the explainer's shader.\n\n\tnodes: groups split by '|', nodes inside a group by ','. Each node is\n\t'id icon label x y [family]': x y in px from centre (y up), '_' in a label is a space,\n\t'-' is no label, family colours a tile. Groups arrive in order.\n\tedges: 'from to [dashed|both]' split by ','. An edge draws just before its target's group.\n\tRows after the meta row (numNodes, numEdges, numGroups, font size): two per node --\n\t(x, y, icon + family / 16, group), carrying the label for text_glyphs, then\n\t(label half width, label baseline, 0, 0) -- then one per edge: (from, to, style, target's group).\n\tdrop is how far a label's baseline sits below its node, px.\n\t\"\"\"\n\tsize = glyphs.par.fontsizex.eval()\n\twidth = measurer(glyphs)\n\tgroups = nodes.split('|')\n\tindex, nodeRows = {}, []\n\tfor g, group in enumerate(groups):\n\t\tfor item in group.split(','):\n\t\t\tf = item.split()\n\t\t\tif len(f) < 5:\n\t\t\t\tcontinue\n\t\t\tlabel = '' if f[2] == '-' else f[2].replace('_', ' ')\n\t\t\tx, y = centre[0] + float(f[3]), centre[1] + float(f[4])\n\t\t\tfamily = FAMILIES.index(f[5]) if len(f) > 5 else 0\n\t\t\tindex[f[0]] = (len(index), g)\n\t\t\tnodeRows.append([label, x - width(label) / 2, y - drop, x, y, ICONS.index(f[1]) + family / 16, g])\n\t\t\tnodeRows.append(['', 0, 0, width(label) / 2, y - drop, 0, 0])\n\tedgeRows = []\n\tfor item in edges.split(','):\n\t\tf = item.split()\n\t\tif len(f) >= 2 and f[0] in index and f[1] in index:\n\t\t\tedgeRows.append(['', 0, 0, index[f[0]][0], index[f[1]][0], EDGE_STYLES.index(f[2]) if len(f) > 2 else 0, index[f[1]][1]])\n\tscriptOp.clear()\n\tscriptOp.appendRow(['text', 'x', 'y', 'a', 'b', 'c', 'd'])\n\tscriptOp.appendRow(['', 0, 0, len(index), len(edgeRows), len(groups), size])\n\tscriptOp.appendRows(nodeRows + edgeRows)\n\n\ndef choice(comp, field, par):\n\t\"\"\"For a piece whose first preset is 'custom': that par's own value when custom is chosen, else the preset's field.\"\"\"\n\trow = comp.par.Preset.eval()\n\treturn comp.par[par].eval() if row == 'custom' else comp.op('presets')[row, field].val\n\n\ndef preset(comp, field, override=''):\n\t\"\"\"The text a piece should show: its override par if that is filled, else the chosen preset's field.\"\"\"\n\ttyped = comp.par[override].eval() if override else ''\n\treturn typed or comp.op('presets')[comp.par.Preset.eval(), field].val\n"
  dat_content_format: text
- name: glsl_type
  type: textDAT
  parameters:
    language: glsl
  position: [600, 0]
  dat_content: "// kit_core/glsl_type: reads the table kit_core/layout writes. Include after glsl_common.\n// The piece needs input 0 = the Text TOP that table positions, and an Arrays entry uCells\n// (vec4, texture buffer) fed by its datto_cells. One vec4 per table row:\n//   [0]              font size, numLines, numCells, total launch time\n//   [1..numLines]    line x0, x1, band bottom, band top\n//   [1+numLines..]   cell x0, x1, line (+ a fraction: the cell's tag), launch time (ascending)\nuniform samplerBuffer uCells;\n\n// bounding box of every line band: xy the low corner, zw the high corner\nvec4 typeBounds() {\n\tint numLines = int(texelFetch(uCells, 0).y);\n\tvec2 lo = vec2(1e6), hi = vec2(-1e6);\n\tfor (int i = 0; i < 8; i++) {\n\t\tif (i >= numLines) break;\n\t\tvec4 ln = texelFetch(uCells, 1 + i);\n\t\tlo = min(lo, ln.xz);\n\t\thi = max(hi, ln.yw);\n\t}\n\treturn vec4(lo, hi);\n}\n\n// Glyphs rising into their line bands, one cell after another. launch runs 0 to the table's\n// total; charDur is how many launch units a glyph takes to settle; rise is how far below its\n// line it starts, in font sizes. Returns x: ink coverage, y: that cell's tag.\nvec2 typeRise(vec2 p, float launch, float charDur, float rise) {\n\tvec4 meta = texelFetch(uCells, 0);\n\tint numLines = int(meta.y);\n\tvec2 ink = vec2(0.0);\n\tfor (int i = 0; i < 256; i++) {\n\t\tif (i >= int(meta.z)) break;\n\t\tvec4 c = texelFetch(uCells, 1 + numLines + i);\n\t\tif (p.x < c.x || p.x >= c.y) continue;\n\t\tvec4 ln = texelFetch(uCells, 1 + int(c.z));\n\t\tif (p.y < ln.z || p.y >= ln.w) continue;\n\t\tfloat u = (launch - c.w) / charDur;\n\t\tif (u <= 0.0) continue;\n\t\tfloat srcY = p.y + (1.0 - easeOutBack(u)) * rise * meta.x;\n\t\tif (srcY < ln.z || srcY >= ln.w) continue;\n\t\tfloat a = texture(sTD2DInputs[0], vec2(p.x, srcY) / uTDOutputInfo.res.zw).a;\n\t\tif (a > ink.x) ink = vec2(a, fract(c.z));\n\t}\n\treturn ink;\n}\n\n// Glyphs appearing in launch order, the way typing does. cursor gets x: the right edge of the\n// last cell shown (the first line's left edge before any), y: its band bottom.\n// Returns x: ink coverage, y: that cell's tag.\nvec2 typeOn(vec2 p, float launch, out vec2 cursor) {\n\tvec4 meta = texelFetch(uCells, 0);\n\tint numLines = int(meta.y);\n\tvec4 first = texelFetch(uCells, 1);\n\tcursor = first.xz;\n\tvec2 ink = vec2(0.0);\n\tfor (int i = 0; i < 256; i++) {\n\t\tif (i >= int(meta.z)) break;\n\t\tvec4 c = texelFetch(uCells, 1 + numLines + i);\n\t\tif (launch <= c.w) break;\n\t\tvec4 ln = texelFetch(uCells, 1 + int(c.z));\n\t\tcursor = vec2(c.y, ln.z);\n\t\tif (p.x >= c.x && p.x < c.y && p.y >= ln.z && p.y < ln.w) {\n\t\t\tfloat a = texture(sTD2DInputs[0], p / uTDOutputInfo.res.zw).a;\n\t\t\tif (a > ink.x) ink = vec2(a, fract(c.z));\n\t\t}\n\t}\n\treturn ink;\n}\n"
  dat_content_format: text
- name: glsl_common
  type: textDAT
  parameters:
    language: glsl
  position: [200, 0]
  dat_content: "// kit_core/glsl_common: shared by every kit shader through  #include <../kit_core/glsl_common>\n// Palette, easing, signed distances, compositing and the Embody mark.\n\nconst vec3 INK = vec3(0.933, 0.965, 0.933);\nconst vec3 GREEN = vec3(0.431, 0.902, 0.408);\nconst vec3 MINT = vec3(0.788, 0.961, 0.769);\nconst vec3 DARK = vec3(0.094, 0.118, 0.118);\nconst vec3 RED = vec3(0.957, 0.38, 0.36);\nconst vec3 QUIET = vec3(0.6, 0.72, 0.62);\nconst vec3 BANANA = vec3(0.98, 0.84, 0.22);\nconst vec2 FRAME = vec2(1920.0, 1080.0);\nconst float PI = 3.14159265;\n// TD's own family colours (ui.colors), lifted 1.3x so they read on a dark frame:\n// TOP, CHOP, SOP, POP, DAT, MAT, COMP (COMP is 0.19 in TD; lifted further or it sinks into the dark)\nconst vec3 FAMILY[7] = vec3[7](\n\tvec3(0.533, 0.468, 0.748), vec3(0.5, 0.715, 0.358), vec3(0.377, 0.65, 0.91), vec3(0.41, 0.397, 0.975),\n\tvec3(0.748, 0.468, 0.65), vec3(0.813, 0.754, 0.364), vec3(0.468, 0.494, 0.494));\n\nfloat hash(float n) {\n\treturn fract(sin(n * 12.9898 + 4.1414) * 43758.5453);\n}\n\n// 0 at a, 1 at b, clamped: where a beat sits inside Progress\nfloat ramp(float x, float a, float b) {\n\treturn clamp((x - a) / (b - a), 0.0, 1.0);\n}\n\nfloat easeOutExpo(float u) {\n\treturn u >= 1.0 ? 1.0 : 1.0 - exp2(-10.0 * max(u, 0.0));\n}\n\nfloat easeOutCubic(float u) {\n\tu = 1.0 - clamp(u, 0.0, 1.0);\n\treturn 1.0 - u * u * u;\n}\n\nfloat easeInCubic(float u) {\n\tu = clamp(u, 0.0, 1.0);\n\treturn u * u * u;\n}\n\nfloat easeInOutCubic(float u) {\n\tu = clamp(u, 0.0, 1.0);\n\treturn u < 0.5 ? 4.0 * u * u * u : 1.0 - 4.0 * (1.0 - u) * (1.0 - u) * (1.0 - u);\n}\n\n// overshoots to 1.1 on the way to 1\nfloat easeOutBack(float u) {\n\tfloat v = clamp(u, 0.0, 1.0) - 1.0;\n\treturn 1.0 + 2.70158 * v * v * v + 1.70158 * v * v;\n}\n\nmat2 rot(float a) {\n\treturn mat2(cos(a), sin(a), -sin(a), cos(a));\n}\n\nfloat sdRoundBox(vec2 p, vec2 b, float r) {\n\tvec2 q = abs(p) - b + r;\n\treturn length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;\n}\n\nfloat sdSegment(vec2 p, vec2 a, vec2 b) {\n\tvec2 pa = p - a, ba = b - a;\n\treturn length(pa - ba * clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0));\n}\n\n// coverage of a shape from its signed distance in px, one pixel of antialiasing\nfloat fill(float d) {\n\treturn 1.0 - smoothstep(-0.5, 0.5, d);\n}\n\n// premultiplied \"over\": lay colour col at coverage a onto o\nvec4 over(vec4 o, vec3 col, float a) {\n\treturn mix(o, vec4(col, 1.0), a);\n}\n\n// A Text TOP set at the frame's bottom left (alignx left, aligny bottom) carries its baseline\n// a fixed fraction of its font size up: 0.24 for Inter, 0.23 for Cascadia Mono. textAt samples\n// such a texture so the left end of the baseline lands on origin, scaled by s about that point.\n// baseline is in px (fraction x font size).\nfloat textAt(sampler2D tex, vec2 p, vec2 origin, float baseline, float s) {\n\tvec2 q = (p - origin) / s + vec2(0.0, baseline);\n\tif (q.x < 0.0 || q.y < 0.0 || q.x >= FRAME.x || q.y >= FRAME.y) return 0.0;\n\treturn texture(tex, q / FRAME).a;\n}\n\n// a whole line of such text rising out of its own band: u 0-1, baseline as a fraction of size\nfloat lineRise(sampler2D tex, vec2 p, vec2 origin, float baseline, float size, float u) {\n\tif (u <= 0.0 || p.y < origin.y - 0.25 * size || p.y > origin.y + 0.95 * size) return 0.0;\n\treturn textAt(tex, p + vec2(0.0, (1.0 - easeOutBack(u)) * 0.9 * size), origin, baseline * size, 1.0);\n}\n\n// Banana.tif, TouchDesigner's default image: where the banana's middle is (uv) and how far it\n// reaches. bananaAt draws it from a Movie File In of that file, half size s px, at local\n// position q; premultiplied.\nconst vec2 BANANA_AT = vec2(0.5488, 0.5326);\nconst vec2 BANANA_FIT = 300.0 / vec2(1280.0, 720.0);\n\nvec4 bananaAt(sampler2D tex, vec2 q, float s) {\n\tif (max(abs(q.x), abs(q.y)) > s * 1.1) return vec4(0.0);\n\treturn texture(tex, BANANA_AT + q / s * BANANA_FIT);\n}\n\n// The e of the Embody mark in units of its 64-unit artboard (docs/assets/embody-mark.svg), y up,\n// e centred. draw 0-1 sweeps the arc on
    from its tail and extends the bar. The orb is separate.\nconst vec2 MARK_ORB = vec2(13.0, -12.0);\nconst float MARK_ORB_R = 4.7;\n\nfloat sdMark(vec2 q, float draw) {\n\tconst float START = radians(-74.4);\n\tfloat sweep = radians(296.6) * draw;\n\tfloat dArc = mod(START - atan(q.y, q.x), 2.0 * PI) <= sweep\n\t\t? abs(length(q) - 17.0)\n\t\t: min(length(q - 17.0 * vec2(cos(START), sin(START))), length(q - 17.0 * vec2(cos(START - sweep), sin(START - sweep))));\n\treturn min(dArc, sdSegment(q, vec2(-16.0, 0.0), vec2(mix(-16.0, 15.5, draw), 0.0))) - 4.25;\n}\n\n// the whole mark at centre c, unit px per artboard unit, laid over o\nvec4 overMark(vec4 o, vec2 p, vec2 c, float unit) {\n\tvec2 q = (p - c) / unit;\n\to = over(o, GREEN, fill(sdMark(q, 1.0) * unit));\n\treturn over(o, MINT, fill((length(q - MARK_ORB) - MARK_ORB_R) * unit));\n}\n"
  dat_content_format: text
annotations:
- name: annotate1
  mode: annotate
  title: Shared core
  text: 'What every piece shares, so nothing is written twice. glsl_common: palette, easing, signed distances, the Embody mark, banana and text sampling. glsl_type: the per-glyph engine. layout: the Python that wraps text, places chips and resolves presets. Pieces reach these as ../kit_core/..., so keep them siblings.'
  position: [130, -70]
  size: [1070, 330]
  color: [0.13, 0.28, 0.32]
  opacity: 0.25
