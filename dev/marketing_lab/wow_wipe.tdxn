- name: annotate1
  mode: annotate
  title: Five wipes
  text: 'One shader, no inputs, five styles: dive into the mark, operator tiles, grid dissolve, scan line, blinds. All cover the frame from Progress 0.47 to 0.53.'
  position: [855, -190]
  size: [745, 450]
  color: [0.13, 0.28, 0.32]
  opacity: 0.25
