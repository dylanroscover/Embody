    - object: op('./TestRunnerExt').module.TestRunnerExt(me)
      name: TestRunnerExt
      promote: true
    - {}
    - {}
    - {}
  position: [400, 102]
  size: [160, 130]
  color: [0.3, 0.5, 0.9]
