  color: [0.67, 0.67, 0.67]
- name: execute_src_ctrl
  type: executeDAT
  parameters:
    fromop: =parent()
    projectpresave: true
    projectpostsave: true
    file: embody/execute_src_ctrl.py
    syncfile: true
  flags:
  - viewer
  position: [-625, 120]
  size: [130, 90]
  color: [0.9, 0.3, 0.4]
  tags:
  - py
- name: ndiout1_grouptable
  type: tableDAT
  flags:
  - viewer
  - -showDocked
  position: [150, -320]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  dock: ndiout1
  dat_content:
  - - groups
  dat_content_format: table
annotations:
- name: annotation_execute_src_ctrl
  mode: annotate
  title: Build & Release Manager
  text: |-
    Runs on every project save (onProjectPreSave):

    1. Auto-increments the patch version
       (e.g. v5.0.32 -> v5.0.33)

    2. Updates README.md with the new
       version number and TD build

    3. Deletes the previous release .tox

    4. Saves a fresh Embody-vX.Y.Z.tox
       to the /release folder
  position: [-775, 50]
  size: [440, 480]
  color: [0.18, 0.22, 0.28]
  opacity: 0.9
  bodyFontSize: 12
- name: annotation_externalizations
  mode: annotate
  title: Externalization Tracking
  text: Master tracking table for all externalized operators. Managed exclusively by Embody — never edit directly.
  position: [-250, -50]
  size: [223, 292]
  color: [0.18, 0.22, 0.28]
  opacity: 0.9
- name: annotation_unit_tests
  mode: annotate
  title: Unit Tests
  text: Embody's test suites for verifying externalization, path resolution, and MCP tool behavior.
