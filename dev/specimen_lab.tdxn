      min: 1.0
      max: 3.0
      clampMin: true
      clampMax: true
      normMin: 1.0
      normMax: 3.0
    - name: Gutter
      style: Float
      label: Channel Gutter
      default: 0.06
      max: 0.2
      clampMin: true
      clampMax: true
