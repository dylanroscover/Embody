- name: plasma_interference
  type: baseCOMP
  custom_pars:
    Plasma:
    - name: Scale
      style: Float
      startSection: true
      default: 6
      min: 1.0
      max: 20.0
      clampMin: true
      clampMax: true
      normMin: 1.0
      normMax: 20.0
      help: Spatial frequency of the sine fields. Low = broad lava-lamp blobs; high = dense fine plasma.
      value: 4.5
    - name: Speed
      style: Float
      default: 1
      max: 4.0
      clampMin: true
      clampMax: true
      normMax: 4.0
      help: Animation speed. 1 = gentle flow; 0 freezes a still (the TOP keeps cooking, frame is identical).
    - name: Warp
      style: Float
      default: 1.2
      max: 3.0
      clampMin: true
      clampMax: true
      normMax: 3.0
      help: Domain-warp amount. 0 = flat sliding stripes; higher bends the coords into a flowing liquid swirl.
      value: 1.4
    - name: Complexity
      style: Float
      label: Interference
      default: 1
      max: 2.0
      clampMin: true
      clampMax: true
      normMax: 2.0
      help: Detune between the two sine fields. 0 = one clean plasma; higher beats them into shimmering moire.
    - name: Palette
      style: Float
      label: Palette Hue
      startSection: true
      clampMin: true
      clampMax: true
      help: Rotates the cyclic cosine palette through the full hue ring. Loops seamlessly 1.0 -> 0.0.
      value: 0.33
    - name: Contrast
      style: Float
      default: 0.4
      clampMin: true
      clampMax: true
      help: Palette saturation/contrast (onto a 0.6 base in the shader). Low = pastel; high = punchy neon.
      value: 0.55
    Output:
      $t: output_2
      Resw: 1080
      Resh: 1350
  position: [1200, -800]
  tdn_ref: specimen_lab/plasma_interference.tdxn
- name: mandala_export_driver
  type: textDAT
  position: [2000, -700]
  size: [130, 90]
  color: [0.67, 0.67, 0.67]
  storage:
    state:
      prior_rt: true
      prior_tm: realtime
      prior_loop: 1
      prior_ll: 20
      prior_sm: 2
      i: 300
      n: 300
      fps: 30
      status: done
      error: ''
      written: 300
  dat_content: |
    # Frame-accurate loop export driver for the mandala specimen (lives OUTSIDE the specimen COMP, never exported).
    # start() sets non-realtime + manual time, then a run() chain writes one unique frame per real TD frame
    # through mandala_export (stop-frame movie, Add Frame per pulse). Every exit path goes through finish(),
    # which restores Realtime and the specimen's parameters.

    def _ops():
        return op('mandala'), op('mandala_export'), op('mandala_export_info'), op('mandala_export_driver')

    def start(seconds=20.0, fps=60, path=''):
        m, mfo, info, drv = _ops()
        n = int(round(seconds * fps))
        st = {'prior_rt': project.realTime, 'prior_tm': m.par.Timemode.eval(), 'prior_loop': int(m.par.Loop.eval()),
              'prior_ll': m.par.Looplength.eval(), 'prior_sm': m.par.Speedmult.eval(),
              'i': 0, 'n': n, 'fps': fps, 'status': 'running', 'error': '', 'written': -1}
        drv.store('state', st)
        project.realTime = False
        m.par.Timemode = 'manual'
        m.par.Loop = 1
        # Loop Length is in animation seconds (after Speed Multiplier); the video spans `seconds` of wall time
        m.par.Looplength = seconds * max(st['prior_sm'], 1e-6)
        m.par.Manualtime = 0
        mfo.par.file = path
        mfo.par.type = 'stopframemovie'
        mfo.par.pause = 1
        mfo.par.record = 1
        run("op('mandala_export_driver').module.step()", fromOP=drv, delayFrames=3)

    def step():
        m, mfo, info, drv = _ops()
        st = drv.fetch('state')
        try:
            i = st['i']
            m.par.Manualtime = i / float(st['fps'])
            out = m.op('out1')
            out.cook(force=True)
            if not out.cookedThisFrame:
                raise RuntimeError('out1 did not cook at frame %d' % i)
            mfo.par.addframe.pulse()
            ch = info['total_frames_dropped']
            dropped = ch.eval() if ch is not None else 0
            if dropped > 0:
                raise RuntimeError('frame dropped at %d (total_frames_dropped=%d)' % (i, dropped))
            st['i'] = i + 1
            drv.store('state', st)
            if st['i'] < st['n']:
                run("op('mandala_export_driver').module.step()", fromOP=drv, delayFrames=1)
            else:
                finish('done')
        except Exception as e:
            st['error'] = str(e)
            drv.store('state', st)
            finish('error')

    def finish(status):
        m, mfo, info, drv = _ops()
        st = drv.fetch('state')
        mfo.par.record = 0
        project.realTime = st['prior_rt']
        m.par.Timemode = st['prior_tm']
        m.par.Loop = st['prior_loop']
        m.par.Looplength = st['prior_ll']
        m.par.Speedmult = st['prior_sm']
        st['status'] = status
        ch = info['total_frames_written']
        st['written'] = ch.eval() if ch is not None else -1
        drv.store('state', st)
  dat_content_format: text
