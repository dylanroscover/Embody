  dat_content_format: text
- name: thermite_and_freon_record
  type: moviefileoutTOP
  parameters:
    videocodec: prores
    videocodectype: prores422hq
    videopixelformat: yuv42210bit
    maxthread: 8
  position: [2000, -1000]
  tags:
  - tdxn_exclude:file
  inputs:
  - thermite_and_freon
- name: thermite_and_freon_render
  type: textDAT
  parameters:
    language: python
  position: [2000, -1400]
  dat_content: |
    """Offline render of the thermite_and_freon specimen (dev tooling: lives outside the specimen, never exports).

    start(seconds) records thermite_and_freon's out1 non-realtime through thermite_and_freon_record (ProRes 422 HQ, 60 fps) into
    OUT, one run()-chained step per real frame: every frame cooks fully, a dropped frame aborts. Each step logs the
    suns' state, and sound_events logs the sound it would have played, for an offline mix (ig_export.py). Every exit
    goes through _finish, which restores Realtime.
    """
    import json
    from pathlib import Path

    OUT = Path('C:/tmp/thermite_and_freon_render')
    S = {'running': False}


    def start(seconds: float = 20.0) -> str:
        if S.get('running'):
            return 'already running'
        OUT.mkdir(parents=True, exist_ok=True)
        S.clear()
        S.update(running=True, prior=project.realTime, n=int(round(seconds * 60)), frames=[], err=None, done=False)
        mfo = op('thermite_and_freon_record')
        mfo.par.record = 0
        mfo.par.file = str(OUT / 'thermite_and_freon_master.mov')
        snd = op('thermite_and_freon/sound_events').module
        snd.capture = []
        S['sound'] = snd.capture
        project.realTime = False
        run('args[0].module._begin()', me, delayFrames=2)
        return 'started: %d frames' % S['n']


    def cancel() -> None:
        _finish('cancelled')


    def _begin() -> None:
        try:
            op('thermite_and_freon_record').par.record = 1
            S['abs0'] = absTime.frame
            run('args[0].module._step()', me, delayFrames=1)
        except Exception as e:
            _finish('begin: %r' % e)


    def _step() -> None:
        if not S.get('running'):
            return
        try:
            info = op('thermite_and_freon_record_info')
            written = int(info['total_frames_written'])
            if int(info['total_frames_dropped']):
                _finish('dropped frame near %d' % written)
                return
            orb = op('thermite_and_freon/glsl_orbit').numpyArray()[0]
            S['frames'].append([absTime.frame, written] + [round(float(v), 5) for v in orb[0]])
            if written >= S['n']:
                _finish(None)
            else:
                run('args[0].module._step()', me, delayFrames=1)
        except Exception as e:
            _finish('step: %r' % e)


    def _finish(err) -> None:
        if not S.get('running'):
            return
        S['running'] = False
        try:
            op('thermite_and_freon_record').par.record = 0
        finally:
            project.realTime = S.get('prior', True)
            op('thermite_and_freon/sound_events').module.capture = None
        S['err'] = err
        log = {'err': err, 'fps': 60, 'abs0': S.get('abs0'), 'frames': S['frames'], 'sound': S.get('sound', []),
               'columns': 'absFrame, written, p1x, p1y, p2x, p2y'}
        (OUT / 'render_log.json').write_text(json.dumps(log))
        S['done'] = True
  dat_content_format: text
- name: thermite_and_freon_record_info
  type: infoCHOP
  parameters:
    op: thermite_and_freon_record
  position: [2400, -1000]
