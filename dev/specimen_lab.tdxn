- name: mandala_export_driver
  type: textDAT
  position: [2000, -700]
  storage:
    state:
      prior_rt: true
      prior_tm: realtime
      prior_loop: 1
      prior_ll: 20
      prior_sm: 2
      i: 300
      n: 300
      fps: 30
      status: done
      error: ''
      written: 300
  dat_content: |
    # Frame-accurate loop export driver for the mandala specimen (lives OUTSIDE the specimen COMP, never exported).
    # start() sets non-realtime + manual time, then a run() chain writes one unique frame per real TD frame
    # through mandala_export (stop-frame movie, Add Frame per pulse). Every exit path goes through finish(),
    # which restores Realtime and the specimen's parameters.

    def _ops():
        return op('mandala'), op('mandala_export'), op('mandala_export_info'), op('mandala_export_driver')

    def start(seconds=20.0, fps=60, path=''):
        m, mfo, info, drv = _ops()
        n = int(round(seconds * fps))
        st = {'prior_rt': project.realTime, 'prior_tm': m.par.Timemode.eval(), 'prior_loop': int(m.par.Loop.eval()),
              'prior_ll': m.par.Looplength.eval(), 'prior_sm': m.par.Speedmult.eval(),
              'i': 0, 'n': n, 'fps': fps, 'status': 'running', 'error': '', 'written': -1}
        drv.store('state', st)
        project.realTime = False
        m.par.Timemode = 'manual'
        m.par.Loop = 1
        # Loop Length is in animation seconds (after Speed Multiplier); the video spans `seconds` of wall time
        m.par.Looplength = seconds * max(st['prior_sm'], 1e-6)
        m.par.Manualtime = 0
        mfo.par.file = path
        mfo.par.type = 'stopframemovie'
        mfo.par.pause = 1
        mfo.par.record = 1
        run("op('mandala_export_driver').module.step()", fromOP=drv, delayFrames=3)

    def step():
        m, mfo, info, drv = _ops()
        st = drv.fetch('state')
        try:
            i = st['i']
            m.par.Manualtime = i / float(st['fps'])
            out = m.op('out1')
            out.cook(force=True)
            if not out.cookedThisFrame:
                raise RuntimeError('out1 did not cook at frame %d' % i)
            mfo.par.addframe.pulse()
            ch = info['total_frames_dropped']
            dropped = ch.eval() if ch is not None else 0
            if dropped > 0:
                raise RuntimeError('frame dropped at %d (total_frames_dropped=%d)' % (i, dropped))
            st['i'] = i + 1
            drv.store('state', st)
            if st['i'] < st['n']:
                run("op('mandala_export_driver').module.step()", fromOP=drv, delayFrames=1)
            else:
                finish('done')
        except Exception as e:
            st['error'] = str(e)
            drv.store('state', st)
            finish('error')

    def finish(status):
        m, mfo, info, drv = _ops()
        st = drv.fetch('state')
        mfo.par.record = 0
        project.realTime = st['prior_rt']
        m.par.Timemode = st['prior_tm']
        m.par.Loop = st['prior_loop']
        m.par.Looplength = st['prior_ll']
        m.par.Speedmult = st['prior_sm']
        st['status'] = status
        ch = info['total_frames_written']
        st['written'] = ch.eval() if ch is not None else -1
        drv.store('state', st)
  dat_content_format: text
- name: thermite_and_freon_driver
  type: executeDAT
