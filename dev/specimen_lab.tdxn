    - name: Lockindicators
      style: Float
      label: Lock Indicators
      default: 1
      max: 2.0
      clampMin: true
      clampMax: true
      normMax: 2.0
      help: Corner PTP-lock dot brightness.
    - name: Bloom
      style: Float
      startSection: true
      default: 1.1
      max: 3.0
      clampMin: true
      clampMax: true
      normMax: 3.0
      help: Bloom over lit crosspoints + packets.
    - name: Glitch
      style: Float
      default: 0.8
      max: 2.0
      clampMin: true
      normMax: 2.0
      help: 'VHS glitch amount: chroma split, tape jitter/tear, rolling scanlines, grain.'
