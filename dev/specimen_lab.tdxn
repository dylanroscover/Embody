  - name: glsl_strata_pixel
    type: textDAT
    parameters:
      extension: frag
    flags:
    - viewer
    position: [1400, -120]
    dock: glsl_strata
    dat_content: |
      // glsl_strata -- the layered field, built as a stack of scales:
      //   coarse : soft brightness PULSES (a cosine wave bent by very low-frequency noise) that roll down
      //            the frame once per loop -- the ripple. Smooth and wide, never hard-edged.
      //   mid    : the STRATA -- a vertical ramp cycling Bands times per frame height, displaced by
      //            domain-warped fBm; fract() of that is the stratum phase, which indexes the 1D color
      //            ramp on input 0. The rims are jagged silhouettes that only morph slowly (Evolution).
      //   fine   : contour layers that follow every fold, a caustic web, and fibrous grain.
      // Output 0 = the SOFT strata (ramp + relief + light + pulses + color) -- what glsl_prism splits per channel.
      // Output 1 = detail composited back after the split: xy = flow field (encoded 0.5+0.5*w),
      // z = caustic web mask, w = fine contour layers.
      // Output 2 = the streak direction field: the local "up" through the layers (gradient of the
      // displaced ramp coordinate, encoded 0.5+0.5*dir), so glsl_streaks can bend its rays with the folds.
      uniform vec4 uField;    // x=Scale (noise cycles / frame height)  y=Stretch (horizontal elongation)  z=Warp  w=Detail (octaves)
      uniform vec4 uStrata;   // x=Bands (strata / frame height)  y=Displace (ramp displacement, in strata)  z=Relief  w=Edgesoft
      uniform vec4 uTime;     // x=loop phase 0..1  y=Evolution (loop circle radius)  z=Seed  w=Glow
      uniform vec4 uCaustic;  // x=Cellscale (cells / frame height)  y=Cellwidth  z=Tint  w=Iridescence
      uniform vec4 uLayers;   // x=Layers (fine contour lines per stratum)  y=Scroll (pulses per loop)  z=Grain  w unused
      uniform vec4 uPulse;    // x=Pulses (pulse bands / frame height)  y=Pulsegain  z,w unused

      layout(location = 0) out vec4 fragColor;
      layout(location = 1) out vec4 fragField;
      layout(location = 2) out vec4 fragDir;

      const float TAU = 6.28318530718;

      // One swap point for the noise. TD's built-in 4D simplex: xy = space, zw = a point on a circle
      // that the loop phase walks around, so every frame of the loop is a fresh field and frame N meets frame 0.
      float n4(vec4 v){ return TDSimplexNoise(v); }

      // Anisotropy fades with the octave: the broad shapes are long horizontal ridges (stretched by
      // `stretch`), the fine octaves are isotropic, so every rim is a jagged mountain profile.
      float fbm(vec2 q, vec2 zw, int oct, float stretch){
          float sum = 0.0, amp = 0.5, norm = 0.0;
          float sx = 1.0 / stretch;
          for(int i = 0; i < 6; i++){
              if(i >= oct) break;
              sum  += amp * n4(vec4(q.x * sx, q.y, zw));
              norm += amp;
              q *= 2.03; zw *= 1.15; amp *= 0.5;    // zw grows slowly: fine detail must not flicker
              sx = min(1.0, sx * 1.8);
          }
          return sum / norm;   // ~[-1, 1]
      }

      vec2 hash22(vec2 p){
          vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
          p3 += dot(p3, p3.yzx + 33.33);
          return fract((p3.xx + p3.yz) * p3.zy);
      }

      // Worley cells whose feature points orbit with the loop phase (periodic -> seamless). Returns (F1, F2).
      vec2 worley(vec2 x, float phase){
          vec2 n = floor(x), f = fract(x);
          float f1 = 8.0, f2 = 8.0;
          for(int j = -1; j <= 1; j++){
              for(int i = -1; i <= 1; i++){
                  vec2 g = vec2(float(i), float(j));
                  vec2 o = 0.5 + 0.4 * sin(TAU * (hash22(n + g) + phase));
                  vec2 r = g + o - f;
                  float d = dot(r, r);
                  if(d < f1){ f2 = f1; f1 = d; }
                  else if(d < f2){ f2 = d; }
              }
          }
          return sqrt(vec2(f1, f2));
      }

      void main(){
          vec2 res = uTDOutputInfo.res.zw;                  // output res: zw = width, height
          float aspect = res.x / res.y;
          vec2 uv = vUV.st;
          vec2 p = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);  // frame height = 1 unit, y up

          float scale   = max(0.05, uField.x);
          float stretch = max(0.2, uField.y);
          float warp    = uField.z;
          int   oct     = int(clamp(uField.w, 1.0, 6.0));

          float phase = uTime.x;
          vec2  loop  = uTime.y * vec2(cos(TAU * phase), sin(TAU * phase)) + uTime.z;
          float drift = uLayers.y * phase;                   // the pulses' downward travel, in pulse bands

          vec2 q = p * scale;

          // Low-frequency warp vector: bends the layers into folds.
          vec2 w = vec2(n4(vec4(q * 0.5 + 7.3, loop)),
                        n4(vec4(q * 0.5 - 3.1, loop + 5.0)));
          vec2 qw = q + warp * w;

          // Stratum-scale flow field for the prism pass: regions the size of a layer get displaced.
          // STATIC in time on purpose -- a fixed curved-space lens the layers scroll and morph through;
          // an evolving field made the whole image swim. (simplex sits mostly within +-0.5, so it is
          // doubled: the field reaches full strength in patches.)
          vec2 wd = clamp(2.0 * vec2(n4(vec4(q * 1.8 + 19.0, uTime.z + 3.7, -2.1)),
                                     n4(vec4(q * 1.8 - 14.0, uTime.z - 6.3, 4.4))), -1.0, 1.0);

          // ---- mid scale: the strata ----
          float n = fbm(qw, loop + 11.0, oct, stretch);
          float v = uv.y * uStrata.x + uStrata.y * n;        // the displaced ramp coordinate (the rims do not scroll)
          float s = fract(v);                                // s = 0 just above a rim (lit top), s = 1 just below (shadow)

          // Soften the cliff: blend the shadow end of the ramp back into the lit start over Edgesoft of a period.
          float soft = max(uStrata.w, 0.001);
          vec3 col = texture(sTD2DInputs[0], vec2(s, 0.5)).rgb;
          vec3 top = texture(sTD2DInputs[0], vec2(0.0, 0.5)).rgb;
          col = mix(col, top, smoothstep(1.0 - soft, 1.0, s));

          // Relief: lit from above. Slope of v per unit height, sign-normalized so it does not depend on the API's y.
          float dvdy = dFdy(v) / dFdy(uv.y);
          float lit = 1.0 + uStrata.z * clamp(dvdy / max(uStrata.x, 0.01) - 1.0, -1.0, 1.0);
          col *= lit;

          // ---- coarse scale: light and pulses ----
          // A broad drifting field: positive lifts regions toward white (the backlit fog), negative sinks
          // whole layers into shadow, so the frame keeps deep darks as well as blown highlights.
          float g = fbm(q * 0.4 + 23.0, loop * 0.7 + 3.0, 2, 1.5);
          float shade = mix(1.0 - clamp(1.5 * uTime.w, 0.0, 0.6), 1.0, smoothstep(-0.6, -0.05, g));
          col *= shade;
          float fog = uTime.w * smoothstep(0.05, 0.75, g);
          col *= 1.0 + 1.0 * fog;
          col = mix(col, vec3(0.97), 0.3 * fog * fog);

          // The pulses: a cosine wave in a coordinate that is mostly y, bent by very coarse smooth noise
          // and a little by the strata folds, rolling down `Scroll` bands per loop. Squared for wide soft
          // crests; it only modulates brightness, so there is no edge anywhere in it.
          float nc = fbm(q * 0.35 + 47.0, loop * 0.5 + 13.0, 2, 2.0);
          float pc = uv.y * uPulse.x + drift + 0.45 * nc + 0.12 * n;
          float pulse = 0.5 + 0.5 * cos(TAU * pc);
          pulse *= pulse;
          col *= 1.0 + uPulse.y * (pulse - 0.5);            // centred low: the troughs dim about as much as the crests lift

          // ---- color ----
          // Two soft hue mechanisms on the soft base (the prism pass only fringes the edges): a regional
          // temperature field tints mids and shadows rust or steel blue, and a thin-film hue cycle that
          // rides the pulse coordinate lays pastel pink / peach / azure bands that roll down with the light.
          float L = dot(col, vec3(0.2126, 0.7152, 0.0722));
          float temp = n4(vec4(q * 0.9 + 31.0, loop * 0.6 + 9.0));
          float tk = uCaustic.z * (1.0 - smoothstep(0.7, 1.0, L));
          col *= vec3(1.0 + 0.55 * tk * temp, 1.0 - 0.06 * tk * temp, 1.0 - 0.75 * tk * temp);   // rust, not yellow
          float phi = TAU * (pc * 2.0 + v * 0.5) + 2.0 * temp;
          float ik = uCaustic.w * smoothstep(0.25, 0.7, L);
          col *= 1.0 + ik * vec3(cos(phi), 0.6 * cos(phi + 2.6), cos(phi + 4.2));

          // ---- fine scale ----
          // Fibrous grain: two octaves of small noise, strongest in the mids.
          float fg = fbm(q * 5.0 + 61.0, loop + 51.0, 2, 1.0);
          col *= 1.0 + uLayers.z * fg * (0.4 + 0.6 * smoothstep(0.15, 0.7, L));

          // Fine sediment layers: thin contour lines of the SAME displaced coordinate, so they follow every
          // fold and run continuously through the rims. A fine noise bends the line phase and gates the
          // amplitude, so they read as brushed fibres in patches.
          float grain = n4(vec4(q * vec2(6.0, 12.0) + 5.0, loop + 21.0));
          float fine = pow(0.5 + 0.5 * cos(TAU * v * uLayers.x + 3.0 * grain), 10.0);
          fine *= smoothstep(-0.4, 0.4, n4(vec4(q * 1.5 + 41.0, loop + 33.0)));

          // Caustic web on the warped coordinates, so the veins follow the folds; brightness varies along each vein.
          vec2 pw = qw / scale;
          vec2 F  = worley(pw * uCaustic.x * vec2(0.75, 1.0), phase);
          float web = 1.0 - smoothstep(0.0, max(uCaustic.y, 0.005), F.y - F.x);
          web *= web;
          web *= 0.55 + 0.45 * n4(vec4(pw * 6.0, loop + 17.0));

          // Streak direction: the local "up" through the layers. Taken from a 2-octave version of the same
          // coordinate so the field is smooth (screen derivatives of the full fBm would jitter the rays).
          float vLow = uv.y * uStrata.x + uStrata.y * fbm(qw, loop + 11.0, 2, stretch);
          vec2 gv = vec2(dFdx(vLow) / dFdx(uv.x) / aspect, dFdy(vLow) / dFdy(uv.y));   // per unit height
          vec2 dir = normalize(gv + vec2(0.0, 1e-4));

          fragColor = TDOutputSwizzle(vec4(col, 1.0));
          fragField = TDOutputSwizzle(vec4(0.5 + 0.5 * wd, web, fine));
          fragDir   = TDOutputSwizzle(vec4(0.5 + 0.5 * dir, 0.0, 1.0));
      }
    dat_content_format: text
  - name: glsl_streaks_info
    type: infoDAT
    parameters:
      op: glsl_streaks
    position: [4150, -120]
    dock: glsl_streaks
    dat_read_only: true
  - name: renderselect_disp
    type: renderselectTOP
    parameters:
      bufferindex: 1
    position: [2400, -400]
  - name: renderselect_grad
    type: renderselectTOP
    parameters:
      bufferindex: 2
    position: [3800, -400]
  - name: glsl_prism_compute
    type: textDAT
    flags:
    - viewer
    - -showDocked
    position: [2650, -120]
    dock: glsl_prism
    dat_content: "// Example Compute Shader\n\n// uniform float exampleUniform;\n\nlayout (local_size_x = 8, local_size_y = 4) in;\nvoid main()\n{\n\t// This code is running 1:1 per pixel, so early-exit\n\t// if this thread overhangs the edge of the output\n\tif (any(greaterThanEqual(ivec2(gl_GlobalInvocationID.xy), ivec2(uTDOutputInfo.res.zw))))\n\t\treturn;\n\n\tvec4 color;\n\t//color = texelFetch(sTD2DInputs[0], ivec2(gl_GlobalInvocationID.xy), 0);\n\tcolor = vec4(1.0);\n\t// We need to use TDImageStoreOutput() so that 8-bit textures that are sRGB\n\t// encoded can be written to correctly from incoming linear values.\n\t// imageStore() does not do this automatically, while pixel shader outputs do.\n\tTDImageStoreOutput(0, gl_GlobalInvocationID, color);\n}\n"
    dat_content_format: text
  - name: glsl_streaks_pixel
    type: textDAT
    parameters:
      extension: frag
    flags:
    - viewer
    position: [4000, -120]
    dock: glsl_streaks
    dat_content: |
      // glsl_streaks -- the rain. Seeds (thin bright vertical features) sit in input 0's alpha; input 1 is
      // the direction field from glsl_strata buffer 2: the local "up" through the layers (the gradient of
      // the displaced ramp coordinate). Every seed is walked along that field both ways -- a bounded
      // line-integral max-filter -- so the rays rise perpendicular to the curved layers instead of straight
      // up the screen, with a random length per column so they are ragged, then screened over the color.
      uniform vec4 uStreak;   // x = Streaklength (half-length, fraction of frame height)  y = Streakgain  z,w unused
      out vec4 fragColor;
      const int N = 24;

      vec2 dirAt(vec2 uv){ return texture(sTD2DInputs[1], uv).xy * 2.0 - 1.0; }

      void main(){
          vec2 uv  = vUV.st;
          vec2 res = uTD2DInfos[0].res.zw;
          vec2 toUV = vec2(res.y / res.x, 1.0);           // a step in height units -> uv
          vec4 base = texture(sTD2DInputs[0], uv);
          float colBin  = floor(uv.x * res.x / 3.0);
          float colRand = fract(sin(colBin * 78.233) * 43758.5453);
          float halfLen = uStreak.x * (0.35 + 0.65 * colRand);
          float stepLen = halfLen / float(N);
          float st = base.a;
          for(int s = -1; s <= 1; s += 2){                // up the layers, then down
              vec2 p = uv;
              vec2 d = dirAt(p) * float(s);
              for(int i = 1; i <= N; i++){
                  vec2 nd = dirAt(p);
                  if(dot(nd, d) < 0.0) nd = -nd;          // keep walking the same way through the field
                  d = normalize(nd + vec2(0.0, 1e-5));
                  p += d * stepLen * toUV;
                  float t = float(i) / float(N);
                  st = max(st, texture(sTD2DInputs[0], p).a * (1.0 - t * t));
              }
          }
          // screen, not add: a streak lights up mids and shadows and vanishes into the white
          vec3 col = base.rgb + st * uStreak.y * (1.0 - clamp(base.rgb, 0.0, 1.0));
          fragColor = TDOutputSwizzle(vec4(col, 1.0));
      }
    dat_content_format: text
  - name: glsl_strata_compute
    type: textDAT
    flags:
    - viewer
    - -showDocked
    position: [1250, -120]
    dock: glsl_strata
    dat_content: "// Example Compute Shader\n\n// uniform float exampleUniform;\n\nlayout (local_size_x = 8, local_size_y = 4) in;\nvoid main()\n{\n\t// This code is running 1:1 per pixel, so early-exit\n\t// if this thread overhangs the edge of the output\n\tif (any(greaterThanEqual(ivec2(gl_GlobalInvocationID.xy), ivec2(uTDOutputInfo.res.zw))))\n\t\treturn;\n\n\tvec4 color;\n\t//color = texelFetch(sTD2DInputs[0], ivec2(gl_GlobalInvocationID.xy), 0);\n\tcolor = vec4(1.0);\n\t// We need to use TDImageStoreOutput() so that 8-bit textures that are sRGB\n\t// encoded can be written to correctly from incoming linear values.\n\t// imageStore() does not do this automatically, while pixel shader outputs do.\n\tTDImageStoreOutput(0, gl_GlobalInvocationID, color);\n}\n"
    dat_content_format: text
  - name: glsl_streaks_compute
    type: textDAT
    flags:
    - viewer
    - -showDocked
    position: [3850, -120]
    dock: glsl_streaks
    dat_content: "// Example Compute Shader\n\n// uniform float exampleUniform;\n\nlayout (local_size_x = 8, local_size_y = 4) in;\nvoid main()\n{\n\t// This code is running 1:1 per pixel, so early-exit\n\t// if this thread overhangs the edge of the output\n\tif (any(greaterThanEqual(ivec2(gl_GlobalInvocationID.xy), ivec2(uTDOutputInfo.res.zw))))\n\t\treturn;\n\n\tvec4 color;\n\t//color = texelFetch(sTD2DInputs[0], ivec2(gl_GlobalInvocationID.xy), 0);\n\tcolor = vec4(1.0);\n\t// We need to use TDImageStoreOutput() so that 8-bit textures that are sRGB\n\t// encoded can be written to correctly from incoming linear values.\n\t// imageStore() does not do this automatically, while pixel shader outputs do.\n\tTDImageStoreOutput(0, gl_GlobalInvocationID, color);\n}\n"
    dat_content_format: text
  annotations:
  - name: annotate1
    mode: annotate
    title: 1. Stratum ramp
    text: 'One period of a stratum, indexed by phase s: s=0 is the lit top of a layer (warm rim line), s rises through grey fog to a brown shadow just under the next rim (s=1). Edit the docked keys table to restyle every layer at once.'
    position: [330, -190]
    size: [270, 450]
    color: [0.32, 0.26, 0.18]
    opacity: 0.25
  - name: annotate2
    mode: annotate
    title: 2. Layered field (ramp displaced by noise)
    text: 'v = y*Bands + Displace*fbm(warped coords) + Scroll*phase; fract(v) picks the ramp phase, and Scroll sweeps the rims down one stratum per loop (the ripple). Anisotropy fades with the octave: long ridges, jagged mountain-profile rims. 4D simplex on a circle -> seamless loop. Buffer 0 = soft strata (+ relief, light, tint, iridescence); buffer 1 = flow field, caustic web, fine layers; buffer 2 = the layer-normal direction field for the streaks.'
    position: [1180, -190]
    size: [570, 450]
    color: [0.13, 0.28, 0.32]
    opacity: 0.25
  - name: annotate3
    mode: annotate
    title: 3. Prism split
    text: 'renderselect_disp pulls buffer 1 out of glsl_strata. glsl_prism is a Displace TOP run three times: red takes 1-d of the flow, green 1, blue 1+d -> orange/azure fringes on every edge. The caustic web and fine layers are composited AFTER the split so they never leave green/magenta copies. Alpha = streak seeds.'
    position: [2330, -470]
    size: [820, 730]
    color: [0.3, 0.18, 0.32]
    opacity: 0.25
  - name: annotate4
    mode: annotate
    title: 4. Light streaks
    text: 'renderselect_grad pulls buffer 2: the local UP through the layers (gradient of the displaced ramp coordinate). Seeds (thin bright verticals, in the prism pass alpha) are walked along that field both ways with a bounded max-filter and a random length per column, so the rays rise perpendicular to the curved layers, then screened over the color.'
    position: [3730, -470]
    size: [620, 730]
    color: [0.18, 0.3, 0.2]
    opacity: 0.25
  - name: annotate5
    mode: annotate
    title: 5. Finish
    text: Bloom TOP on the highlights only (pre-black level 0.8) for the backlit haze, then out1.
    position: [4930, -70]
    size: [670, 330]
    color: [0.3, 0.3, 0.2]
    opacity: 0.25
- name: crosspoint_matrix
  type: baseCOMP
  custom_pars:
    Matrix:
    - name: Gridsize
      style: Int
      label: Matrix Size (N)
      startSection: true
      default: 20
      min: 4.0
      max: 40.0
      clampMin: true
      clampMax: true
      normMin: 4.0
      normMax: 40.0
      help: NxN crosspoint matrix dimension.
    - name: Activeroutes
      style: Int
      label: Active Routes
      default: 16
      min: 1.0
      max: 20.0
      clampMin: true
      clampMax: true
      normMin: 1.0
      normMax: 20.0
      help: Routes lit simultaneously.
    - name: Latticeglow
      style: Float
      label: Lattice Glow
      default: 1
      max: 2.0
      clampMin: true
      clampMax: true
      normMax: 2.0
      help: Brightness of the dim unlit grid.
    - name: Crosspointglow
      style: Float
      label: Crosspoint Glow
      default: 1
      max: 2.0
      clampMin: true
      clampMax: true
      normMax: 2.0
      help: Brightness of lit crosspoints + paths.
    - name: Packetspeed
      style: Float
      label: Packet Speed
      startSection: true
      default: 0.5
      max: 2.0
      clampMin: true
      clampMax: true
      normMax: 2.0
      help: Speed packets race the L-path. 0 freezes.
    - name: Packetdensity
      style: Int
      label: Packet Density
      default: 8
      min: 1.0
      max: 10.0
      clampMin: true
      clampMax: true
      normMin: 1.0
      normMax: 10.0
      help: Packets per active route.
    - name: Streams
      style: Int
      label: Essence Streams
      default: 3
      min: 1.0
      max: 3.0
      clampMin: true
      clampMax: true
      normMin: 1.0
      normMax: 3.0
      help: Separated essence colors (cyan/green/amber).
    - name: Ptprate
      style: Float
      label: PTP Beat Rate
      startSection: true
      default: 0.5
      min: 0.1
      max: 2.0
      clampMin: true
      clampMax: true
      normMin: 0.1
      normMax: 2.0
      help: PTP sync pulse frequency.
    - name: Reconfigrate
      style: Float
      label: Reconfigure Rate
      default: 0.25
      min: 0.05
      clampMin: true
      clampMax: true
      normMin: 0.05
      help: How often active routes reconfigure.
    - name: Lockindicators
      style: Float
      label: Lock Indicators
      default: 1
      max: 2.0
      clampMin: true
      clampMax: true
      normMax: 2.0
      help: Corner PTP-lock dot brightness.
    - name: Bloom
      style: Float
      startSection: true
      default: 1.1
      max: 3.0
      clampMin: true
      clampMax: true
      normMax: 3.0
      help: Bloom over lit crosspoints + packets.
    - name: Glitch
      style: Float
      default: 0.8
      max: 2.0
      clampMin: true
      normMax: 2.0
      help: 'VHS glitch amount: chroma split, tape jitter/tear, rolling scanlines, grain.'
    Output:
      $t: output
  position: [800, 0]
  color: [0.3, 0.5, 0.9]
  tags:
  - tdxn
  tdn_ref: specimen_lab/crosspoint_matrix.tdxn
- name: reaction_diffusion
  type: baseCOMP
  custom_pars:
    Output:
    - name: Resw
      style: Int
      default: 3840
      min: 256.0
      max: 7680.0
      clampMin: true
      clampMax: true
      normMin: 256.0
      normMax: 7680.0
      help: Output width (px), 4K. The reaction sim stays bounded 16:9; out1 upscales to this.
    - name: Resh
      style: Int
      default: 2160
      min: 256.0
      max: 7680.0
      clampMin: true
      clampMax: true
      normMin: 256.0
      normMax: 7680.0
      help: Output height (px), 4K.
  position: [1200, -400]
  color: [0.3, 0.5, 0.9]
  tags:
  - tdxn
  tdn_ref: specimen_lab/reaction_diffusion.tdxn
- name: plasma_interference
  type: baseCOMP
  custom_pars:
    Plasma:
    - name: Scale
      style: Float
      startSection: true
      default: 6
      min: 1.0
      max: 20.0
      clampMin: true
      clampMax: true
      normMin: 1.0
      normMax: 20.0
      help: Spatial frequency of the sine fields. Low = broad lava-lamp blobs; high = dense fine plasma.
      value: 4.5
    - name: Speed
      style: Float
      default: 1
      max: 4.0
      clampMin: true
      clampMax: true
      normMax: 4.0
      help: Animation speed. 1 = gentle flow; 0 freezes a still (the TOP keeps cooking, frame is identical).
    - name: Warp
      style: Float
      default: 1.2
      max: 3.0
      clampMin: true
      clampMax: true
      normMax: 3.0
      help: Domain-warp amount. 0 = flat sliding stripes; higher bends the coords into a flowing liquid swirl.
      value: 1.4
    - name: Complexity
      style: Float
      label: Interference
      default: 1
      max: 2.0
      clampMin: true
      clampMax: true
      normMax: 2.0
      help: Detune between the two sine fields. 0 = one clean plasma; higher beats them into shimmering moire.
    - name: Palette
      style: Float
      label: Palette Hue
      startSection: true
      clampMin: true
      clampMax: true
      help: Rotates the cyclic cosine palette through the full hue ring. Loops seamlessly 1.0 -> 0.0.
      value: 0.33
    - name: Contrast
      style: Float
      default: 0.4
      clampMin: true
      clampMax: true
      help: Palette saturation/contrast (onto a 0.6 base in the shader). Low = pastel; high = punchy neon.
      value: 0.55
    Output:
      $t: output_2
      Resw: 1080
      Resh: 1350
  position: [1200, -800]
  color: [0.3, 0.5, 0.9]
  tags:
  - tdxn
  tdn_ref: specimen_lab/plasma_interference.tdxn
