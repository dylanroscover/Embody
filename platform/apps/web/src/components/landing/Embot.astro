---
// Embot, the Envoy build-bot, on the web. A port of envoy_viz.botDance():
// the same eight network-box parts (body, arms, legs, head, two eyes) plus the
// speech bubble, the same hop (parabolic arc, ease-out, landing squash), the
// same gesture set (wave, shrug, pump, and the occasional full-body dance),
// blink, happy squint, the cool-to-warm "thinking" hue, and the typewriter
// bubble with its spinner. Coordinates are TD network units, y up, scaled by
// data-scale. Two modes: "walk" hops left to right across its container,
// exits, waits, re-enters; "stand" stays put and gestures in place.
//
// One <script> serves every [data-embot] on the page; it draws a single
// static frame under prefers-reduced-motion and pauses while off-screen.
interface Props {
  mode?: "walk" | "stand";
  scale?: number;
}
const { mode = "stand", scale = 1 } = Astro.props;
// DOM order is draw order: body first, head and eyes last (as in TD).
const parts = ["body", "arm_l", "arm_r", "leg_l", "leg_r", "head", "eye_l", "eye_r"];
---

<div class="embot" data-embot data-mode={mode} data-scale={scale} aria-hidden="true">
  {parts.map((p) => (
    <div class={`embot__part${p.startsWith("eye") ? " embot__part--eye" : ""}`} data-part={p}></div>
  ))}
  <div class="embot__bubble">
    <span class="embot__bubble-title">Embot</span>
    <span class="embot__bubble-text"></span>
  </div>
</div>

<script>
  // Part table from envoy_viz._VIZ_BOT_PARTS: name, centre offset x/y, base
  // width/height (network units, y up), is_eye.
  type Part = { name: string; ox: number; oy: number; w: number; h: number; eye: boolean; el: HTMLElement };
  const PART_TABLE: Array<[string, number, number, number, number, boolean]> = [
    ["body", 0, 0, 30, 34, false],
    ["arm_l", -22, 3, 9, 26, false],
    ["arm_r", 22, 3, 9, 26, false],
    ["leg_l", -8, -29, 11, 24, false],
    ["leg_r", 8, -29, 11, 24, false],
    ["head", 0, 31, 34, 26, false],
    ["eye_l", -8, 35, 12, 13, true],
    ["eye_r", 8, 35, 12, 13, true]
  ];
  // Constants mirror envoy_viz's _VIZ_* values (seconds, network units).
  const JUMP_DUR = 0.52;
  const ENTRANCE_DUR = 0.95;
  const JUMP_ARC = 55;
  const SQUASH = 0.07;
  const HOP_DWELL = 0.8;
  const GESTURE_GAP_MIN = 4;
  const GESTURE_GAP_MAX = 11;
  const GESTURE_DUR = 1.6;
  const DANCE_DUR = 3.0;
  const WAVE_LIFT = 28;
  const WAVE_FREQ = 14;
  const WAVE_AMP = 9;
  const WARM_S = 14;
  const COOL_HUE = 0.58;
  const WARM_HUE = 0.0;
  const SQUINT_GAP_MIN = 9;
  const SQUINT_GAP_MAX = 17;
  const SQUINT_DUR = 1.1;
  const SQUINT_FLATTEN = 0.74;
  const SQUINT_WIDEN = 1.18;
  // TD's bubble is 185x74 at 11px; the web one keeps the width and trims the
  // height to the two lines it actually holds.
  const BUBBLE_W = 185;
  const BUBBLE_H = 46;
  const BUBBLE_LIFT = 58;
  const FIGURE_BOTTOM = 41; // legs' lowest edge below the anchor (29 + 24 / 2)
  // What he says: EnvoyExt._OP_DESCRIPTIONS and _actionText's verb fallbacks,
  // past tense, exactly as in the network editor.
  const CAPTIONS = [
    "seeded a noise texture",
    "laid down a gradient",
    "filled a solid colour",
    "softened it with a blur",
    "graded brightness & contrast",
    "blended two layers",
    "fed the output back in",
    "ran a GLSL shader",
    "rendered the scene",
    "marked the output",
    "set an oscillator going",
    "smoothed the motion",
    "added some jitter",
    "built a point grid",
    "displaced them on the GPU",
    "set up the camera",
    "added a light",
    "opened a sub-network",
    "wired up a web client",
    "built noise1",
    "wired up level1",
    "tuned blur1",
    "rebuilt kandinsky",
    "worked on out1"
  ];

  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  const pick = (not: string) => {
    let c = not;
    for (let i = 0; i < 8 && c === not; i++) c = CAPTIONS[Math.floor(Math.random() * CAPTIONS.length)] ?? c;
    return c;
  };
  function hsv(h: number, s: number, v: number): string {
    const i = Math.floor(h * 6);
    const f = h * 6 - i;
    const p = v * (1 - s), q = v * (1 - f * s), t = v * (1 - (1 - f) * s);
    const sextant: Array<[number, number, number]> = [[v, t, p], [q, v, p], [p, v, t], [p, q, v], [t, p, v], [v, p, q]];
    const [r, g, b] = sextant[i % 6] as [number, number, number];
    return `rgb(${Math.round(r * 255)}, ${Math.round(g * 255)}, ${Math.round(b * 255)})`;
  }

  class Embot {
    root: HTMLElement;
    mode: string;
    S: number;
    parts: Part[];
    bubble: HTMLElement;
    bubbleText: HTMLElement;
    w = 0;
    h = 0;
    originY = 0;
    visible = true;
    // hop state (units)
    from = { x: 0, y: 0 };
    target = { x: 0, y: 0 };
    jumpT0 = 0;
    jumpDur = JUMP_DUR;
    nextHop = 0;
    exitedAt = -1;
    // gesture / blink / squint schedules
    gestureType = -1;
    gestureStart = 0;
    gestureEnd = 0;
    nextGesture = 0;
    blinkEnd = 0;
    nextBlink = 0;
    squintEnd = 0;
    nextSquint = 0;
    // speech + colour
    caption = "";
    speechT0 = 0;
    lastActivity = 0;
    nextCaption = 0;
    lastLine = "";

    constructor(root: HTMLElement) {
      this.root = root;
      this.mode = root.dataset.mode || "stand";
      this.S = parseFloat(root.dataset.scale || "1") || 1;
      this.parts = PART_TABLE.map(([name, ox, oy, w, h, eye]) => ({
        name, ox, oy, w, h, eye, el: root.querySelector(`[data-part="${name}"]`) as HTMLElement
      }));
      this.bubble = root.querySelector(".embot__bubble") as HTMLElement;
      this.bubbleText = root.querySelector(".embot__bubble-text") as HTMLElement;
      this.resize();
      this.reset(now());
    }

    resize(): void {
      const r = this.root.getBoundingClientRect();
      this.w = r.width;
      this.h = r.height;
      const floor = this.mode === "walk" ? 28 : 16; // px between the feet and the container's bottom
      this.originY = this.h - floor - FIGURE_BOTTOM * this.S;
      if (this.mode === "stand") {
        this.from = { x: this.w / (2 * this.S), y: 0 };
        this.target = { ...this.from };
      }
    }

    // A fresh entrance: off-screen left, first hop in.
    reset(t: number): void {
      const W = this.w / this.S;
      if (this.mode === "walk") {
        this.from = { x: -110, y: 0 };
        this.target = { x: rand(60, 140), y: 0 };
        this.jumpT0 = t;
        this.jumpDur = ENTRANCE_DUR;
      } else {
        this.from = { x: W / 2, y: 0 };
        this.target = { x: W / 2, y: 0 };
        this.jumpT0 = t - 1; // already landed
        this.jumpDur = JUMP_DUR;
      }
      this.exitedAt = -1;
      this.nextHop = t + this.jumpDur + rand(HOP_DWELL, 2.2);
      this.act(t);
      this.gestureEnd = 0;
      this.nextGesture = t + rand(1.5, 4);
      this.nextBlink = t + rand(2, 5.5);
      this.nextSquint = t + SQUINT_GAP_MIN;
      this.nextCaption = t + rand(5, 9);
    }

    // A new action: caption, typewriter restart, colour back to cool.
    act(t: number): void {
      this.caption = pick(this.caption);
      this.speechT0 = t;
      this.lastActivity = t;
    }

    hop(t: number): void {
      const W = this.w / this.S;
      this.from = { ...this.target };
      this.target = { x: this.target.x + rand(70, 130), y: 0 };
      this.jumpT0 = t;
      this.jumpDur = JUMP_DUR;
      this.nextHop = t + JUMP_DUR + rand(HOP_DWELL, 2.4);
      if (this.target.x > W + 110) this.exitedAt = t + JUMP_DUR; // fully off the right edge after this hop
      this.act(t);
    }

    tick(t: number): void {
      const S = this.S;
      // --- travel (walk mode): hop right, exit, wait, come back ---
      if (this.mode === "walk") {
        if (this.exitedAt >= 0) {
          if (t > this.exitedAt + rand(2.5, 3.5) + 1.5) this.reset(t);
        } else if (t >= this.nextHop && t >= this.gestureEnd) {
          this.hop(t);
        }
      } else if (t >= this.nextCaption) {
        this.act(t);
        this.nextCaption = t + rand(5, 9);
      }
      // --- hop physics (botDance) ---
      const tt = (t - this.jumpT0) / this.jumpDur;
      let sx = 1, sy = 1, px: number, py: number;
      if (tt < 1) {
        const e = 1 - (1 - tt) * (1 - tt);
        px = this.from.x + (this.target.x - this.from.x) * e;
        py = this.from.y + (this.target.y - this.from.y) * e + JUMP_ARC * Math.sin(Math.PI * tt);
        if (tt > 0.82) {
          const k = (tt - 0.82) / 0.18;
          sx = 1 + SQUASH * k;
          sy = 1 - SQUASH * k;
        }
      } else {
        px = this.target.x;
        py = this.target.y;
      }
      const base = { x: px, y: py };
      // --- gestures at random intervals ---
      if (tt >= 1 && t >= this.gestureEnd && t >= this.nextGesture) {
        let g: number;
        if (Math.random() < 0.18) g = 3;
        else {
          g = Math.floor(Math.random() * 3);
          if (g === this.gestureType) g = (g + 1) % 3;
        }
        this.gestureType = g;
        this.gestureStart = t;
        this.gestureEnd = t + (g === 3 ? DANCE_DUR : GESTURE_DUR);
        this.nextGesture = this.gestureEnd + rand(GESTURE_GAP_MIN, GESTURE_GAP_MAX);
      }
      const active = tt >= 1 && t < this.gestureEnd;
      const gi = this.gestureType;
      const gdur = this.gestureEnd - this.gestureStart;
      const gp = t - this.gestureStart;
      const genv = active && gdur > 0 ? Math.sin(Math.PI * (gp / gdur)) : 0;
      if (active && gi === 3) {
        px += Math.round(Math.sin(gp * 6)) * 11 * genv;
        py += Math.abs(Math.sin(gp * 9)) * 7 * genv;
      }
      // --- thinking colour: cool right after an action, warming over 14s ---
      const idle = t - this.lastActivity;
      const f = Math.min(1, Math.max(0, idle / WARM_S));
      const hue = Math.round((COOL_HUE + (WARM_HUE - COOL_HUE) * f) * 36) / 36;
      const skin = hsv(hue, 0.95, 1);
      // --- blink and squint ---
      if (t >= this.nextBlink) {
        this.blinkEnd = t + 0.13;
        this.nextBlink = t + rand(2, 5.5);
      }
      const blinking = t < this.blinkEnd;
      if (t >= this.nextSquint) {
        this.squintEnd = t + SQUINT_DUR;
        this.nextSquint = t + rand(SQUINT_GAP_MIN, SQUINT_GAP_MAX);
      }
      const squinting = t < this.squintEnd;
      // --- place the parts ---
      for (const p of this.parts) {
        let ox = p.ox, oy = p.oy, gw = 1, gh = 1;
        if (active) {
          if (gi === 0 && p.name === "arm_r") {
            oy += WAVE_LIFT * genv;
            ox += Math.sin(gp * WAVE_FREQ) * WAVE_AMP * genv;
          } else if (gi === 1 && (p.name === "arm_l" || p.name === "arm_r")) {
            oy += 16 * genv;
          } else if (gi === 2 && (p.name === "arm_l" || p.name === "arm_r")) {
            oy += WAVE_LIFT * 0.75 * genv;
          } else if (gi === 3) {
            if (p.name === "arm_l") oy += 20 * genv * (0.5 + 0.5 * Math.sin(gp * 7));
            else if (p.name === "arm_r") oy += 20 * genv * (0.5 + 0.5 * Math.sin(gp * 7 + Math.PI));
            else if (p.name === "head" || p.eye) ox += Math.round(Math.sin(gp * 6)) * 4 * genv;
          }
        }
        if (p.eye && squinting) {
          gw *= SQUINT_WIDEN;
          gh *= SQUINT_FLATTEN;
        }
        const pw = p.w * sx * gw, ph = p.h * sy * gh;
        const cx = px + ox * sx, cy = py + oy * sy;
        const st = p.el.style;
        st.left = `${(cx - pw / 2) * S}px`;
        st.top = `${this.originY - (cy + ph / 2) * S}px`;
        st.width = `${pw * S}px`;
        st.height = `${ph * S}px`;
        st.background = p.eye ? (blinking ? skin : "#000") : skin;
      }
      // --- speech bubble: follows the base position, not the dance sway ---
      const bs = this.bubble.style;
      bs.width = `${BUBBLE_W * S}px`;
      bs.height = `${BUBBLE_H * S}px`;
      bs.left = `${base.x * S - (BUBBLE_W * S) / 2}px`;
      bs.top = `${this.originY - (base.y + BUBBLE_LIFT + BUBBLE_H) * S}px`;
      const act = this.caption;
      const shown = act.slice(0, Math.floor((t - this.speechT0) * 45));
      let line: string;
      if (shown.length < act.length) line = shown + "_";
      else if (idle < 4) line = `${"|/-\\"[Math.floor(t * 4) % 4]} ${act}${".".repeat(Math.floor(t * 2) % 4)}`;
      else line = act;
      if (line !== this.lastLine) {
        this.bubbleText.textContent = line;
        this.lastLine = line;
      }
    }
  }

  const now = () => performance.now() / 1000;
  const bots: Embot[] = [];
  for (const el of document.querySelectorAll<HTMLElement>("[data-embot]")) bots.push(new Embot(el));
  if (bots.length) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const b = bots.find((x) => x.root === e.target);
        if (b) b.visible = e.isIntersecting;
      }
    });
    for (const b of bots) io.observe(b.root);
    window.addEventListener("resize", () => { for (const b of bots) b.resize(); });
    if (reduced) {
      // One composed frame: landed, eyes open, caption complete, no motion.
      for (const b of bots) {
        b.jumpT0 = -10;
        b.speechT0 = -10;
        b.lastActivity = -10;
        b.tick(0);
      }
    } else {
      const loop = () => {
        if (!document.hidden) {
          const t = now();
          for (const b of bots) if (b.visible) b.tick(t);
        }
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>
