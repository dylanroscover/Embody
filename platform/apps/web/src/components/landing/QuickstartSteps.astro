---
// Get started -- three steps to flow. (Install collapsed to one step now that
// the hero's paste-in-a-Textport one-liner replaces download + drag-and-drop.)
import { MIN_TD_BUILD } from "../../lib/tdBuild";
---

<section class="section section--start">
  <div class="container">
    <p class="eyebrow">get started</p>
    <h2 class="section__title">three steps to flow.</h2>

    <ol class="steps">
      <li class="step">
        <span class="step__num">01</span>
        <div class="step__body">
          <h3 class="step__title">install</h3>
          <p>Open a Textport (<kbd>alt</kbd>+<kbd>t</kbd>) and paste <a href="#install">the one-liner</a>. Prefer a file? Grab the <code>.tox</code> from <a href="https://github.com/dylanroscover/Embody/releases/latest">GitHub Releases</a> and drop it into your project.</p>
        </div>
      </li>
      <li class="step">
        <span class="step__num">02</span>
        <div class="step__body">
          <h3 class="step__title">enable Envoy</h3>
          <p>Connect your AI assistant to the session with one toggle.</p>
        </div>
      </li>
      <li class="step">
        <span class="step__num">03</span>
        <div class="step__body">
          <h3 class="step__title">tag operators</h3>
          <p>Double-tap <kbd>lctrl</kbd> on any operator to externalize it. Start building.</p>
        </div>
      </li>
    </ol>

    <p class="start__cta">
      <a class="btn btn--outline" href="https://dylanroscover.github.io/Embody/quickstart/">
        read the full Quickstart <span aria-hidden="true">&rarr;</span>
      </a>
    </p>

    <p class="start__meta">Requires TouchDesigner {MIN_TD_BUILD} or later. Works on macOS and Windows.</p>
  </div>
</section>
