    <span class="c-k">style</span><span class="c-p">:</span> <span class="c-s">Menu</span>
    <span class="c-k">default</span><span class="c-p">:</span> <span class="c-s">circle</span>
  <span class="c-p">-</span> <span class="c-k">name</span><span class="c-p">:</span> <span class="c-s">Lineweight</span>
    <span class="c-k">style</span><span class="c-p">:</span> <span class="c-s">Float</span>
    <span class="c-k">default</span><span class="c-p">:</span> <span class="c-n">1.5</span>
    <span class="c-k">value</span><span class="c-p">:</span> <span class="c-n">2.5</span>
<span class="c-k">operators</span><span class="c-p">:</span>
<span class="c-p">-</span> <span class="c-k">name</span><span class="c-p">:</span> <span class="c-s">glsl_kandinsky</span>
