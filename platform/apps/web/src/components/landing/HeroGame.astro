---
// The hero backdrop: a side-scrolling TouchDesigner network for Embot to hop
// through, Mario-style. It is built the way a real network is built: runs of
// operators within one family, wired left to right, and a family change only
// ever through the proper bridge (topToCHOP, chopToTOP, chopToSOP, sopToCHOP,
// sopToPOP, popToSOP, datToCHOP, or a geometryCOMP feeding a renderTOP). A
// chain starts with a generator, runs through filters, and ends in a null.
// Anything that blends takes a second input: a compositeTOP gets a side branch
// forked off the op two back (or a fresh generator when there is none),
// converging into its lower input, so forks and deltas appear as they do in
// a real network. Each run sits inside an annotation that encloses it, titled
// by function. The camera follows Embot, so the world keeps sliding between
// hops (the forward momentum the headline promises), and every tile he lands
// on pulses Envoy's accent exactly like the editor's node pulse. He says what
// each op did, in EnvoyExt's own words. The first chain is the network the
// old blurred backdrop showed. Decorative and aria-hidden; hidden under 860px,
// where the hero stacks.
import Embot from "./Embot.astro";
---

<div class="hero-game" aria-hidden="true">
  <div class="hero-game__world">
    <svg class="hero-game__wires" xmlns="http://www.w3.org/2000/svg"></svg>
  </div>
</div>
<div class="hero__embot" aria-hidden="true">
  <Embot mode="game" scale={0.92} />
</div>

<script>
  import { Embot, registerBot, reducedMotion, now, rand, OP_DESCRIPTIONS, JUMP_DUR, HOP_MIN, HOP_DWELL } from "../../lib/embot";

  type Fam = "TOP" | "CHOP" | "SOP" | "POP" | "DAT" | "COMP";
  type Input = [Tile, number]; // source tile, input slot (0 = top, 1 = bottom)
  type Tile = { x: number; top: number; w: number; h: number; lane: number; name: string; type: string; el: HTMLElement; inputs: Input[]; paths: SVGPathElement[] };

  const SVG_NS = "http://www.w3.org/2000/svg";
  // Everything in the world is drawn at 80% of a network-editor tile at 1:1
  // (150x100); Embot's own scale in the markup below matches.
  const K = 0.8;
  const TILE_W = 150 * K;
  const TILE_H = 100 * K;
  // The game owns the hero's middle third, weighted to the upper half of the
  // screen: the floor (his feet on the lowest lane) sits at mid-height, so
  // lane 0's tiles hang just below it and the upper lanes climb toward the
  // title, where his hops and bubble cross in front of it.
  const floorFromBottom = (h: number) => h / 2 + 8;
  // Lanes step by a whole tile plus its name label, so a side branch placed at
  // the same x on the next lane (a combiner's second input) never overlaps.
  const LANE_STEP = TILE_H + 30;
  const LANES = [0, LANE_STEP, 2 * LANE_STEP]; // tile-top heights above the floor, px
  const GAP_MIN = 70 * K;
  const GAP_MAX = 140 * K;
  // TD family colours (network-editor palette, lightened for the dark ground).
  const FAMILY: Record<Fam, string> = {
    TOP: "#a99bdc", CHOP: "#8fd57f", SOP: "#7fb3ea", POP: "#7fd9c9", DAT: "#e58ad0", COMP: "#b8bdb9"
  };
  const GENERATORS: Record<Fam, string[]> = {
    TOP: ["noiseTOP", "rampTOP", "constantTOP"], CHOP: ["lfoCHOP", "noiseCHOP"], SOP: ["gridSOP"], POP: ["gridPOP"],
    DAT: ["webclientDAT", "textDAT"], COMP: []
  };
  const FILTERS: Record<Fam, string[]> = {
    TOP: ["transformTOP", "blurTOP", "levelTOP", "edgeTOP", "compositeTOP", "hsvadjustTOP", "feedbackTOP", "glslTOP"],
    CHOP: ["mathCHOP", "filterCHOP"], SOP: ["noiseSOP", "transformSOP"], POP: ["noisePOP"], DAT: [], COMP: []
  };
  // Ops that combine inputs and therefore need a second one wired in.
  const COMBINERS = new Set(["compositeTOP"]);
  const NULLS: Partial<Record<Fam, string>> = { TOP: "nullTOP", CHOP: "nullCHOP", SOP: "nullSOP", POP: "nullPOP" };
  // Family bridges: the ONLY way a wire crosses families. "RENDER" is the
  // geometryCOMP + renderTOP pair that brings geometry back into TOPs.
  const BRIDGES: Record<Fam, Array<[string, Fam | "RENDER"]>> = {
    TOP: [["topToCHOP", "CHOP"]],
    CHOP: [["chopToTOP", "TOP"], ["chopToSOP", "SOP"]],
    SOP: [["sopToCHOP", "CHOP"], ["sopToPOP", "POP"], ["geometryCOMP", "RENDER"]],
    POP: [["popToSOP", "SOP"], ["geometryCOMP", "RENDER"]],
    DAT: [["datToCHOP", "CHOP"]],
    COMP: []
  };
  // What he says on the bridges (TD's table has no entries for them).
  const BRIDGE_DESC: Record<string, string> = {
    topToCHOP: "read the pixels into channels",
    chopToTOP: "wrote the channels into pixels",
    chopToSOP: "drove the points with channels",
    sopToCHOP: "read the points into channels",
    sopToPOP: "sent the geometry to the GPU",
    popToSOP: "pulled the points back to the CPU",
    datToCHOP: "turned the table into channels"
  };
  const TITLES: Record<Fam | "RENDER", string[]> = {
    TOP: ["noise pipeline", "compositing", "post", "feedback loop", "output"],
    CHOP: ["modulation", "audio analysis", "smoothing", "control"],
    SOP: ["geometry", "terrain"], POP: ["particles", "point cloud"], DAT: ["data in"], COMP: ["scene"], RENDER: ["render"]
  };
  // The first chain is the sample network the old backdrop showed.
  const SEED_CHAIN: Array<[string, string]> = [
    ["noise_source", "noiseTOP"], ["feedback1", "feedbackTOP"], ["transform1", "transformTOP"],
    ["composite1", "compositeTOP"], ["level1", "levelTOP"], ["out", "nullTOP"]
  ];

  const famOf = (type: string): Fam => (/(TOP|CHOP|SOP|POP|DAT|COMP)$/.exec(type)?.[1] as Fam | undefined) ?? "TOP";
  const pick = <T,>(list: T[]): T => list[Math.floor(Math.random() * list.length)] as T;

  function start(stage: HTMLElement, root: HTMLElement): void {
    const world = stage.querySelector(".hero-game__world") as HTMLElement;
    const wires = stage.querySelector(".hero-game__wires") as SVGSVGElement;
    const tiles: Tile[] = [];
    type Annot = { x: number; w: number; el: HTMLElement; tiles: Tile[] };
    const annots: Annot[] = [];
    const counters: Record<string, number> = {};
    let nextX = 240;
    let lane = 0;
    let family: Fam = "TOP";
    let chainOpen = false; // does the next tile take a wire from the previous one?
    let camX = 0;
    let lastT = now();
    let current: Tile | null = null;
    let nextHopAt = Infinity;
    let started = false;

    const floorY = () => stage.clientHeight - floorFromBottom(stage.clientHeight);

    // A wire leaves the source's right edge at mid-height and enters the
    // destination's left edge at its input slot (upper or lower third).
    function wirePath(from: Tile, to: Tile, slot: number): string {
      const x1 = from.x + from.w, y1 = from.top + from.h / 2;
      const x2 = to.x, y2 = to.top + to.h * (slot === 0 ? 0.36 : 0.64);
      const c = Math.max(24, (x2 - x1) / 2);
      return `M${x1} ${y1} C${x1 + c} ${y1} ${x2 - c} ${y2} ${x2} ${y2}`;
    }

    function addTile(type: string, inputs: Input[], fixedName?: string): Tile {
      const fam = famOf(type);
      const base = type.replace(/(TOP|CHOP|SOP|POP|DAT|COMP)$/, "").replace(/To$/, "to");
      counters[base] = (counters[base] ?? 0) + 1;
      const name = fixedName ?? `${base.toLowerCase()}${counters[base]}`;
      const x = nextX;
      nextX = x + TILE_W + rand(GAP_MIN, GAP_MAX);
      const top = floorY() - (LANES[lane] ?? 0);
      const el = document.createElement("div");
      el.className = "hero-tile";
      el.style.borderLeftColor = FAMILY[fam];
      el.style.left = `${x}px`;
      el.style.top = `${top}px`;
      el.style.width = `${TILE_W}px`;
      el.style.height = `${TILE_H}px`;
      const nameEl = document.createElement("span");
      nameEl.className = "hero-tile__name";
      nameEl.textContent = name;
      const typeEl = document.createElement("span");
      typeEl.className = "hero-tile__type";
      typeEl.textContent = type;
      el.appendChild(nameEl);
      el.appendChild(typeEl);
      world.appendChild(el);
      const tile: Tile = { x, top, w: TILE_W, h: TILE_H, lane, name, type, el, inputs, paths: [] };
      for (const [from, slot] of inputs) {
        const path = document.createElementNS(SVG_NS, "path");
        path.setAttribute("d", wirePath(from, tile, slot));
        wires.appendChild(path);
        tile.paths.push(path);
      }
      tiles.push(tile);
      return tile;
    }

    function stepLane(): void {
      const r = Math.random();
      lane = r < 0.55 ? lane : r < 0.8 ? Math.min(2, lane + 1) : Math.max(0, lane - 1);
    }

    const last = (): Tile | undefined => tiles[tiles.length - 1];

    // A combiner takes a second input from a side branch on another lane at
    // the previous tile's x: a filter forked off the op two back when that op
    // is of the same family, otherwise a fresh generator. Embot visits the
    // side tile on his way (a vertical hop), then the combiner.
    function addCombiner(type: string, run: Tile[], fixedName?: string): Tile {
      const mainPrev = last();
      if (!mainPrev) return addTile(type, [], fixedName);
      const fam = famOf(type);
      const forkFrom = tiles[tiles.length - 2];
      const canFork = !!forkFrom && famOf(forkFrom.type) === fam && FILTERS[fam].length > 0;
      const savedLane = lane, savedNext = nextX;
      lane = mainPrev.lane === 0 ? 1 : mainPrev.lane - 1;
      nextX = mainPrev.x;
      const side = canFork
        ? addTile(pick(FILTERS[fam].filter((f) => !COMBINERS.has(f))), [[forkFrom as Tile, 0]])
        : addTile(pick(GENERATORS[fam]), []);
      run.push(side);
      lane = savedLane;
      nextX = savedNext;
      return addTile(type, [[mainPrev, 0], [side, 1]], fixedName);
    }

    function addFilter(type: string, run: Tile[]): void {
      if (COMBINERS.has(type)) {
        run.push(addCombiner(type, run));
      } else {
        const prev = last();
        run.push(addTile(type, prev ? [[prev, 0]] : []));
      }
    }

    // An annotation's box is derived from its tiles, so it follows them on
    // resize exactly as the editor's would.
    function placeAnnot(a: Annot): void {
      const xs = a.tiles.map((t) => t.x);
      a.x = Math.min(...xs) - 34 * K;
      a.w = Math.max(...a.tiles.map((t) => t.x + t.w)) - Math.min(...xs) + 68 * K;
      const top = Math.min(...a.tiles.map((t) => t.top)) - 50;
      const bottom = Math.max(...a.tiles.map((t) => t.top + t.h)) + 24 * K;
      a.el.style.left = `${a.x}px`;
      a.el.style.top = `${top}px`;
      a.el.style.width = `${a.w}px`;
      a.el.style.height = `${bottom - top}px`;
    }

    function addAnnot(run: Tile[], title: string): void {
      if (!run.length) return;
      const el = document.createElement("div");
      el.className = "hero-annot";
      const t = document.createElement("span");
      t.className = "hero-annot__title";
      t.textContent = title;
      el.appendChild(t);
      world.insertBefore(el, world.firstChild); // under the wires and tiles
      const a: Annot = { x: 0, w: 0, el, tiles: [...run] };
      placeAnnot(a);
      annots.push(a);
    }

    // One functional block: a generator (or the first filter after a bridge),
    // a few filters, then either a null that ends the chain or a bridge into
    // the next family. Wrapped in its annotation.
    function addRun(): void {
      const run: Tile[] = [];
      let title: string;
      nextX += 70 * K; // clear space between annotation boxes, as the editor keeps
      if (!chainOpen) {
        family = pick<Fam>(["TOP", "TOP", "TOP", "CHOP", "SOP", "POP", "DAT"]);
        stepLane();
        run.push(addTile(pick(GENERATORS[family]), []));
      } else {
        stepLane();
        const f = FILTERS[family];
        if (f.length) addFilter(pick(f), run);
      }
      title = pick(TITLES[family]);
      const filters = FILTERS[family];
      const n = filters.length ? Math.floor(rand(1, 4)) : 0;
      for (let i = 0; i < n; i++) {
        if (Math.random() < 0.3) stepLane();
        addFilter(pick(filters), run);
      }
      const bridges = BRIDGES[family];
      const nullType = NULLS[family];
      const prev = last();
      if (!bridges.length || (nullType && Math.random() < 0.35)) {
        if (nullType && prev) run.push(addTile(nullType, [[prev, 0]]));
        chainOpen = false;
        title = family === "TOP" ? "output" : title;
      } else {
        const [bridgeType, to] = pick(bridges);
        if (Math.random() < 0.4) stepLane();
        const bridge = addTile(bridgeType, prev ? [[prev, 0]] : []);
        run.push(bridge);
        if (to === "RENDER") {
          run.push(addTile("renderTOP", [[bridge, 0]]));
          family = "TOP";
          title = "render";
        } else {
          family = to;
        }
        chainOpen = true;
      }
      addAnnot(run, title);
    }

    function addSeedChain(): void {
      const run: Tile[] = [];
      for (const [i, [name, type]] of SEED_CHAIN.entries()) {
        if (i === 2 || i === 4) stepLane();
        if (COMBINERS.has(type)) {
          run.push(addCombiner(type, run, name));
        } else {
          const prev = last();
          run.push(addTile(type, i > 0 && prev ? [[prev, 0]] : [], name));
        }
      }
      addAnnot(run, "infinite zoom tunnel");
      chainOpen = false;
    }

    function ensureWorld(): void {
      const W = stage.clientWidth;
      if (!tiles.length) addSeedChain();
      while (nextX < camX + W + 900) addRun();
      while (tiles.length > 3 && tiles[0] !== current && (tiles[0] as Tile).x + TILE_W < camX - 700) {
        const t = tiles.shift() as Tile;
        t.el.remove();
        for (const p of t.paths) p.remove();
      }
      while (annots.length && (annots[0] as Annot).x + (annots[0] as Annot).w < camX - 700) {
        (annots.shift() as Annot).el.remove();
      }
    }

    function relayout(): void {
      for (const t of tiles) {
        t.top = floorY() - (LANES[t.lane] ?? 0);
        t.el.style.top = `${t.top}px`;
      }
      for (const t of tiles) {
        t.inputs.forEach(([from, slot], i) => t.paths[i]?.setAttribute("d", wirePath(from, t, slot)));
      }
      for (const a of annots) placeAnnot(a);
    }

    const bot = new Embot(root, { floorPx: floorFromBottom(stage.clientHeight) });

    bot.onLand = () => {
      const tile = current;
      if (tile) {
        tile.el.classList.add("is-hit");
        window.setTimeout(() => tile.el.classList.remove("is-hit"), 450);
      }
      // TD's stepping cadence: a short dwell, shorter when the queue is deep.
      nextHopAt = now() + rand(HOP_MIN, HOP_DWELL);
    };

    const captionFor = (tile: Tile) => OP_DESCRIPTIONS[tile.type] ?? BRIDGE_DESC[tile.type] ?? `built ${tile.name}`;

    bot.driver = (b, t) => {
      const W = stage.clientWidth;
      if (!started) {
        started = true;
        ensureWorld();
        if (reducedMotion()) {
          const tile = tiles[1] ?? tiles[0];
          if (tile) {
            current = tile;
            b.place((tile.x + tile.w / 2) / b.S, b.yForFeetAt(tile.top));
            b.say(captionFor(tile), t - 10);
          }
          return;
        }
        b.place(-120 / b.S, 0);
        b.say("opened a sub-network", t);
        nextHopAt = t + 0.5;
      }
      // camera: keep him around a third of the way in; ease so the world glides
      const dt = Math.min(0.05, Math.max(0, t - lastT));
      lastT = t;
      const targetCam = Math.max(0, b.base.x * b.S - W * 0.3);
      camX += (targetCam - camX) * (1 - Math.exp(-dt * 3.5));
      b.offsetX = camX;
      world.style.transform = `translate3d(${-camX}px, 0, 0)`;
      ensureWorld();
      if (t >= nextHopAt && b.landed && t >= b.gestureEnd) {
        const i = current ? tiles.indexOf(current) : -1;
        let next = tiles[i + 1];
        if (!next) { addRun(); next = tiles[i + 1] as Tile; }
        b.hopTo((next.x + next.w / 2) / b.S, b.yForFeetAt(next.top), t, JUMP_DUR);
        b.say(captionFor(next), t);
        current = next;
        nextHopAt = Infinity;
      }
    };

    window.addEventListener("resize", () => {
      relayout();
      bot.floorPx = floorFromBottom(stage.clientHeight);
      bot.resize();
      if (current) bot.place(bot.target.x, bot.yForFeetAt(current.top));
    });

    registerBot(bot);
  }

  const stageEl = document.querySelector<HTMLElement>(".hero-game");
  const rootEl = document.querySelector<HTMLElement>(".hero__embot [data-embot]");
  if (stageEl && rootEl && getComputedStyle(stageEl).display !== "none") start(stageEl, rootEl);
</script>
