---
import { env } from "cloudflare:workers";
import { Picture } from "astro:assets";
import { TdnViewer } from "@embody/tdn-viewer";
import Base from "../layouts/Base.astro";
import { sampleTdn } from "../fixtures/sample-tdn";
import { resultImage } from "../lib/specimenThumb";
import { fixtureSummaries } from "../lib/specimenFallback";
import { MIN_TD_BUILD } from "../lib/tdBuild";
import { listSpecimensForCollection } from "../server/db";
import heroShot from "../assets/embody-screenshot.png";
import Pillars from "../components/landing/Pillars.astro";
import PracticeSection from "../components/landing/PracticeSection.astro";
import TdnShowcase from "../components/landing/TdnShowcase.astro";
import QuickstartSteps from "../components/landing/QuickstartSteps.astro";
import ManifestoSection from "../components/landing/ManifestoSection.astro";

// The teaser shows the 3 most recently contributed specimens straight from D1
// (sort: newest). Mirrors /collection's degrade-to-fixtures pattern: an empty
// unfiltered result means no DB rows (dev without a seed) and a thrown query
// means no DB at all -- both fall back to the bundled fixtures so the landing
// never renders an empty section.
let featured = fixtureSummaries.slice(0, 3);
try {
  const recent = await listSpecimensForCollection(env.DB, { sort: "newest", pageSize: 3 });
  if (recent.specimens.length > 0) featured = recent.specimens;
} catch {
  // keep the fixture fallback
}

// The paste-in-a-Textport installer. ONE line, pure ASCII, single quotes only
// (it is embedded in a TS double-quoted string and in HTML text). It fetches
// the stable-named embody-release.json asset from the latest GitHub release,
// downloads the versioned .tox it names, verifies the manifest's sha256, and
// loadTox()es it into the current network -- the drag-and-drop equivalent.
// Deliberately requests + certifi (both bundled with TD on mac AND windows):
// TD's macOS Python has no system CA roots, so plain urllib fails there with
// CERTIFICATE_VERIFY_FAILED. The PaneType guard keeps it working when run
// from a DOCKED textport pane. Change it only with a real Textport test on
// both platforms.
const INSTALL_CMD =
  "import requests, hashlib, tempfile, os; h = {'User-Agent': 'Embody-Install'}; mf = requests.get('https://github.com/dylanroscover/Embody/releases/latest/download/embody-release.json', headers=h, timeout=30).json(); b = requests.get('https://github.com/dylanroscover/Embody/releases/download/%s/%s' % (mf['tag'], mf['asset']), headers=h, timeout=120).content; assert hashlib.sha256(b).hexdigest() == mf['sha256'], 'checksum mismatch'; f = os.path.join(tempfile.gettempdir(), mf['asset']); open(f, 'wb').write(b); n = ui.panes.current; n = n if n.type == PaneType.NETWORKEDITOR else next(x for x in ui.panes if x.type == PaneType.NETWORKEDITOR); print('Embody', mf['version'], 'installed at', n.owner.loadTox(f).path)";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Embody",
  alternateName: "Embody + Envoy",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Windows, macOS",
  description:
    "Open-source TouchDesigner toolkit. Envoy is an MCP server with 52 tools that lets AI assistants build, wire, parameterize, and debug a live TouchDesigner session; Embody externalizes the network to version-control-friendly text; TDN is the diffable YAML network format that makes both possible.",
  url: "https://embody.tools/",
  downloadUrl: "https://github.com/dylanroscover/Embody/releases/latest",
  installUrl: "https://embody.tools/#install",
  softwareHelp: "https://dylanroscover.github.io/Embody/",
  codeRepository: "https://github.com/dylanroscover/Embody",
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  author: { "@type": "Person", name: "Dylan Roscover" },
  publisher: { "@type": "Organization", name: "TEC", url: "https://tec.design" },
  softwareRequirements: `TouchDesigner ${MIN_TD_BUILD} or later`,
  keywords:
    "TouchDesigner, MCP, Model Context Protocol, AI agent, externalization, version control, TDN, generative art, creative coding, Claude Code, Codex, Gemini CLI, Cursor, Windsurf, GitHub Copilot"
};
---

<Base
  title="Embody - create at the speed of thought."
  description="Say what you want, watch operators appear in your live TouchDesigner session - every version saved as readable text. Open source, MIT."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-graph" aria-hidden="true">
      <TdnViewer tdn={sampleTdn} height="100%" showAnnotations={false} client:only="react" />
    </div>
    <div class="container hero__inner">
      <p class="eyebrow">open source &middot; MIT &middot; TouchDesigner 2025+</p>
      <h1 class="hero__headline">create at the<br />speed of&nbsp;thought.</h1>

      <div class="install" id="install">
        <p class="install__hint"><span class="install__prompt" aria-hidden="true">&gt;&gt;&gt;</span> paste this into a TouchDesigner Textport to install &mdash; macOS or Windows</p>
        <div class="install__bar">
          <pre class="install__code" tabindex="0" role="region" aria-label="Embody install command &mdash; a one-line Python command for the TouchDesigner Textport"><code id="install-cmd">{INSTALL_CMD}</code></pre>
          <button
            type="button"
            class="copy-button copy-button--cta install__copy"
            data-copy-target="install-cmd"
            data-copy-aria="copy the install command"
            aria-label="copy the install command"
            title="copy the install command"
          >
            <svg class="copy-icon copy-icon--copy" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <svg class="copy-icon copy-icon--check" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span class="copy-button__label">copy</span>
          </button>
        </div>
        <p class="install__meta">sha256-verified &middot; same as drag and drop &middot; TD pauses briefly while it fetches</p>
      </div>

      <div class="hero__ctas">
        <a
          class="btn btn--outline btn--download"
          href="https://github.com/dylanroscover/Embody/releases/latest"
          aria-label="Download the .tox"
        >
          <svg class="btn__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          .tox
        </a>
        <a class="btn btn--outline" href="https://dylanroscover.github.io/Embody/quickstart/">
          Quickstart <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <figure class="hero__shot">
        <Picture
          src={heroShot}
          formats={["avif", "webp"]}
          widths={[640, 960, 1280, 1800, 2252]}
          sizes="(max-width: 760px) calc(100vw - 3rem), min(900px, calc(100vw - 6rem))"
          alt="Embody running inside TouchDesigner - the extension's manager panel."
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption class="hero__shot__caption">The Embody manager panel &mdash; every operator externalized to readable text.</figcaption>
      </figure>
    </div>
  </section>

  <Pillars />
  <PracticeSection />
  <TdnShowcase />
  <QuickstartSteps />
  <ManifestoSection />

  <!-- COLLECTION TEASER -->
  <section class="section section--collection">
    <div class="container">
      <p class="eyebrow">the collection</p>
      <h2 class="section__title">browse the Collection.</h2>
      <p class="lede">
        Transparent TDN networks you can inspect node-for-node, copy to your clipboard, and evolve in your own project.
      </p>

      <div class="card-grid">
        {featured.map((specimen) => {
          // Real rendered cover: author-uploaded R2 thumbnail > baked render for
          // known slugs > procedural placeholder. Mirrors /collection and the
          // detail pages (SpecimenCover) so the teaser never shows the generic
          // placeholder when a real result exists.
          const cover = resultImage({
            slug: specimen.slug,
            name: specimen.name,
            category: specimen.category,
            thumbnailKey: specimen.thumbnail_key,
          });
          return (
          <a class="specimen-card pillar" href={`/c/${specimen.slug}`}>
            <div class="thumb">
              <img
                src={cover.src}
                width="640"
                height="360"
                loading="lazy"
                decoding="async"
                alt={cover.baked ? `${specimen.name} rendered result` : `${specimen.name} preview placeholder`}
              />
            </div>
            <div class="specimen-card__body">
              <div class="badge-row">
                <span class="badge">{specimen.category}</span>
                {specimen.categories.length > 1 && (
                  <span class="badge" title={specimen.categories.slice(1).join(", ")}>+{specimen.categories.length - 1}</span>
                )}
                {specimen.requires.map((req) => (
                  <span class="badge needs">needs {req}</span>
                ))}
              </div>
              <h3>{specimen.name}</h3>
              <p>{specimen.description}</p>
            </div>
          </a>
          );
        })}
      </div>

      <p class="start__cta">
        <a class="btn btn--outline" href="/collection">Enter the Collection <span aria-hidden="true">&rarr;</span></a>
      </p>
    </div>
  </section>

  <script>
    // Fade the node-graph backdrop in once the ReactFlow island has actually
    // rendered nodes, so it no longer pops in at the end of load. Decorative, so
    // a safety-net timeout reveals it regardless; reduced-motion users get an
    // instant reveal via the global prefers-reduced-motion rule.
    const heroGraph = document.querySelector(".hero-graph");
    if (heroGraph) {
      const reveal = () => heroGraph.classList.add("is-ready");
      if (heroGraph.querySelector(".react-flow__node")) {
        reveal();
      } else {
        const obs = new MutationObserver(() => {
          if (heroGraph.querySelector(".react-flow__node")) {
            reveal();
            obs.disconnect();
          }
        });
        obs.observe(heroGraph, { childList: true, subtree: true });
        window.setTimeout(reveal, 2500);
      }
    }
  </script>
</Base>

<style>
  /* Hero -- the node-graph motif sits behind the headline as faint texture,
     not a chart (per the unify plan: reuse the graph instead of a radial glow). */
  .hero {
    position: relative;
    overflow: hidden;
    /* top padding tuned so the mark -> eyebrow gap matches the eyebrow ->
       headline gap below (.hero__inner gap), for an even vertical rhythm. */
    padding: clamp(5.5rem, 9vw, 7rem) 0 clamp(3rem, 6vw, 5rem);
  }

  .hero-graph {
    position: absolute;
    /* Spans the full hero width (symmetric overhang left and right) so the
       network reads edge to edge rather than only in the upper-right; raised up
       so it sits in the upper band rather than sinking into the bottom fade;
       blur kept light so it stays a soft backdrop. */
    inset: -150px -130px 38% -130px;
    z-index: 0;
    /* Starts hidden and fades in only once the ReactFlow island has rendered
       (the .is-ready class is added by the script below), instead of popping in
       at the end of load. Decorative, so if the script never fires it simply
       stays as backdrop-less -- no content is hidden. */
    opacity: 0;
    transition: opacity 450ms ease;
    filter: blur(2px);
    pointer-events: none;
  }
  .hero-graph.is-ready { opacity: 0.3; }

  .hero-graph :global(.tdn-viewer) {
    height: 100%;
    border: 0;
    border-radius: 0;
    background-color: transparent;
  }

  .hero::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
    /* A gentle left-to-right veil: enough to keep the headline legible over the
       network on the left, easing to fully transparent on the right so the graph
       reads at full strength there. No longer paints opaque --bg over the left,
       which is what used to erase the network on that side. */
    background: linear-gradient(102deg, rgba(24, 30, 30, 0.48) 0%, rgba(24, 30, 30, 0.22) 50%, transparent 84%);
    pointer-events: none;
  }

  .hero::after {
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    z-index: 1;
    content: "";
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    /* Same shared rhythm token as nav->eyebrow and eyebrow->heading, so every
       gap down the hero is identical: nav = eyebrow = headline = CTAs = shot. */
    gap: var(--stack-gap);
  }

  .hero__inner .eyebrow {
    margin: 0;
    /* Same leading-trim as the headline so the eyebrow's box hugs its ink and
       the nav->eyebrow / eyebrow->headline gaps read as a true 48px, not the
       font's line box. Keeps the hero stack uniform ink-to-ink. */
    text-box-trim: trim-both;
    text-box-edge: cap alphabetic;
  }

  /* Headline + eyebrow stay left-aligned; the CTA row and the shot share the
     container's center axis so the small button cluster reads as a deliberate
     focal funnel rather than stranded against the centered screenshot. */
  .hero__ctas {
    align-self: center;
  }

  /* Install one-liner -- the hero's primary CTA. A solid card (same register
     as .pillar/.step) so the text reads cleanly over the hero-graph backdrop
     instead of floating on it. */
  .install {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    /* Same width + center axis as .hero__shot so the card's edges line up
       with the screenshot below it. */
    max-width: 900px;
    width: 100%;
    align-self: center;
    scroll-margin-top: 7rem; /* #install anchor jumps clear of the fixed nav pill */
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem 1.4rem 1.1rem;
    box-shadow: 0 24px 60px -32px rgba(0, 0, 0, 0.65);
  }
  .install__hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    letter-spacing: 0.02em;
    color: var(--text);
  }
  .install__prompt {
    color: var(--accent);
    margin-right: 0.55em;
  }
  /* Rolling green shimmer over the instruction -- a slow accent band sweeps
     the text left-to-right, looping seamlessly (the gradient's ends match, and
     one cycle shifts the 200%-wide tile by exactly one period). Gated: only
     when the browser can clip a background to text AND the visitor allows
     motion; everyone else keeps the plain solid line above (a transparent
     fill without those guards would strand reduced-motion visitors on a
     static bright band -- or blank text on old engines). */
  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    @media (prefers-reduced-motion: no-preference) {
      .install__hint {
        /* Dimmed base + a wide bright band (peak = the favicon orb mint) so
           the sweep reads as a real pulse of light, not a subtle sheen. */
        background: linear-gradient(
            90deg,
            var(--text-muted) 0%,
            var(--text-muted) 36%,
            var(--accent) 46%,
            #c9f5c4 51%,
            var(--accent) 56%,
            var(--text-muted) 66%,
            var(--text-muted) 100%
          )
          0 0 / 200% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
        animation: install-hint-roll 2.2s linear infinite;
      }
      /* The >>> prompt sits out of the shimmer: re-assert its solid accent
         fill (text-fill-color inherits from the transparent parent). */
      .install__hint .install__prompt {
        color: var(--accent);
        -webkit-text-fill-color: var(--accent);
      }
    }
  }
  @keyframes install-hint-roll {
    from {
      background-position: 200% 0;
    }
    to {
      background-position: 0% 0;
    }
  }
  .install__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--bg-code);
    border: 1px solid var(--border-faint);
    border-radius: var(--radius-sm);
    padding: 0.55rem 0.55rem 0.55rem 1.1rem;
  }
  .install__code {
    margin: 0;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    white-space: pre;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-muted);
    padding: 0.35rem 0;
    background: none; /* defeat the global `.code, pre` box (bg+border) */
    border: none;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }
  .install__code:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .install__code code {
    font-size: inherit; /* guard against global code sizing compounding */
    color: inherit;
    background: none;
    border: none;
    padding: 0;
  }
  /* Solid-accent upgrade of the --cta copy button: this is THE primary action
     on the page. is-copied flips it back to the tinted style with the check
     icon, so the state change is unmistakable. */
  .install__copy {
    background: var(--accent);
    border-color: var(--accent);
    color: #0e1612;
    min-height: 42px;
    padding: 8px 18px;
  }
  .install__copy:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: #0e1612;
  }
  .install__copy.is-copied,
  .install__copy.is-copied:hover {
    background: rgba(110, 230, 104, 0.12);
    color: var(--accent);
    border-color: var(--accent);
  }
  /* The scoped solid variant outranks embody.css's .copy-button.is-failed in
     the cascade, so mirror the failure state here too -- a silent no-op on
     the page's primary CTA is the one thing this button must never do. */
  .install__copy.is-failed,
  .install__copy.is-failed:hover {
    background: rgba(224, 122, 106, 0.12);
    color: #e07a6a;
    border-color: #e07a6a;
  }
  /* Re-assert the repo's coarse-pointer touch floor (embody.css line ~1905:
     page-scoped controls must re-declare it -- the scoped selector outranks
     the global one). 46px matches the .copy-button--cta floor. */
  @media (pointer: coarse) {
    .install__copy {
      min-height: 46px;
    }
  }
  .install__meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-faint);
    letter-spacing: 0.01em;
  }
  /* Without JS the global copy handler never runs: hide the button, the
     command stays plain selectable text (same pattern as the no-js nav). */
  :global(html.no-js) .install__copy {
    display: none;
  }

  .hero__shot {
    max-width: 900px;
    align-self: center;
    width: 100%;
  }

  .section--collection .card-grid {
    margin-top: 2.25rem;
  }

  /* Descriptions are author-written and unbounded -- a raymarching writeup can
     run to a dozen lines while the card beside it has two. Unclamped, the
     tallest one set the row height and the teaser grew several screens tall.
     Clamp to 3 lines with an ellipsis; the full text is on the specimen page.
     Scoped, so the /collection card rules (2-line list clamp, hidden in
     gallery) are untouched. */
  .section--collection .specimen-card p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  /* The body is a grid, so in a stretched card its rows shared the leftover
     height and the badges/title drifted down the card. Pack them at the top
     and let the trailing space fall below the description. */
  .section--collection .specimen-card__body {
    align-content: start;
  }

  /* The 3-card teaser uses the global auto-fit grid, which lands a lone third
     card on its own half-row at tablet widths (the 2+1 orphan). Force a single
     column at/below the nav breakpoint so the teaser stacks cleanly instead. */
  @media (max-width: 860px) {
    .section--collection .card-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: 5.5rem;
    }

    .hero-graph {
      inset: -60px -220px 120px 0;
    }
    .hero-graph.is-ready { opacity: 0.16; }
  }

  /* Narrow DESKTOP windows keep the install CTA (fine pointer), it just
     stacks. Applies to half-screen windows, not phones -- see below. */
  @media (max-width: 540px) {
    .install {
      padding: 1rem 1rem 0.9rem;
    }
    .install__bar {
      flex-direction: column;
      align-items: stretch;
      padding: 0.75rem;
    }
    .install__code { padding: 0.15rem 0.25rem 0.4rem; }
    .install__copy { width: 100%; }
  }

  /* Touch-primary devices (phones/tablets) can't run TouchDesigner, so the
     install command and the .tox download are noise there -- hide both and
     let Quickstart carry the hero. hover:none + pointer:coarse is the device
     signal: a touch-screen laptop still reports a fine primary pointer and
     keeps the CTA; a narrow desktop window is handled above instead. */
  @media (hover: none) and (pointer: coarse) {
    .install,
    .btn--download {
      display: none;
    }
  }
</style>
