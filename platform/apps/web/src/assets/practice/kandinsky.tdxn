custom_pars:
  Kandinsky:
  - name: Seed
    style: Int
    default: 7
    clampMin: true
    normMax: 100.0
    help: Random seed for the composition. Every placement, size and colour choice derives from it.
  - name: Shape
    style: Menu
    default: circle
    menuNames:
    - circle
    - square
    menuLabels:
    - Circle
    - Square
    help: 'Primary shape family: circles, or squares rotated per shape.'
  - name: Warmth
    style: Float
    clampMin: true
    clampMax: true
    help: 0 = cool palette on pale paper, 1 = warm palette on ochre paper. Values between blend the two.
  - name: Lineweight
    style: Float
    label: Line Weight
    default: 1.5
    min: 0.25
    clampMin: true
    normMin: 0.5
    normMax: 6.0
    help: Stroke width of the lines and rings, in pixels at the output resolution.
    value: 2.5
  - name: Offset
    style: XYZW
    label: Cluster Offset
    size: 2
    normMin: -0.5
    normMax: 0.5
    help: Shifts the whole cluster of shapes. Frame units; 0 0 is centred.
